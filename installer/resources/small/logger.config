logger.consoleBufferSize=25
logger.dateFormat=yyyy/MM/dd HH:mm:ss.SSS
logger.defaultLevel=ERROR
logger.displayOnScreen=true
logger.dropDuplicates=false
logger.dropOnOverflow=true
logger.flushInterval=15
logger.format=d p [t] c: m
logger.gzip=false
logger.groupReadable=false
logger.logBufferSize=1024
logger.logFileSize=128K
logger.logRotationLimit=1
logger.minGzipSize=65536
logger.minimumOnScreenLevel=ERROR
