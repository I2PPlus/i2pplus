#, no-wrap
msgid "EEPGET"
msgstr "EEPGET"

#, no-wrap
msgid "January 26, 2017"
msgstr "26 جنوری 2017"

#, no-wrap
msgid "I2P"
msgstr "I2P"

#, no-wrap
msgid "NAME"
msgstr "NAME"

msgid "Eepget - I2P downloader"
msgstr "Eepget - I2P ڈاؤن لوڈر"

#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

msgid "B<eepget> [I<options>]I<URL>"
msgstr "B<eepget> [I<options>]I<URL>"

#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

msgid "Download a file non-interactively via HTTP. Transfers through both I2P and the regular Internet are supported."
msgstr "HTTP کے ذریعے فائل بغیر رابطے کے ڈاؤن لوڈ کریں۔ I2P اور عام انٹرنیٹ دونوں کے ذریعے منتقلیاں معاونت یافتہ ہیں۔"

msgid "Eepget is able to cope with slow or unstable network connections; if a download is not successful because of a network problem, it will keep retrying until the whole file has been retrieved (if the -n option is set).  If supported by the remote server, eepget will instruct the server to continue the download from the point of interruption."
msgstr "Eepget سست یا غیر مستحکم نیٹ ورک کنکشنز سے نپٹ سکتا ہے؛ اگر کسی نیٹ ورک مسئلے کی بنا پر ڈاؤن لوڈ کامیاب نہ ہو تو یہ مکمل فائل حاصل ہونے تک دوبارہ کوشش کرتا رہے گا (اگر -n آپشن مقرر ہو)۔ اگر ریموٹ سرور اس کی معاونت کرے تو eepget سرور کو رکاوٹ کے مقام سے ڈاؤن لوڈ جاری رکھنے کا ہدایت کرے گا۔"

#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

msgid "B<-c>"
msgstr "B<-c>"

#, no-wrap
msgid "Clearnet. Do not use a proxy. Same as B<-p> :0 ."
msgstr "Clearnet۔ پراکسی استعمال نہ کریں۔ B<-p> :0 کے برابر ہے۔"

msgid "B<-e> etag"
msgstr "B<-e> etag"

#, no-wrap
msgid "Sets the etag value in the request headers."
msgstr "درخواست ہیڈرز میں etag قدر مقرر کرتا ہے۔"

msgid "B<-h> name=value"
msgstr "B<-h> نام=قدر"

#, no-wrap
msgid "Adds an arbitrary request header with the given name and value."
msgstr "دی گئی نام اور قدر کے ساتھ کوئی بھی درخواست ہیڈر شامل کرتا ہے۔"

msgid "B<-l> lineLen"
msgstr "B<-l> lineLen"

#, no-wrap
msgid "Controls the progress display. B<\\ lineLen > is the length of one progress line in characters. The default is 40."
msgstr "پیش رفت کی نمائش کو کنٹرول کرتا ہے۔ B<\\ lineLen > ایک پیش رفت لائن کی حروف میں لمبائی ہے۔ طے شدہ 40 ہے۔"

msgid "B<-m> markSize"
msgstr "B<-m> markSize"

#, no-wrap
msgid "Controls the progress display. B<\\ markSize > is the number of bytes one '#' character represents. The default is 1024."
msgstr "پیش رفت کی نمائش کو کنٹرول کرتا ہے۔ B<\\ markSize > ایک '#' حرف کتنے بائٹس کی نمائندگی کرتا ہے۔ طے شدہ 1024 ہے۔"

msgid "B<-n> retries"
msgstr "B<-n> دوبارہ کوششیں"

#, no-wrap
msgid "Specify the number of times to retry downloading if the download isn't successful. If this option is not specified, eepget will not retry."
msgstr "مقرر کرتا ہے کہ ڈاؤن لوڈ کامیاب نہ ہو تو دوبارہ کوشش کتنی بار کی جائے۔ اگر یہ آپشن مقرر نہ کیا جائے تو eepget دوبارہ کوشش نہیں کرے گا۔"

msgid "B<-o> file"
msgstr "B<-o> فائل"

#, no-wrap
msgid "Sets the output file to write to. If this option is not given, the output filename will be determined by the URL."
msgstr "وہ آؤٹ پٹ فائل مقرر کرتا ہے جس میں لکھا جائے گا۔ اگر یہ آپشن دیا نہ جائے تو آؤٹ پٹ فائل کا نام URL سے طے ہوگا۔"

msgid "B<-p> proxy_host[:port]"
msgstr "B<-p> proxy_host[:port]"

#, no-wrap
msgid "Specify an I2P proxy server (eeproxy) to use. If the port is not specified, eepget will use 4444. If this option is not specified, eepget will use 127.0.0.1:4444. Specify B<-c> or B<-p> :0 to disable the eeproxy."
msgstr "استعمال کرنے کے لیے I2P پراکسی سرور (eeproxy) مقرر کرتا ہے۔ اگر پورٹ مقرر نہ کیا جائے تو eepget 4444 استعمال کرے گا۔ اگر یہ آپشن مقرر نہ کیا جائے تو eepget 127.0.0.1:4444 استعمال کرے گا۔ eeproxy کو غیر فعال کرنے کے لیے B<-c> یا B<-p> :0 مقرر کریں۔"

msgid "B<-t> seconds"
msgstr "B<-t> سیکنڈ"

#, no-wrap
msgid "Sets the inactivity timeout. The default is 60 seconds."
msgstr "غیر فعالی کا ٹائم آؤٹ مقرر کرتا ہے۔ طے شدہ 60 سیکنڈ ہے۔"

msgid "B<-u> username"
msgstr "B<-u> صارف نام"

#, no-wrap
msgid "Sets the username for proxy authorization, if required."
msgstr "ضروری ہو تو پراکسی کی اجازت کے لیے صارف نام مقرر کرتا ہے۔"

msgid "B<-x> password"
msgstr "B<-x> پاس ورڈ"

#, no-wrap
msgid "Sets the password for proxy authorization, if required. If a username is specified but not a password, EepGet will prompt for the password."
msgstr "ضروری ہو تو پراکسی کی اجازت کے لیے پاس ورڈ مقرر کرتا ہے۔ اگر صارف نام تو مقرر کیا جائے مگر پاس ورڈ نہیں، تو EepGet پاس ورڈ کے لیے پوچھے گا۔"

#, no-wrap
msgid "EXIT STATUS"
msgstr "EXIT STATUS"

msgid "B<eepget> exits with status zero upon successful transfer and non-zero if there were problems with the download."
msgstr "کامیاب منتقلی پر B<eepget> صفر کی حالت کے ساتھ باہر نکلتا ہے اور ڈاؤن لوڈ میں مسائل رہے ہوں تو صفر کے علاوہ۔"

#, no-wrap
msgid "REPORTING BUGS"
msgstr "REPORTING BUGS"

msgid "Please enter a ticket on E<.UR https://github.com/I2PPlus/i2pplus/issues> the I2P Bug Tracker E<.UE .>"
msgstr "براہِ کرم E<.UR https://github.com/I2PPlus/i2pplus/issues> I2P خرابی ٹریکر E<.UE .> پر ٹکٹ درج کریں۔"

#, no-wrap
msgid "SEE ALSO"
msgstr "SEE ALSO"

msgid "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"
msgstr "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"

#, no-wrap
msgid "I2PROUTER"
msgstr "I2PROUTER"

msgid "i2prouter - start and stop the I2P router"
msgstr "i2prouter - I2P روٹر شروع کرنا اور روکنا"

msgid "B<i2prouter> {I<console>|I<start>|I<stop>|I<graceful>|I<restart>|I<condrestart>|I<status>|I<dump>|I<install>|I<remove>}"
msgstr "B<i2prouter> {I<console>|I<start>|I<stop>|I<graceful>|I<restart>|I<condrestart>|I<status>|I<dump>|I<install>|I<remove>}"

msgid "Control the I2P service."
msgstr "I2P سروس کو کنٹرول کرتا ہے۔"

#, no-wrap
msgid "B<console>"
msgstr "B<console>"

msgid "Runs I2P as a console application under the current user."
msgstr "موجودہ صارف کے تحت I2P کو کنسول ایپلیکیشن کے طور پر چلاتا ہے۔"

#, no-wrap
msgid "B<start>"
msgstr "B<start>"

msgid "Starts the I2P service."
msgstr "I2P سروس شروع کرتا ہے۔"

#, no-wrap
msgid "B<stop>"
msgstr "B<stop>"

msgid "Stops the I2P service."
msgstr "I2P سروس روکتا ہے۔"

#, no-wrap
msgid "B<restart>"
msgstr "B<restart>"

msgid "Stops the I2P service and then starts it."
msgstr "I2P سروس کو روکتا ہے اور پھر شروع کرتا ہے۔"

#, no-wrap
msgid "B<condrestart>"
msgstr "B<condrestart>"

msgid "Restart the I2P service only if it is already running."
msgstr "I2P سروس کو صرف تب دوبارہ شروع کرتا ہے جب وہ پہلے ہی چل رہی ہو۔"

#, no-wrap
msgid "B<graceful>"
msgstr "B<graceful>"

msgid "Stop I2P gracefully (may take up to 11 minutes)"
msgstr "I2P کو نرمی سے روکتا ہے (اس میں 11 منٹ تک لگ سکتے ہیں)"

#, no-wrap
msgid "B<install>"
msgstr "B<install>"

msgid "Install initscript to start I2P automatically when the system boots."
msgstr "ایسا initscript انسٹال کرتا ہے جو نظام کے بوٹ ہونے پر I2P کو خودکار شروع کرے۔"

#, no-wrap
msgid "B<remove>"
msgstr "B<remove>"

msgid "Uninstall initscript that was installed with B<install>"
msgstr "وہ initscript اَن انسٹال کرتا ہے جو B<install> کے ذریعے انسٹال کیا گیا تھا"

#, no-wrap
msgid "B<status>"
msgstr "B<status>"

msgid "Prints whether the I2P service is running."
msgstr "یہ ظاہر کرتا ہے کہ I2P سروس چل رہی ہے یا نہیں۔"

#, no-wrap
msgid "B<dump>"
msgstr "B<dump>"

msgid "Dumps the current threads into B<wrapper.log>."
msgstr "موجودہ دھاگوں کو B<wrapper.log> میں ڈمپ کرتا ہے۔"

msgid "B<i2prouter-nowrapper>(1)"
msgstr "B<i2prouter-nowrapper>(1)"

#, no-wrap
msgid "I2PROUTER-NOWRAPPER"
msgstr "I2PROUTER-NOWRAPPER"

msgid "i2prouter-nowrapper - start the I2P router"
msgstr "i2prouter-nowrapper - I2P روٹر شروع کرنا"

msgid "B<i2prouter-nowrapper>"
msgstr "B<i2prouter-nowrapper>"

msgid "Start the I2P router, without the service wrapper.  This means the router will not restart if it crashes.  Also, it will use the default memory size, which may not be enough for I2P."
msgstr "سروس wrapper کے بغیر I2P روٹر شروع کرتا ہے۔ اس کا مطلب ہے کہ روٹر کریش ہونے پر دوبارہ شروع نہیں ہوگا۔ نیز یہ طے شدہ میموری حجم استعمال کرے گا، جو I2P کے لیے کافی نہ ہو سکتا۔"

msgid "You should really use the B<i2prouter>(1)  script instead.  There are no options.  To stop the router, use your browser to access E<.UR http://localhost:7657/> the router console E<.UE .>"
msgstr "آپ کو دراصل B<i2prouter>(1) سکرپٹ استعمال کرنا چاہیے۔ اس میں کوئی آپشن نہیں ہیں۔ روٹر روکنے کے لیے اپنا براؤزر استعمال کر کے E<.UR http://localhost:7657/> روٹر کنسول E<.UE .> تک رسائی حاصل کریں۔"

msgid "B<i2prouter>(1)"
msgstr "B<i2prouter>(1)"
