#, no-wrap
msgid "EEPGET"
msgstr "EEPGET"

#, no-wrap
msgid "January 26, 2017"
msgstr "Enero 26, 2017"

#, no-wrap
msgid "I2P"
msgstr "I2P"

#, no-wrap
msgid "NAME"
msgstr "NAME"

msgid "Eepget - I2P downloader"
msgstr "Eepget - downloader ng I2P"

#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

msgid "B<eepget> [I<options>]I<URL>"
msgstr "B<eepget> [I<options>]I<URL>"

#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

msgid "Download a file non-interactively via HTTP. Transfers through both I2P and the regular Internet are supported."
msgstr "Mag-download ng file nang hindi interaktif sa pamamagitan ng HTTP. Sinusuportahan ang mga transfer sa pamamagitan ng I2P at ng regular na Internet."

msgid "Eepget is able to cope with slow or unstable network connections; if a download is not successful because of a network problem, it will keep retrying until the whole file has been retrieved (if the -n option is set).  If supported by the remote server, eepget will instruct the server to continue the download from the point of interruption."
msgstr "Kaya ng eepget ang mabagal o pabagu-bagong koneksyon sa network; kung hindi matagumpay ang isang download dahil sa problema sa network, magpapatuloy itong subukan hanggang makuha ang buong file (kung nakatakda ang opsyong -n).  Kung sinusuportahan ito ng remote server, ipinapaalam ng eepget sa server na magpatuloy ang download mula sa punto ng pagkaputol."

#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

msgid "B<-c>"
msgstr "B<-c>"

#, no-wrap
msgid "Clearnet. Do not use a proxy. Same as B<-p> :0 ."
msgstr "Clearnet. Huwag gumamit ng proxy. Kapareho ng B<-p> :0 ."

msgid "B<-e> etag"
msgstr "B<-e> etag"

#, no-wrap
msgid "Sets the etag value in the request headers."
msgstr "Itinatakda ang halaga ng etag sa mga header ng kahilingan."

msgid "B<-h> name=value"
msgstr "B<-h> name=value"

#, no-wrap
msgid "Adds an arbitrary request header with the given name and value."
msgstr "Nagdaragdag ng kahit anong request header na may ibinigay na pangalan at halaga."

msgid "B<-l> lineLen"
msgstr "B<-l> lineLen"

#, no-wrap
msgid "Controls the progress display. B<\\ lineLen > is the length of one progress line in characters. The default is 40."
msgstr "Pinipontrol ang display ng progreso. Ang B<\\ lineLen > ay ang haba ng isang linya ng progreso sa bilang ng karakter. Ang default ay 40."

msgid "B<-m> markSize"
msgstr "B<-m> markSize"

#, no-wrap
msgid "Controls the progress display. B<\\ markSize > is the number of bytes one '#' character represents. The default is 1024."
msgstr "Pinipontrol ang display ng progreso. Ang B<\\ markSize > ay ang bilang ng byte na kinakatawan ng isang karakter na '#'. Ang default ay 1024."

msgid "B<-n> retries"
msgstr "B<-n> retries"

#, no-wrap
msgid "Specify the number of times to retry downloading if the download isn't successful. If this option is not specified, eepget will not retry."
msgstr "Tinutukoy ang ilang beses babalikan ang download kapag hindi matagumpay ang download. Kung hindi tinukoy ang opsyong ito, hindi babalikan ng eepget ang download."

msgid "B<-o> file"
msgstr "B<-o> file"

#, no-wrap
msgid "Sets the output file to write to. If this option is not given, the output filename will be determined by the URL."
msgstr "Itinatakda ang output file na susulatan. Kung hindi ibinigay ang opsyong ito, ang pangalan ng output file ay matatukoy ng URL."

msgid "B<-p> proxy_host[:port]"
msgstr "B<-p> proxy_host[:port]"

#, no-wrap
msgid "Specify an I2P proxy server (eeproxy) to use. If the port is not specified, eepget will use 4444. If this option is not specified, eepget will use 127.0.0.1:4444. Specify B<-c> or B<-p> :0 to disable the eeproxy."
msgstr "Tinutukoy ang I2P proxy server (eeproxy) na gagamitin. Kung hindi tinukoy ang port, gagamitin ng eepget ang 4444. Kung hindi tinukoy ang opsyong ito, gagamitin ng eepget ang 127.0.0.1:4444. Tukuyin ang B<-c> o B<-p> :0 upang i-disable ang eeproxy."

msgid "B<-t> seconds"
msgstr "B<-t> seconds"

#, no-wrap
msgid "Sets the inactivity timeout. The default is 60 seconds."
msgstr "Itinatakda ang timeout ng kawalan ng aktibidad. Ang default ay 60 segundo."

msgid "B<-u> username"
msgstr "B<-u> username"

#, no-wrap
msgid "Sets the username for proxy authorization, if required."
msgstr "Itinatakda ang username para sa awtorisasyon ng proxy, kung kinakailangan."

msgid "B<-x> password"
msgstr "B<-x> password"

#, no-wrap
msgid "Sets the password for proxy authorization, if required. If a username is specified but not a password, EepGet will prompt for the password."
msgstr "Itinatakda ang password para sa awtorisasyon ng proxy, kung kinakailangan. Kung tinukoy ang username ngunit walang password, hihingiin ng EepGet ang password."

#, no-wrap
msgid "EXIT STATUS"
msgstr "EXIT STATUS"

msgid "B<eepget> exits with status zero upon successful transfer and non-zero if there were problems with the download."
msgstr "Lalabas ang B<eepget> na may status zero kapag matagumpay ang transfer at hindi-zero kung may problema sa download."

#, no-wrap
msgid "REPORTING BUGS"
msgstr "REPORTING BUGS"

msgid "Please enter a ticket on E<.UR https://github.com/I2PPlus/i2pplus/issues> the I2P Bug Tracker E<.UE .>"
msgstr "Pakilala ang ticket sa E<.UR https://github.com/I2PPlus/i2pplus/issues> ang I2P Bug Tracker E<.UE .>"

#, no-wrap
msgid "SEE ALSO"
msgstr "SEE ALSO"

msgid "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"
msgstr "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"

#, no-wrap
msgid "I2PROUTER"
msgstr "I2PROUTER"

msgid "i2prouter - start and stop the I2P router"
msgstr "i2prouter - simulan at ihinto ang router ng I2P"

msgid "B<i2prouter> {I<console>|I<start>|I<stop>|I<graceful>|I<restart>|I<condrestart>|I<status>|I<dump>|I<install>|I<remove>}"
msgstr "B<i2prouter> {I<console>|I<start>|I<stop>|I<graceful>|I<restart>|I<condrestart>|I<status>|I<dump>|I<install>|I<remove>}"

msgid "Control the I2P service."
msgstr "Kontrolin ang serbisyo ng I2P."

#, no-wrap
msgid "B<console>"
msgstr "B<console>"

msgid "Runs I2P as a console application under the current user."
msgstr "Pinapatakbo ang I2P bilang console application sa ilalim ng kasalukuyang user."

#, no-wrap
msgid "B<start>"
msgstr "B<start>"

msgid "Starts the I2P service."
msgstr "Sinisimulan ang serbisyo ng I2P."

#, no-wrap
msgid "B<stop>"
msgstr "B<stop>"

msgid "Stops the I2P service."
msgstr "Inihinto ang serbisyo ng I2P."

#, no-wrap
msgid "B<restart>"
msgstr "B<restart>"

msgid "Stops the I2P service and then starts it."
msgstr "Inihinto ang serbisyo ng I2P at saka ito sisimulan."

#, no-wrap
msgid "B<condrestart>"
msgstr "B<condrestart>"

msgid "Restart the I2P service only if it is already running."
msgstr "I-restart ang serbisyo ng I2P lamang kung tumatakbo na ito."

#, no-wrap
msgid "B<graceful>"
msgstr "B<graceful>"

msgid "Stop I2P gracefully (may take up to 11 minutes)"
msgstr "Ihinto ang I2P nang mahinahon (maaaring tumagal ng 11 minuto)"

#, no-wrap
msgid "B<install>"
msgstr "B<install>"

msgid "Install initscript to start I2P automatically when the system boots."
msgstr "I-install ang initscript upang awtomatikong simulan ang I2P kapag nagsimula ang sistema."

#, no-wrap
msgid "B<remove>"
msgstr "B<remove>"

msgid "Uninstall initscript that was installed with B<install>"
msgstr "I-uninstall ang initscript na na-install gamit ang B<install>"

#, no-wrap
msgid "B<status>"
msgstr "B<status>"

msgid "Prints whether the I2P service is running."
msgstr "Iniprint kung tumatakbo ang serbisyo ng I2P."

#, no-wrap
msgid "B<dump>"
msgstr "B<dump>"

msgid "Dumps the current threads into B<wrapper.log>."
msgstr "Nilalabas ang kasalukuyang mga thread sa B<wrapper.log>."

msgid "B<i2prouter-nowrapper>(1)"
msgstr "B<i2prouter-nowrapper>(1)"

#, no-wrap
msgid "I2PROUTER-NOWRAPPER"
msgstr "I2PROUTER-NOWRAPPER"

msgid "i2prouter-nowrapper - start the I2P router"
msgstr "i2prouter-nowrapper - simulan ang router ng I2P"

msgid "B<i2prouter-nowrapper>"
msgstr "B<i2prouter-nowrapper>"

msgid "Start the I2P router, without the service wrapper.  This means the router will not restart if it crashes.  Also, it will use the default memory size, which may not be enough for I2P."
msgstr "Sinisimulan ang router ng I2P, nang walang service wrapper.  Ibig sabihin, hindi magsisimula muli ang router kapag nag-crash ito.  Bukod dito, gagamitin nito ang default na laki ng memorya, na maaaring hindi sapat para sa I2P."

msgid "You should really use the B<i2prouter>(1)  script instead.  There are no options.  To stop the router, use your browser to access E<.UR http://localhost:7657/> the router console E<.UE .>"
msgstr "Mas dapat mong gamitin ang B<i2prouter>(1)  script.  Walang mga opsyon.  Para ihinto ang router, buksan sa browser mo ang E<.UR http://localhost:7657/> router console E<.UE .>"

msgid "B<i2prouter>(1)"
msgstr "B<i2prouter>(1)"
