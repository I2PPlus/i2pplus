#, no-wrap
msgid "EEPGET"
msgstr "EEPGET"

#, no-wrap
msgid "January 26, 2017"
msgstr "26. januára 2017"

#, no-wrap
msgid "I2P"
msgstr "I2P"

#, no-wrap
msgid "NAME"
msgstr "NÁZOV"

msgid "Eepget - I2P downloader"
msgstr "Eepget - sťahovač I2P"

#, no-wrap
msgid "SYNOPSIS"
msgstr "PREHĽAD"

msgid "B<eepget> [I<options>]I<URL>"
msgstr "B<eepget> [I<možnosti>]I<URL>"

#, no-wrap
msgid "DESCRIPTION"
msgstr "POPIS"

msgid "Download a file non-interactively via HTTP. Transfers through both I2P and the regular Internet are supported."
msgstr "Stiahnuť súbor neinteraktívne cez HTTP. Sú podporované prenosy cez I2P aj cez bežný internet."

msgid "Eepget is able to cope with slow or unstable network connections; if a download is not successful because of a network problem, it will keep retrying until the whole file has been retrieved (if the -n option is set).  If supported by the remote server, eepget will instruct the server to continue the download from the point of interruption."
msgstr "Eepget dokáže zvládnuť pomalé alebo nestabilné sieťové pripojenia; ak sťahovanie nie je úspešné kvôli sieťovému problému, bude skúsať stiahnuť súbor opakovane, kým nebude celý súbor stiahnutý (ak je nastavená možnosť -n). Ak to vzdialený server podporuje, eepget serveru prikáže pokračovať v sťahovaní od prerušeného miesta."

#, no-wrap
msgid "OPTIONS"
msgstr "MOŽNOSTI"

msgid "B<-c>"
msgstr "B<-c>"

#, no-wrap
msgid "Clearnet. Do not use a proxy. Same as B<-p> :0 ."
msgstr "Clearnet. Nepoužívať proxy. Rovnaké ako B<-p> :0 ."

msgid "B<-e> etag"
msgstr "B<-e> etag"

#, no-wrap
msgid "Sets the etag value in the request headers."
msgstr "Nastaví hodnotu etag v hlavičkách požiadavky."

msgid "B<-h> name=value"
msgstr "B<-h> názov=hodnota"

#, no-wrap
msgid "Adds an arbitrary request header with the given name and value."
msgstr "Pridá ľubovoľnú hlavičku požiadavky s daným názvom a hodnotou."

msgid "B<-l> lineLen"
msgstr "B<-l> dĺžkaRiadka"

#, no-wrap
msgid "Controls the progress display. B<\\ lineLen > is the length of one progress line in characters. The default is 40."
msgstr "Ovláda zobrazenie priebehu. B<\\ dĺžkaRiadka > je dĺžka jedného riadku priebehu v znakoch. Predvolená hodnota je 40."

msgid "B<-m> markSize"
msgstr "B<-m> veľkosťZnačky"

#, no-wrap
msgid "Controls the progress display. B<\\ markSize > is the number of bytes one '#' character represents. The default is 1024."
msgstr "Ovláda zobrazenie priebehu. B<\\ veľkosťZnačky > je počet bajtov, ktoré predstavuje jeden znak '#'. Predvolená hodnota je 1024."

msgid "B<-n> retries"
msgstr "B<-n> pokusy"

#, no-wrap
msgid "Specify the number of times to retry downloading if the download isn't successful. If this option is not specified, eepget will not retry."
msgstr "Určuje počet pokusov o opätovné stiahnutie, ak sťahovanie nie je úspešné. Ak táto možnosť nie je zadaná, eepget nebude skúsať znova."

msgid "B<-o> file"
msgstr "B<-o> súbor"

#, no-wrap
msgid "Sets the output file to write to. If this option is not given, the output filename will be determined by the URL."
msgstr "Nastaví výstupný súbor, do ktorého sa má zapisovať. Ak táto možnosť nie je zadaná, názov výstupného súboru bude určený URL."

msgid "B<-p> proxy_host[:port]"
msgstr "B<-p> proxy_hostiteľ[:port]"

#, no-wrap
msgid "Specify an I2P proxy server (eeproxy) to use. If the port is not specified, eepget will use 4444. If this option is not specified, eepget will use 127.0.0.1:4444. Specify B<-c> or B<-p> :0 to disable the eeproxy."
msgstr "Určuje proxy server I2P (eeproxy), ktorý sa má použiť. Ak port nie je zadaný, eepget použije 4444. Ak táto možnosť nie je zadaná, eepget použije 127.0.0.1:4444. Zadajte B<-c> alebo B<-p> :0 pre zakázanie eeproxy."

msgid "B<-t> seconds"
msgstr "B<-t> sekundy"

#, no-wrap
msgid "Sets the inactivity timeout. The default is 60 seconds."
msgstr "Nastaví časový limit nečinnosti. Predvolená hodnota je 60 sekúnd."

msgid "B<-u> username"
msgstr "B<-u> používateľskéMeno"

#, no-wrap
msgid "Sets the username for proxy authorization, if required."
msgstr "Nastaví používateľské meno pre autorizáciu proxy, ak je potrebné."

msgid "B<-x> password"
msgstr "B<-x> heslo"

#, no-wrap
msgid "Sets the password for proxy authorization, if required. If a username is specified but not a password, EepGet will prompt for the password."
msgstr "Nastaví heslo pre autorizáciu proxy, ak je potrebné. Ak je zadané používateľské meno, ale nie heslo, EepGet vyzve k zadaniu hesla."

#, no-wrap
msgid "EXIT STATUS"
msgstr "STAV UKONČENIA"

msgid "B<eepget> exits with status zero upon successful transfer and non-zero if there were problems with the download."
msgstr "B<eepget> sa ukončí so stavom nula pri úspešnom prenose a nenulovým stavom, ak boli problémy so sťahovaním."

#, no-wrap
msgid "REPORTING BUGS"
msgstr "HLÁSENIE CHÝB"

msgid "Please enter a ticket on E<.UR http://git.idk.i2p/i2p-hackers/i2p.i2p/-/issues/> the I2P Bug Tracker  E<.UE .>"
msgstr "Prosím, vytvorte ticket na E<.UR http://git.idk.i2p/i2p-hackers/i2p.i2p/-/issues/> I2P Bug Tracker  E<.UE .>"

#, no-wrap
msgid "SEE ALSO"
msgstr "POZRI TIEŽ"

msgid "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"
msgstr "B<i2prouter>(1)  B<curl>(1)  B<wget>(1)"

#, no-wrap
msgid "I2PROUTER"
msgstr "I2PROUTER"

msgid "i2prouter - start and stop the I2P router"
msgstr "i2prouter - spustenie a zastavenie routera I2P"

msgid "B<i2prouter> {I<console>|I<start>|I<stop>|I<graceful>|I<restart>|I<condrestart>|I<status>|I<dump>|I<install>|I<remove>}"
msgstr "B<i2prouter> {I<konzola>|I<štart>|I<stop>|I<graceful>|I<reštart>|I<condreštart>|I<stav>|I<dump>|I<inštalácia>|I<odstránenie>}"

msgid "Control the I2P service."
msgstr "Ovládanie služby I2P."

#, no-wrap
msgid "B<console>"
msgstr "B<konzola>"

msgid "Runs I2P as a console application under the current user."
msgstr "Spustí I2P ako konzolovú aplikáciu pod súčasným používateľom."

#, no-wrap
msgid "B<start>"
msgstr "B<štart>"

msgid "Starts the I2P service."
msgstr "Spustí službu I2P."

#, no-wrap
msgid "B<stop>"
msgstr "B<stop>"

msgid "Stops the I2P service."
msgstr "Zastaví službu I2P."

#, no-wrap
msgid "B<restart>"
msgstr "B<reštart>"

msgid "Stops the I2P service and then starts it."
msgstr "Zastaví službu I2P a potom ju spustí."

#, no-wrap
msgid "B<condrestart>"
msgstr "B<condreštart>"

msgid "Restart the I2P service only if it is already running."
msgstr "Reštartovať službu I2P len ak už beží."

#, no-wrap
msgid "B<graceful>"
msgstr "B<graceful>"

msgid "Stop I2P gracefully (may take up to 11 minutes)"
msgstr "Zastaviť I2P slušne (môže trvať až 11 minút)"

#, no-wrap
msgid "B<install>"
msgstr "B<inštalácia>"

msgid "Install initscript to start I2P automatically when the system boots."
msgstr "Nainštalovať init skript pre automatické spustenie I2P pri štarte systému."

#, no-wrap
msgid "B<remove>"
msgstr "B<odstránenie>"

msgid "Uninstall initscript that was installed with B<install>"
msgstr "Odinštalovať init skript, ktorý bol nainštalovaný pomocou B<inštalácia>"

#, no-wrap
msgid "B<status>"
msgstr "B<stav>"

msgid "Prints whether the I2P service is running."
msgstr "Vypíše, či služba I2P beží."

#, no-wrap
msgid "B<dump>"
msgstr "B<dump>"

msgid "Dumps the current threads into B<wrapper.log>."
msgstr "Vypíše súčasné vlákna do B<wrapper.log>."

msgid "B<i2prouter-nowrapper>(1)"
msgstr "B<i2prouter-nowrapper>(1)"

#, no-wrap
msgid "I2PROUTER-NOWRAPPER"
msgstr "I2PROUTER-NOWRAPPER"

msgid "i2prouter-nowrapper - start the I2P router"
msgstr "i2prouter-nowrapper - spustenie routera I2P"

msgid "B<i2prouter-nowrapper>"
msgstr "B<i2prouter-nowrapper>"

msgid "Start the I2P router, without the service wrapper.  This means the router will not restart if it crashes.  Also, it will use the default memory size, which may not be enough for I2P."
msgstr "Spustiť router I2P bez obslužného wrappera. To znamená, že router sa nereštartuje, ak spadne. Tiež bude používať predvolenú veľkosť pamäte, ktorá nemusí byť dostatočná pre I2P."

msgid "You should really use the B<i2prouter>(1)  script instead.  There are no options.  To stop the router, use your browser to access E<.UR http://localhost:7657/> the router console E<.UE .>"
msgstr "Mali by ste radšej použiť skript B<i2prouter>(1). Neexistujú žiadne možnosti. Pre zastavenie routera použite svoj prehliadač na prístup ku E<.UR http://localhost:7657/> konzole routera E<.UE .>"

msgid "B<i2prouter>(1)"
msgstr "B<i2prouter>(1)"
