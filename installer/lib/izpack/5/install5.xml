<?xml version="1.0" encoding="iso-8859-1" standalone="yes"?>
<!-- This is for izpack 5. See install.xml for izpack 4. -->
<izpack:installation version="5.0"
  xmlns:izpack="http://izpack.org/schema/installation"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://izpack.org/schema/installation http://izpack.org/schema/5.0/izpack-installation-5.0.xsd">
  <info>
    <appname>i2p</appname>
    <appversion>2.13.0+</appversion>
    <javaversion>1.8</javaversion>
    <!-- adding this element will make the installer attempt to launch itself with administrator permissions -->
    <run-privileged condition="izpack.windowsinstall"/>
  </info>
  <guiprefs width="680" height="440" resizable="yes">
    <!-- full names, not iso3 codes -->
    <modifier key="langDisplayType" value="native"/>
    <!-- no icons on buttons -->
    <modifier key="useButtonIcons" value="no"/>
    <!-- no icons in panel headers -->
    <modifier key="useLabelIcons" value="no"/>
    <modifier key="headingFontSize" value="1.3"/>
    <modifier key="labelGap" value="5"/>
  </guiprefs>

  <!--
    Locales: 2 or 3 character ISO language or country codes. IzPack matches them
    against the JVM's locales at runtime, preferring country over language codes,
    and that match is Java-version dependent (Java 8 reports 159 locales, Java 21
    reports 1050), so a listed code can still be skipped with
    "WARNING: No locale for: xx".

    Each code needs both com/izforge/izpack/bin/langpacks/installer/<iso3>.xml and
    .../flags/<iso3>.gif on the compiler classpath or the build fails. The
    distribution supplies all of these except ind, por and zho, which come from
    installer/lib/izpack/5/patches/resources and are staged onto the classpath by
    the izpack5-patches target in build.xml.

    Three codes the distribution does ship are deliberately unused: chn and bra
    are legacy spellings of zho and por, and idn is the upstream typo for
    Indonesia that Java resolves to Javanese - see
    https://old.reddit.com/r/i2p/comments/1e61lsp/wrong_country_name_indonesia_as_jawa/
  -->

  <locale>
    <langpack iso3="eng"/>
    <langpack iso3="cat"/>
    <langpack iso3="ces"/>
    <langpack iso3="dan"/>
    <langpack iso3="deu"/>
    <langpack iso3="ell"/>
    <langpack iso3="fas"/>
    <langpack iso3="fin"/>
    <langpack iso3="fra"/>
    <langpack iso3="hun"/>
    <langpack iso3="ind"/>
    <langpack iso3="ita"/>
    <langpack iso3="jpn"/>
    <langpack iso3="kor"/>
    <langpack iso3="nld"/>
    <langpack iso3="nor"/>
    <langpack iso3="pol"/>
    <langpack iso3="por"/>
    <langpack iso3="ron"/>
    <langpack iso3="rus"/>
    <langpack iso3="slk"/>
    <langpack iso3="spa"/>
    <langpack iso3="swe"/>
    <langpack iso3="tur"/>
    <langpack iso3="ukr"/>
    <langpack iso3="zho"/>
    <langpack iso3="ara"/>
    <langpack iso3="aze"/>
    <langpack iso3="ben"/>
    <langpack iso3="bod"/>
    <langpack iso3="est"/>
    <langpack iso3="heb"/>
    <langpack iso3="hin"/>
    <langpack iso3="pus"/>
    <langpack iso3="slv"/>
    <langpack iso3="swa"/>
    <langpack iso3="tha"/>
    <langpack iso3="fil"/>
    <langpack iso3="urd"/>
    <langpack iso3="vie"/>
  </locale>

  <!-- Resolved from the compiler classpath unless a panel references a resource
       explicitly. Needed by ShortcutPanel, RegistryInstallerListener and the
       language selector. -->
  <natives>
    <native type="izpack" name="ShellLink.dll"/>
    <native type="izpack" name="ShellLink_x64.dll"/>
    <native type="izpack" name="WinSetupAPI.dll"/>
    <native type="izpack" name="WinSetupAPI_x64.dll"/>
    <native type="3rdparty" name="COIOSHelper.dll"/>
    <native type="3rdparty" name="COIOSHelper_x64.dll"/>
  </natives>

  <!--
    Panel content resources are named <PanelClass>.<suffix>, or <PanelClass>.<id>
    when the panel carries an id - see PanelHelper.getPanelSpecificKey(). The
    compiler validates CustomLangPack.xml, shortcutSpec.xml and customicons.xml
    at build time.
    The native URLs are documented at
    https://izpack.atlassian.net/wiki/spaces/IZPACK/pages/491532/Advanced+Features
    and https://izpack.atlassian.net/wiki/spaces/IZPACK/pages/491676/RegistryInstallerListener+RegistryUninstallerListener
  -->
  <resources>
    <res id="installer.langsel.img" src="installer/lib/izpack/resources/images/i2plogo2.png"/>
    <res id="Installer.image" src="installer/lib/izpack/resources/images/i2plogo.png"/>
    <!--
         Id must be HTMLInfoPanel.info, not HTMLHelloPanel.info: the running panel is our
         LocalizedHTMLInfoPanel subclass, and IzPack derives the resource name from the class
         it instantiated, so the stock prefix is what it asks with. LocalizedResources
         rebases our name onto this one before looking it up. No HTMLHelloPanel is declared
         anywhere in this descriptor, so the old id resolved for nothing.
    -->
    <res id="HTMLInfoPanel.info" src="installer/lib/izpack/resources/welcome.html"/>
    <!--
         Per-language welcome pages. IzPack fetches an HTML panel's body by resource
         name and never through the langpack, so without these every language sees
         the English page. LocalizedHTMLInfoPanel resolves welcome_<iso3>.html and
         falls back to welcome.html. Generated by
         installer/lib/izpack/gen-izpack-welcome.py; English needs no page.
    -->
    <res id="welcome_ara.html" src="installer/lib/izpack/resources/welcome_ara.html"/>
    <res id="welcome_aze.html" src="installer/lib/izpack/resources/welcome_aze.html"/>
    <res id="welcome_ben.html" src="installer/lib/izpack/resources/welcome_ben.html"/>
    <res id="welcome_bod.html" src="installer/lib/izpack/resources/welcome_bod.html"/>
    <res id="welcome_cat.html" src="installer/lib/izpack/resources/welcome_cat.html"/>
    <res id="welcome_ces.html" src="installer/lib/izpack/resources/welcome_ces.html"/>
    <res id="welcome_dan.html" src="installer/lib/izpack/resources/welcome_dan.html"/>
    <res id="welcome_deu.html" src="installer/lib/izpack/resources/welcome_deu.html"/>
    <res id="welcome_ell.html" src="installer/lib/izpack/resources/welcome_ell.html"/>
    <res id="welcome_est.html" src="installer/lib/izpack/resources/welcome_est.html"/>
    <res id="welcome_fas.html" src="installer/lib/izpack/resources/welcome_fas.html"/>
    <res id="welcome_fil.html" src="installer/lib/izpack/resources/welcome_fil.html"/>
    <res id="welcome_fin.html" src="installer/lib/izpack/resources/welcome_fin.html"/>
    <res id="welcome_fra.html" src="installer/lib/izpack/resources/welcome_fra.html"/>
    <res id="welcome_heb.html" src="installer/lib/izpack/resources/welcome_heb.html"/>
    <res id="welcome_hin.html" src="installer/lib/izpack/resources/welcome_hin.html"/>
    <res id="welcome_hun.html" src="installer/lib/izpack/resources/welcome_hun.html"/>
    <res id="welcome_ind.html" src="installer/lib/izpack/resources/welcome_ind.html"/>
    <res id="welcome_ita.html" src="installer/lib/izpack/resources/welcome_ita.html"/>
    <res id="welcome_jpn.html" src="installer/lib/izpack/resources/welcome_jpn.html"/>
    <res id="welcome_kor.html" src="installer/lib/izpack/resources/welcome_kor.html"/>
    <res id="welcome_nld.html" src="installer/lib/izpack/resources/welcome_nld.html"/>
    <res id="welcome_nor.html" src="installer/lib/izpack/resources/welcome_nor.html"/>
    <res id="welcome_pol.html" src="installer/lib/izpack/resources/welcome_pol.html"/>
    <res id="welcome_por.html" src="installer/lib/izpack/resources/welcome_por.html"/>
    <res id="welcome_pus.html" src="installer/lib/izpack/resources/welcome_pus.html"/>
    <res id="welcome_ron.html" src="installer/lib/izpack/resources/welcome_ron.html"/>
    <res id="welcome_rus.html" src="installer/lib/izpack/resources/welcome_rus.html"/>
    <res id="welcome_slk.html" src="installer/lib/izpack/resources/welcome_slk.html"/>
    <res id="welcome_slv.html" src="installer/lib/izpack/resources/welcome_slv.html"/>
    <res id="welcome_spa.html" src="installer/lib/izpack/resources/welcome_spa.html"/>
    <res id="welcome_swa.html" src="installer/lib/izpack/resources/welcome_swa.html"/>
    <res id="welcome_swe.html" src="installer/lib/izpack/resources/welcome_swe.html"/>
    <res id="welcome_tha.html" src="installer/lib/izpack/resources/welcome_tha.html"/>
    <res id="welcome_tur.html" src="installer/lib/izpack/resources/welcome_tur.html"/>
    <res id="welcome_ukr.html" src="installer/lib/izpack/resources/welcome_ukr.html"/>
    <res id="welcome_urd.html" src="installer/lib/izpack/resources/welcome_urd.html"/>
    <res id="welcome_vie.html" src="installer/lib/izpack/resources/welcome_vie.html"/>
    <res id="welcome_zho.html" src="installer/lib/izpack/resources/welcome_zho.html"/>
    <res id="XInfoPanel.info" src="installer/lib/izpack/resources/start-i2p.txt"/>
    <res id="HTMLInfoPanel.winservice" src="installer/resources/platform-specific/windows/windows_service_help.html"/>
    <res id="shortcutSpec.xml" src="installer/lib/izpack/resources/shortcutSpec.xml"/>

    <!-- Blank "Made with IzPack", the title of the etched border around the log
         window. One pack covers every language: IzPack merges it over whichever
         langpack is selected with LocaleDatabase.add, a TreeMap putAll. The name
         must be exactly "CustomLangPack.xml" - the resource lookup does no locale
         suffixing, so a per-language name is silently never found. Generated by
         installer/lib/izpack/gen-izpack-langpacks.py. -->
    <res id="CustomLangPack.xml" src="installer/lib/izpack/resources/CustomLangPack.xml"/>
    <!-- Window icon. customicons.xml refers to console.png by its jar path
         (/resources/console.png), so both have to be bundled. -->
    <res id="customicons.xml" src="installer/lib/izpack/5/customicons.xml"/>
    <res id="console.png" src="installer/lib/izpack/resources/images/console.png"/>
  </resources>

  <variables>
    <!-- desktop shortcuts enabled by default in ShortcutPanel -->
    <variable name="DesktopShortcutCheckboxEnabled" value="true"/>
  </variables>

  <conditions>
    <condition type="contains" id="is64bit">
      <string>${SYSTEM[sun.arch.data.model]}</string>
      <value>64</value>
    </condition>
  </conditions>

  <!-- 32-bit Windows is unsupported; the message shows as an error dialog. -->
  <installerrequirements>
    <installerrequirement condition="is64bit|!izpack.windowsinstall" message="I2P+ requires 64-bit Windows and a 64-bit Java runtime. This computer is running a 32-bit configuration, which is no longer supported. Installation will now exit."/>
  </installerrequirements>

  <panels>
    <!-- Our subclass of HTMLInfoPanel: IzPack fetches an HTML panel's body with
         Resources.getURL(), which never consults the langpack, so the stock
         HTMLHelloPanel shows one welcome.html for every language. This resolves
         welcome_<iso3>.html and falls back to welcome.html, so a translation is
         added simply by registering the file.
         It needs three classes, not one: IzPack resolves a panel's console
         counterpart and automation helper from the declared class name, so without
         LocalizedHTMLInfoConsolePanel and LocalizedHTMLInfoPanelAutomationHelper a
         -console or -options-auto install dies on this panel with "Console
         implementation not found". The GUI never looks for them, which is why the
         omission only ever showed up in text mode - IzPack 4 is unaffected because
         it uses the stock HelloPanel. LocalizedResourcesTest asserts both resolve.
         Built by ant izpack-panel-jar. -->
    <panel classname="net.i2p.installer.LocalizedHTMLInfoPanel"/>

    <panel classname="TargetPanel"/>
    <!-- Order matters from here on. PacksPanel NPEs at install time if it
         precedes TargetPanel. -->
    <panel classname="PacksPanel">
      <os family="windows"/>
    </panel>
    <panel classname="InstallPanel"/>
    <!-- ShortcutPanel must follow InstallPanel so the .ico files exist, unless
         shortcutSpec.xml sets lateShortcutInstall. -->
    <panel classname="ShortcutPanel">
      <os family="windows"/>
    </panel>
    <!-- Both info panels are condition-gated rather than os-gated: XInfoPanel is
         skipped entirely under -console without a console helper, so it cannot
         carry an <os> restriction. -->
    <panel classname="XInfoPanel" condition="!izpack.windowsinstall"/>
    <panel classname="HTMLInfoPanel" id="winservice" condition="izpack.windowsinstall"/>
    <panel classname="SimpleFinishPanel"/>
  </panels>

  <packs>
    <pack name="Base" required="yes">
      <description>Base installation files</description>
      <!-- non-jars -->
      <fileset dir="pkg-temp" excludes="**/*.jar" targetdir="$INSTALL_PATH"/>
      <!-- jars, split by whether -pre-pack200 was able to rewrite them -->
      <fileset dir="pkg-temp"
        includes="**/*.jar"
        excludes="lib/commons-logging.jar lib/jasper-compiler.jar lib/jetty-java5-threadpool.jar lib/jetty-sslengine.jar lib/jbigi.jar"
        targetdir="$INSTALL_PATH"/>
      <fileset dir="pkg-temp"
        includes="lib/commons-logging.jar lib/jasper-compiler.jar lib/jetty-java5-threadpool.jar lib/jetty-sslengine.jar lib/jbigi.jar"
        targetdir="$INSTALL_PATH"/>
      <!--
        Variable substitution on the staged scripts and wrapper.config, which
        still hold the payload's placeholders at this point.

        type="shell" changes the placeholder prefix from $ to % so that a script's
        own $VARIABLEs are left alone - unix/i2prouter alone has 473 of them.
        wrapper.config uses the default $ prefix, hence type="plain".
      -->
      <parsable targetfile="$INSTALL_PATH/wrapper.config" type="plain"/>
      <parsable targetfile="$INSTALL_PATH/i2prouter" type="shell">
        <os family="unix"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/eepget" type="shell">
        <os family="unix"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/eephead" type="shell">
        <os family="unix"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/i2ping" type="shell">
        <os family="unix"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/eepget.bat" type="shell">
        <os family="windows"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/eephead.bat" type="shell">
        <os family="windows"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/runplain.sh" type="shell">
        <os family="unix"/>
      </parsable>
      <parsable targetfile="$INSTALL_PATH/Start I2P Router.app/Contents/MacOS/i2prouter" type="shell">
        <os family="mac"/>
      </parsable>
      <!--
        Windows postinstall, all 64-bit only. Copy I2Psvc.exe (the cross-compiled
        Tanuki service wrapper, see installer/lib/wrapper/build-wrapper-win64.sh)
        to the install root, where service.ps1 expects it.
      -->
      <executable targetfile="$INSTALL_PATH/utility.jar"
        type="jar"
        class="net.i2p.installer.Main"
        stage="postinstall"
        keep="true"
        failure="warn">
        <os family="windows"/>
        <args>
          <arg value="copy"/>
          <arg value="$INSTALL_PATH\lib\wrapper\win64\I2Psvc.exe"/>
          <arg value="$INSTALL_PATH"/>
        </args>
      </executable>
      <!--
        Copy the JNI wrapper library next to the exe. WrapperManager (used
        by the router console service page and i2pcontrol) loads it via
        java.library.path, which wrapper.config points at $INSTALL_PATH\lib.
      -->
      <executable targetfile="$INSTALL_PATH/utility.jar"
        type="jar"
        class="net.i2p.installer.Main"
        stage="postinstall"
        keep="true"
        failure="warn">
        <os family="windows"/>
        <args>
          <arg value="copy"/>
          <arg value="$INSTALL_PATH\lib\wrapper\win64\wrapper.dll"/>
          <arg value="$INSTALL_PATH\lib"/>
        </args>
      </executable>
      <!-- workaround for bad default path for wrapper.log in Windows. -->
      <executable targetfile="$INSTALL_PATH/utility.jar"
        type="jar"
        class="net.i2p.installer.Main"
        stage="postinstall" keep="true">
        <os family="windows"/>
        <args>
          <arg value="fixwinpaths"/>
          <arg value="$INSTALL_PATH\wrapper.config"/>
        </args>
      </executable>
      <!-- Now we'll get rid of the UNIX-only stuff -->
      <executable targetfile="$INSTALL_PATH/utility.jar"
        type="jar"
        class="net.i2p.installer.Main"
        stage="postinstall" keep="true" failure="warn">
        <os family="windows"/>
        <args>
          <arg value="delete"/>
          <arg value="$INSTALL_PATH\i2prouter"/>
          <arg value="$INSTALL_PATH\install_i2p_service_unix"/>
          <arg value="$INSTALL_PATH\install-headless.txt"/>
          <arg value="$INSTALL_PATH\runplain.sh"/>
          <arg value="$INSTALL_PATH\osid"/>
          <arg value="$INSTALL_PATH\postinstall.sh"/>
          <arg value="$INSTALL_PATH\uninstall_i2p_service_unix"/>
          <arg value="$INSTALL_PATH\lib\wrapper"/>
          <arg value="$INSTALL_PATH\eepget"/>
          <arg value="$INSTALL_PATH/Start I2P Router.app"/>
          <arg value="$INSTALL_PATH/net.i2p.router.plist.template"/>
          <arg value="$INSTALL_PATH/install_i2p_service_osx.command"/>
          <arg value="$INSTALL_PATH/uninstall_i2p_service_osx.command"/>
          <arg value="$INSTALL_PATH/man"/>
          <arg value="$INSTALL_PATH/locale"/>
        </args>
      </executable>

      <!-- change owner to %username% so updates will work -->
      <executable targetfile="powershell.exe" stage="postinstall" keep="true" failure="warn">
        <os family="windows"/>
        <args>
          <arg value="-NoProfile"/>
          <arg value="-ExecutionPolicy"/>
          <arg value="Bypass"/>
          <arg value="-File"/>
          <arg value="$INSTALL_PATH\service.ps1"/>
          <arg value="-Action"/>
          <arg value="FixPerms"/>
          <arg value="-Target"/>
          <arg value="$INSTALL_PATH"/>
        </args>
      </executable>

      <executable targetfile="$INSTALL_PATH/utility.jar"
        type="jar"
        class="net.i2p.installer.Main"
        stage="postinstall" keep="false" failure="warn">
        <os family="windows"/>
        <args>
          <arg value="delete"/>
          <arg value="$INSTALL_PATH/utility.jar"/>
        </args>
      </executable>
      <!-- *nix postinstall. stage="never" only marks the script executable. -->
      <executable targetfile="$INSTALL_PATH/postinstall.sh" type="bin" stage="never" keep="true" failure="warn">
        <os family="unix"/>
      </executable>
      <executable targetfile="$INSTALL_PATH/postinstall.sh" type="bin" stage="postinstall" keep="true" failure="warn">
        <os family="unix"/>
        <args>
          <arg value="$INSTALL_PATH"/>
        </args>
      </executable>
      <!--
         Removal of the I2P service in Windows should be done in the base pack so that even if a user installed
         the service manually it will still be removed when uninstalling.
      -->
      <executable targetfile="powershell.exe" stage="uninstall" failure="warn">
        <os family="windows"/>
        <args>
          <arg value="-NoProfile"/>
          <arg value="-ExecutionPolicy"/>
          <arg value="Bypass"/>
          <arg value="-File"/>
          <arg value="$INSTALL_PATH\service.ps1"/>
          <arg value="-Action"/>
          <arg value="Uninstall"/>
        </args>
      </executable>
    </pack>
    <!-- to disable by default, add preselected="no" -->
    <pack name="Windows Service" required="yes" preselected="yes">
      <description>Install I2P+ as a service and run automatically at startup</description>
      <os family="windows"/>
      <executable targetfile="powershell.exe" stage="postinstall" failure="warn" keep="true">
        <args>
          <arg value="-NoProfile"/>
          <arg value="-ExecutionPolicy"/>
          <arg value="Bypass"/>
          <arg value="-File"/>
          <arg value="$INSTALL_PATH\service.ps1"/>
          <arg value="-Action"/>
          <arg value="Install"/>
        </args>
      </executable>
      <executable targetfile="powershell.exe" stage="postinstall" failure="warn" keep="true">
        <args>
          <arg value="-NoProfile"/>
          <arg value="-ExecutionPolicy"/>
          <arg value="Bypass"/>
          <arg value="-File"/>
          <arg value="$INSTALL_PATH\service.ps1"/>
          <arg value="-Action"/>
          <arg value="Start"/>
        </args>
      </executable>
    </pack>
  </packs>
</izpack:installation>
