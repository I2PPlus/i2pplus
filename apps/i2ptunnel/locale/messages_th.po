msgstr "ไม่มีรหัสผ่านการค้นหา"

msgid "Missing private key"
msgstr "ไม่มีกุญแจส่วนตัว"

msgid "Invalid private key"
msgstr "กุญแจส่วนตัวไม่ถูกต้อง"

msgid "Your new encryption key"
msgstr "กุญแจการเข้ารหัสใหม่ของคุณ"

