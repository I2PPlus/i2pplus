msgid "This seems to be a bad destination:"
msgstr "ดูเหมือนว่าจะเป็นปลายทางที่ไม่ถูกต้อง:"

msgid "i2paddresshelper cannot help you with a destination like that!"
msgstr "i2paddresshelperไม่สามารถช่วยคุณกับปลายทางแบบนั้นได้!"

#, java-format
msgid "To visit the destination in your addressbook, click <a href=\"{0}\">here</a>. To visit the conflicting addresshelper destination, click <a href=\"{1}\">here</a>."
msgstr "หากต้องการเปิดปลายทางในสมุดที่อยู่ของคุณให้คลิก<a href=\"{0}\">ที่นี่</a>.หากต้องการเปิดปลายทางที่ขัดแย้งกันของaddresshelperให้คลิก<a href=\"{1}\">ที่นี่</a>."

#, java-format
msgid "Destination for {0} in addressbook"
msgstr "ปลายทางของ{0}ในสมุดที่อยู่"

msgid "Conflicting address helper destination"
msgstr "ปลายทางของaddresshelperที่ขัดแย้งกัน"

msgid "Corrupt Base32 address"
msgstr "ที่อยู่Base32เสียหาย"

msgid "Destination LeaseSet not found"
msgstr "ไม่พบLeaseSetของปลายทาง"

msgid "Host"
msgstr "โฮสต์"

msgid "Base32"
msgstr "Base32"

msgid "Destination"
msgstr "ปลายทาง"

#, java-format
msgid "Continue to {0} without saving"
msgstr "ดำเนินการต่อไปยัง{0}โดยไม่บันทึก"

msgid "You can browse to the site without saving it to the addressbook. The address will be remembered until you restart your I2P router."
msgstr "คุณสามารถเลือกดูเว็บไซต์ได้โดยไม่ต้องบันทึกลงในสมุดที่อยู่ที่อยู่จะถูกจดจำไว้จนกว่าคุณจะเริ่มเราเตอร์I2Pใหม่."

msgid "Continue without saving"
msgstr "ดำเนินการต่อโดยไม่บันทึก"

#, java-format
msgid "Save {0} to router address book and continue to website"
msgstr "บันทึก{0}ลงในสมุดที่อยู่เราเตอร์และดำเนินการต่อไปยังเว็บไซต์"

msgid "This address will be saved to your Router addressbook where your subscription-based addresses are stored."
msgstr "ที่อยู่นี้จะถูกบันทึกลงในสมุดที่อยู่เราเตอร์ของคุณซึ่งเก็บที่อยู่ที่มาจากการติดตาม."

msgid "If you want to keep track of sites you have added manually, add to your Master or Private addressbook instead."
msgstr "หากต้องการติดตามเว็บไซต์ที่คุณเพิ่มด้วยตนเองให้เพิ่มลงในสมุดที่อยู่หลักหรือสมุดที่อยู่ส่วนตัวแทน."

msgid "Save & continue"
msgstr "บันทึก&ดำเนินการต่อ"

#, java-format
msgid "Save {0} to master addressbook and continue to website"
msgstr "บันทึก{0}ลงในสมุดที่อยู่หลักและดำเนินการต่อไปยังเว็บไซต์"

msgid "This address will be saved to your Master addressbook. Select this option for addresses you wish to keep separate from the main router address book, but don't mind publishing."
msgstr "ที่อยู่นี้จะถูกบันทึกลงในสมุดที่อยู่หลักของคุณเลือกตัวเลือกนี้สำหรับที่อยู่ที่คุณต้องการเก็บแยกจากสมุดที่อยู่เราเตอร์หลักแต่ไม่เป็นไรที่จะเผยแพร่."

#, java-format
msgid "Save {0} to private addressbook and continue to website"
msgstr "บันทึก{0}ลงในสมุดที่อยู่ส่วนตัวและดำเนินการต่อไปยังเว็บไซต์"

msgid "This address will be saved to your Private addressbook, ensuring it is never published."
msgstr "ที่อยู่นี้จะถูกบันทึกลงในสมุดที่อยู่ส่วนตัวของคุณเพื่อให้แน่ใจว่าจะไม่ถูกเผยแพร่."

msgid "Base32 address requires lookup password"
msgstr "ที่อยู่Base32ต้องการรหัสผ่านการค้นหา"

msgid "Base32 address requires encryption key"
msgstr "ที่อยู่Base32ต้องการกุญแจการเข้ารหัส"

msgid "Base32 address requires encryption key and lookup password"
msgstr "ที่อยู่Base32ต้องการกุญแจการเข้ารหัสและรหัสผ่านการค้นหา"

msgid "Base32 address decryption failure, check encryption key"
msgstr "ถอดรหัสที่อยู่Base32ล้มเหลวโปรดตรวจสอบกุญแจการเข้ารหัส"

msgid "Generate"
msgstr "สร้าง"

msgid "Encryption key"
msgstr "กุญแจการเข้ารหัส"

msgid "You must either enter a PSK encryption key provided by the server operator, or generate a DH encryption key and send that to the server operator."
msgstr "คุณต้องป้อนกุญแจการเข้ารหัสPSKที่ผู้ดำเนินการเซิร์ฟเวอร์ให้หรือสร้างกุญแจการเข้ารหัสDHแล้วส่งไปยังผู้ดำเนินการเซิร์ฟเวอร์."

msgid "Ask the server operator for help."
msgstr "ขอความช่วยเหลือจากผู้ดำเนินการเซิร์ฟเวอร์."

msgid "Enter PSK encryption key"
msgstr "ป้อนกุญแจการเข้ารหัสPSK"

msgid "Generate new DH encryption key"
msgstr "สร้างกุญแจการเข้ารหัสDHใหม่"

msgid "Lookup password"
msgstr "รหัสผ่านการค้นหา"

msgid "You must enter the password provided by the server operator."
msgstr "คุณต้องป้อนรหัสผ่านที่ผู้ดำเนินการเซิร์ฟเวอร์ให้."

msgid "HTTP Outproxy"
msgstr "outproxyHTTP"

