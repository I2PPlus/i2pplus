msgid "This seems to be a bad destination:"
msgstr "یہ خراب مقصد لگتا ہے:"

msgid "i2paddresshelper cannot help you with a destination like that!"
msgstr "i2paddresshelper ایسے مقصد میں آپ کی مدد نہیں کر سکتا!"

#, java-format
msgid "To visit the destination in your addressbook, click <a href=\"{0}\">here</a>. To visit the conflicting addresshelper destination, click <a href=\"{1}\">here</a>."
msgstr "اپنی پتہ کتاب میں موجود مقصد پر جانے کے لیے <a href=\"{0}\">یہاں</a> کلک کریں۔ متنازع ایڈریس ہیلپر مقصد پر جانے کے لیے <a href=\"{1}\">یہاں</a> کلک کریں۔"

#, java-format
msgid "Destination for {0} in addressbook"
msgstr "پتہ کتاب میں {0} کا مقصد"

msgid "Conflicting address helper destination"
msgstr "متنازع ایڈریس ہیلپر مقصد"

msgid "Corrupt Base32 address"
msgstr "خراب Base32 پتہ"

msgid "Destination LeaseSet not found"
msgstr "مقصد کا LeaseSet نہیں ملا"

msgid "Host"
msgstr "میزبان"

msgid "Base32"
msgstr "Base32"

msgid "Destination"
msgstr "مقصد"

#, java-format
msgid "Continue to {0} without saving"
msgstr "محفوظ کیے بغیر {0} پر جاری رکھیں"

msgid "You can browse to the site without saving it to the addressbook. The address will be remembered until you restart your I2P router."
msgstr "آپ سائٹ پر بغیر اسے پتہ کتاب میں محفوظ کیے دیکھ سکتے ہیں۔ پتہ یاد رکھا جائے گا جب تک آپ اپنا I2P روٹر دوبارہ شروع نہ کریں۔"

msgid "Continue without saving"
msgstr "محفوظ کیے بغیر جاری رکھیں"

#, java-format
msgid "Save {0} to router address book and continue to website"
msgstr "{0} کو روٹر پتہ کتاب میں محفوظ کریں اور ویب سائٹ پر جاری رکھیں"

msgid "This address will be saved to your Router addressbook where your subscription-based addresses are stored."
msgstr "یہ پتہ آپ کی روٹر پتہ کتاب میں محفوظ ہوگا جہاں آپ کے سبسکرپشن پر مبنی پتے محفوظ ہوتے ہیں۔"

msgid "If you want to keep track of sites you have added manually, add to your Master or Private addressbook instead."
msgstr "اگر آپ دستی طور پر شامل کیے گئے سائٹس کا ریکارڈ رکھنا چاہتے ہیں تو اس کے بجائے اپنی ماسٹر یا نجی پتہ کتاب میں شامل کریں۔"

msgid "Save & continue"
msgstr "محفوظ کریں & جاری رکھیں"

#, java-format
msgid "Save {0} to master addressbook and continue to website"
msgstr "{0} کو ماسٹر پتہ کتاب میں محفوظ کریں اور ویب سائٹ پر جاری رکھیں"

msgid "This address will be saved to your Master addressbook. Select this option for addresses you wish to keep separate from the main router address book, but don't mind publishing."
msgstr "یہ پتہ آپ کی ماسٹر پتہ کتاب میں محفوظ ہوگا۔ ایسے پتے کے لیے یہ آپشن منتخب کریں جنہیں آپ بنیادی روٹر پتہ کتاب سے الگ رکھنا چاہتے ہیں لیکن شائع کرنے پر رضامند ہیں۔"

#, java-format
msgid "Save {0} to private addressbook and continue to website"
msgstr "{0} کو نجی پتہ کتاب میں محفوظ کریں اور ویب سائٹ پر جاری رکھیں"

msgid "This address will be saved to your Private addressbook, ensuring it is never published."
msgstr "یہ پتہ آپ کی نجی پتہ کتاب میں محفوظ ہوگا، یہ یقینی بنا کر کہ یہ کبھی شائع نہیں کیا جائے گا۔"

msgid "Base32 address requires lookup password"
msgstr "Base32 پتے کے لیے تلاش کا پاس ورڈ درکار ہے"

msgid "Base32 address requires encryption key"
msgstr "Base32 پتے کے لیے خفیہ کاری کلید درکار ہے"

msgid "Base32 address requires encryption key and lookup password"
msgstr "Base32 پتے کے لیے خفیہ کاری کلید اور تلاش کا پاس ورڈ درکار ہے"

msgid "Base32 address decryption failure, check encryption key"
msgstr "Base32 پتے کی ڈی کرپشن ناکام، خفیہ کاری کلید چیک کریں"

msgid "Generate"
msgstr "بنائیں"

msgid "Encryption key"
msgstr "خفیہ کاری کلید"

msgid "You must either enter a PSK encryption key provided by the server operator, or generate a DH encryption key and send that to the server operator."
msgstr "آپ کو یا تو سرور آپریٹر کی فراہم کردہ PSK خفیہ کاری کلید درج کرنی ہوگی، یا DH خفیہ کاری کلید بنا کر اسے سرور آپریٹر کو بھیجنا ہوگا۔"

msgid "Ask the server operator for help."
msgstr "سرور آپریٹر سے مدد مانگیں۔"

msgid "Enter PSK encryption key"
msgstr "PSK خفیہ کاری کلید درج کریں"

msgid "Generate new DH encryption key"
msgstr "نئی DH خفیہ کاری کلید بنائیں"

msgid "Lookup password"
msgstr "تلاش کا پاس ورڈ"

msgid "You must enter the password provided by the server operator."
msgstr "آپ کو سرور آپریٹر کی فراہم کردہ پاس ورڈ درج کرنا ہوگا۔"

msgid "HTTP Outproxy"
msgstr "HTTP outproxy"

msgid "Click a link below for an address helper from a jump service"
msgstr "کسی jump سروس کی ایڈریس ہیلپر کے لیے نیچے دیا گیا کوئی لنک کلک کریں"

#, java-format
msgid "Added via address helper from {0}"
msgstr "{0} کی ایڈریس ہیلپر کے ذریعے شامل شدہ"

msgid "Added via address helper"
msgstr "ایڈریس ہیلپر کے ذریعے شامل شدہ"

