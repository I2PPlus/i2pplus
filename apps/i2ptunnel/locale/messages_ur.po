msgid "SOCKS IRC proxy"
msgstr "SOCKS IRC پراکسی"

msgid "CONNECT/SSL/HTTPS proxy"
msgstr "CONNECT/SSL/HTTPS پراکسی"

msgid "IRC server"
msgstr "IRC سرور"

msgid "Streamr client"
msgstr "Streamr کلائنٹ"

msgid "Streamr server"
msgstr "Streamr سرور"

msgid "HTTP bidir"
msgstr "HTTP دو سو"

msgid "Host not set"
msgstr "میزبان مقرر نہیں"

msgid "Invalid address"
msgstr "ناقابلِ قبول پتہ"

msgid "Tunnel Manager"
msgstr "ٹنل مینیجر"

msgid "Edit Client Tunnel"
msgstr "کلائنٹ ٹنل میں ترمیم کریں"

msgid "Edit Server Tunnel"
msgstr "سرور ٹنل میں ترمیم کریں"

msgid "Are you sure you want to delete?"
msgstr "کیا واقعی حذف کرنا ہے؟"

msgid "required"
msgstr "ضروری"

msgid "Tunnel and all other shared client tunnels must be stopped to change this configuration"
msgstr "اس ترتیب کو تبدیل کرنے کے لیے ٹنل اور دیگر تمام شیئر شدہ کلائنٹ ٹنلز کو روکا جانا چاہیے"

msgid "Tunnel must be stopped to change this configuration"
msgstr "اس ترتیب کو تبدیل کرنے کے لیے ٹنل کو روکا جانا چاہیے"

msgid "New Client Configuration"
msgstr "نئی کلائنٹ ترتیبات"

msgid "Name"
msgstr "نام"

msgid "Auto Start Tunnel"
msgstr "ٹنل خودکار شروع کریں"

msgid "Name of tunnel to be displayed on Tunnel Manager home page and the router console sidebar"
msgstr "وہ ٹنل کا نام جو ٹنل مینیجر کے ہوم صفحے اور روٹر کنسول کی سائیڈ بار پر دکھایا جائے گا"

msgid "Enable this option to ensure this service is available when the router starts"
msgstr "یہ آپشن فعال کریں تاکہ یقینی بنے کہ روٹر شروع ہونے پر یہ سروس دستیاب ہوگی"

msgid "Automatically start tunnel when router starts"
msgstr "روٹر شروع ہونے پر ٹنل خودکار شروع کریں"

msgid "Description"
msgstr "تفصیل"

msgid "Shared Client"
msgstr "شیئر شدہ کلائنٹ"

msgid "Description of tunnel to be displayed on Tunnel Manager home page"
msgstr "وہ ٹنل کی تفصیل جو ٹنل مینیجر کے ہوم صفحے پر دکھائی جائے گی"

msgid "Traffic from all clients with this feature enabled will be routed over the same set of tunnels. This will make profiling the tunnels by an adversary more difficult, but will link the clients together."
msgstr "اس خصوصیت کے فعال ہونے والے تمام کلائنٹس کا ٹریفک ایک ہی ٹنلز کے مجموعے سے گزارا جائے گا۔ اس سے کسی مخالف کے لیے ٹنلز کا پروفائل بنانا مشکل ہو جائے گا لیکن کلائنٹس آپس میں منسلک ہو جائیں گے۔"

msgid "Share tunnels with other configured clients"
msgstr "دوسرے ترتیب شدہ کلائنٹس کے ساتھ ٹنلز شیئر کریں"

msgid "Target"
msgstr "ہدف"

msgid "Access Point"
msgstr "رسائی نقطہ"

msgid "Use Outproxy Plugin"
msgstr "outproxy پلگ ان استعمال کریں"

msgid "Enable DCC"
msgstr "DCC فعال کریں"

msgid "Port"
msgstr "پورٹ"

msgid "Specify the local port this service should be accessible from"
msgstr "وہ مقامی پورٹ مقرر کریں جس سے یہ سروس قابلِ رسائی ہونی چاہیے"

msgid "Hostname or IP address of the target server"
msgstr "ہدف سرور کا ہوسٹ نیم یا IP پتہ"

msgid "Reachable by"
msgstr "رسائی کس سے"

msgid "Local interface (ip address) the client tunnel will be reachable from"
msgstr "مقامی انٹرفیس (ip پتہ) جس سے کلائنٹ ٹنل تک رسائی ہوگی"

msgid "If an outproxy plugin is installed (e.g. Orchid), use this instead of any configured outproxies to access websites outside of I2P"
msgstr "اگر کوئی outproxy پلگ ان انسٹال ہو (مثلاً Orchid) تو I2P سے باہر کی ویب سائٹس تک رسائی کے لیے ترتیب شدہ کسی بھی outproxy کے بجائے اسے استعمال کریں"

msgid "Use plugin instead of proxies listed below if available"
msgstr "اگر دستیاب ہو تو نیچے درج پراکسیز کے بجائے پلگ ان استعمال کریں"

msgid "Enables direct chat and file transfers, bypassing I2P. Note that this will compromise your anonymity and is not recommended."
msgstr "یہ I2P کو نظر انداز کرتے ہوئے براہِ راست چیٹ اور فائل منتقلیات فعال کرتا ہے۔ نوٹ کریں کہ اس سے آپ کی گمنیمیت کو نقصان پہنچ سکتا ہے اور اس کی تجویز نہیں کی جاتی۔"

msgid "Enable Direct Client-to-Client protocol"
msgstr "Direct Client-to-Client پروٹوکول فعال کریں"

msgid "Outproxies"
msgstr "outproxies"

msgid "SSL Outproxies"
msgstr "SSL outproxies"

msgid "Specify the .i2p address or destination (b32 or b64) of the outproxy here."
msgstr "یہاں outproxy کا .i2p پتہ یا مقصد (b32 یا b64) مقرر کریں۔"

msgid "For a random selection from a pool, separate with commas e.g. server1.i2p,server2.i2p"
msgstr "قطار سے بے ترتیب انتخاب کے لیے کوما سے الگ کریں مثلاً server1.i2p,server2.i2p"

msgid "Outproxy Type"
msgstr "outproxy کی قسم"

msgid "Tunnel Destination"
msgstr "ٹنل کا مقصد"

msgid "Use SSL"
msgstr "SSL استعمال کریں"

msgid "Specify the .i2p address or destination (b32 or b64) of the tunnel here."
msgstr "یہاں ٹنل کا .i2p پتہ یا مقصد (b32 یا b64) مقرر کریں۔"

msgid "name, name:port, or destination"
msgstr "نام، نام:پورٹ، یا مقصد"

msgid "If you are accessing a service on a remote I2P router, you may wish to connect with SSL to avoid traffic interception. The client application should be also be configured to use SSL."
msgstr "اگر آپ کسی ریموٹ I2P روٹر پر کوئی سروس حاصل کر رہے ہیں تو ٹریفک راوی سے بچنے کے لیے آپ SSL کے ساتھ منسلک ہونا چاہیں گے۔ کلائنٹ ایپلیکیشن کو بھی SSL استعمال کرنے کے لیے ترتیب دیا جانا چاہیے۔"

msgid "Clients use SSL to connect to tunnel"
msgstr "کلائنٹس ٹنل سے منسلک ہونے کے لیے SSL استعمال کرتے ہیں"

msgid "Please specify the full b64 destination."
msgstr "براہِ کرم مکمل b64 مقصد مقرر کریں۔"

msgid "Local destination"
msgstr "مقامی مقصد"

msgid "Local Base32"
msgstr "مقامی Base32"

msgid "Read Only: Local Destination (if known)"
msgstr "صرف پڑھنے کے لیے: مقامی مقصد (اگر معلوم ہو)"

msgid "Stop"
msgstr "روکیں"

msgid "Start this Tunnel"
msgstr "یہ ٹنل شروع کریں"

msgid "Start"
msgstr "شروع کریں"

msgid "Cancel"
