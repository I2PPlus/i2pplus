msgstr "تلاش کا پاس ورڈ موجود نہیں"

msgid "Missing private key"
msgstr "نجی کلید موجود نہیں"

msgid "Invalid private key"
msgstr "ناقابلِ قبول نجی کلید"

msgid "Your new encryption key"
msgstr "نئی خفیہ کاری کلید"

msgid "Router Console"
msgstr "روٹر کنسول"

msgid "Addressbook"
msgstr "پتہ کتاب"

msgid "Configuration"
msgstr "ترتیبات"

msgid "Help"
msgstr "مدد"

msgid "Copy the key and send it to the server operator."
msgstr "کلید کاپی کر کے سرور آپریٹر کو بھیجیں۔"

msgid "After you are granted permission, you may proceed to the website."
msgstr "اجازت ملنے کے بعد آپ ویب سائٹ پر جا سکتے ہیں۔"

msgid "Go back and fix the error"
msgstr "واپس جائیں اور خرابی درست کریں"

msgid "router"
msgstr "روٹر"

msgid "master"
msgstr "ماسٹر"

msgid "private"
msgstr "نجی"

