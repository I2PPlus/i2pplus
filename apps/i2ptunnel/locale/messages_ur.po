#, java-format
msgid "Cannot configure, no Jetty server found in {0}client configurations{1} that matches this tunnel"
msgstr "ترتیب نہیں دی جا سکتی، {0}client configurations{1} میں ایسا کوئی Jetty سرور نہیں ملا جو اس ٹنل سے مطابقت رکھتا ہو"

msgid "Support for non-Jetty servers will be added in a future release"
msgstr "غیر Jetty سرورز کے لیے معاونت اگلے ریلیز میں شامل کی جائے گی"

msgid "Return to Tunnel Manager Index"
msgstr "ٹنل مینیجر کے اشخیص پر واپس جائیں"

msgid "Return to Tunnel Editor"
msgstr "ٹنل ایڈیٹر پر واپس جائیں"

msgid "I2P Tunnel Manager - Tunnel Creation Wizard"
msgstr "I2P ٹنل مینیجر - ٹنل بنانے کا ویزارڈ"

msgid "Server or client tunnel?"
msgstr "سرور ٹنل یا کلائنٹ ٹنل؟"

msgid "Tunnel type"
msgstr "ٹنل کی قسم"

msgid "Tunnel name and description"
msgstr "ٹنل کا نام اور تفصیلات"

msgid "Tunnel destination"
msgstr "ٹنل کا مقصد"

msgid "Binding address and port"
msgstr "بائنڈنگ پتہ اور پورٹ"

msgid "Tunnel auto-start"
msgstr "ٹنل کا خودکار شروع ہونا"

msgid "Wizard completed"
msgstr "ویزارڈ مکمل ہو گیا"

msgid "This wizard will take you through the various options available for creating tunnels in I2P."
msgstr "یہ ویزارڈ آپ کو I2P میں ٹنلز بنانے کے لیے دستیاب مختلف آپشنز سے گزارے گا۔"

msgid "The first thing to decide is whether you want to create a server or a client tunnel."
msgstr "سب سے پہلے فیصلہ کرنا یہ ہے کہ آپ سرور ٹنل بنانا چاہتے ہیں یا کلائنٹ ٹنل۔"

msgid "If you need to connect to a remote service, such as an IRC server inside I2P or a code repository, then you will require a CLIENT tunnel."
msgstr "اگر آپ کو کسی ریموٹ سروس، مثلاً I2P کے اندر کے IRC سرور یا کوڈ ریپازٹری سے منسلک ہونے کی ضرورت ہے تو آپ کو ایک CLIENT ٹنل درکار ہوگا۔"

msgid "On the other hand, if you wish to host a service for others to connect to you'll need to create a SERVER tunnel."
msgstr "دوسری طرف، اگر آپ دوسروں کے منسلک ہونے کے لیے کوئی سروس میزبان کرنا چاہتے ہیں تو آپ کو ایک SERVER ٹنل بنانا ہوگا۔"

msgid "Server Tunnel"
msgstr "سرور ٹنل"

msgid "Client Tunnel"
msgstr "کلائنٹ ٹنل"

msgid "There are several types of tunnels to choose from:"
msgstr "انتخاب کے لیے ٹنلز کی کئی اقسام ہیں:"

msgid "Basic tunnel for connecting to a single service inside I2P."
msgstr "I2P کے اندر کسی ایک سروس سے منسلک ہونے کے لیے بنیادی ٹنل۔"

msgid "Try this if none of the tunnel types below fit your requirements, or you don't know what type of tunnel you need."
msgstr "اگر نیچے دیے گئے ٹنل اقسام میں سے کوئی بھی آپ کی ضروریات پوری نہ کرے، یا آپ کو نہیں معلوم کہ آپ کو کس قسم کا ٹنل درکار ہے، تو یہ آزمائیں۔"

msgid "Tunnel that acts as an HTTP proxy for reaching eepsites inside I2P."
msgstr "وہ ٹنل جو I2P کے اندر eepsites تک رسائی کے لیے HTTP پراکسی کے طور پر کام کرتا ہے۔"

msgid "Set your browser to use this tunnel as an http proxy, or set your \"http_proxy\" environment variable for command-line applications in GNU/Linux."
msgstr "اپنا براؤزر اس ٹنل کو http پراکسی کے طور پر استعمال کرنے کے لیے ترتیب دیں، یا GNU/Linux میں کمانڈ لائن ایپلیکیشنز کے لیے اپنا \"http_proxy\" ماحول متغیر مقرر کریں۔"

msgid "Websites outside I2P can also be reached if an HTTP proxy within I2P is known."
msgstr "اگر I2P کے اندر کا کوئی HTTP پراکسی معلوم ہو تو I2P سے باہر کی ویب سائٹس تک بھی رسائی حاصل کی جا سکتی ہے۔"

msgid "Customised client tunnel specific for IRC connections."
msgstr "کسی خاص IRC کنکشنز کے لیے حسبِ ضرورت بنایا گیا کلائنٹ ٹنل۔"

msgid "With this tunnel type, your IRC client will be able to connect to an IRC network inside I2P."
msgstr "اس ٹنل قسم سے آپ کا IRC کلائنٹ I2P کے اندر کے IRC نیٹ ورک سے منسلک ہو سکے گا۔"

msgid "Each IRC network in I2P that you wish to connect to will require its own tunnel. (See Also, SOCKS IRC)"
msgstr "I2P کے اندر ہر IRC نیٹ ورک جس سے آپ منسلک ہونا چاہتے ہیں کے لیے اپنا الگ ٹنل درکار ہوگا۔ (دیکھیں بھی، SOCKS IRC)"

msgid "A tunnel that implements the SOCKS protocol."
msgstr "وہ ٹنل جو SOCKS پروٹوکول نافذ کرتا ہے۔"

msgid "This enables both TCP and UDP connections to be made through a SOCKS outproxy within I2P."
msgstr "یہ I2P کے اندر ایک SOCKS outproxy کے ذریعے TCP اور UDP دونوں کنکشنز بنانے کو ممکن بناتا ہے۔"

msgid "A client tunnel implementing the SOCKS protocol, which is customised for connecting to IRC networks."
msgstr "وہ کلائنٹ ٹنل جو SOCKS پروٹوکول نافذ کرتا ہے، جو IRC نیٹ ورکس سے منسلک ہونے کے لیے حسبِ ضرورت بنایا گیا ہے۔"

msgid "With this tunnel type, IRC networks in I2P can be reached by typing the I2P address into your IRC client, and configuring the IRC client to use this SOCKS tunnel."
msgstr "اس ٹنل قسم سے I2P کے اندر کے IRC نیٹ ورکس تک رسائی ممکن ہے: اپنے IRC کلائنٹ میں I2P پتہ درج کریں اور IRC کلائنٹ کو اس SOCKS ٹنل کو استعمال کرنے کے لیے ترتیب دیں۔"

msgid "This means that only one I2P tunnel is required rather than a separate tunnel per IRC network."
msgstr "اس کا مطلب ہے کہ ہر IRC نیٹ ورک کے لیے الگ ٹنل کے بجائے صرف ایک I2P ٹنل درکار ہے۔"

msgid "IRC networks outside I2P can also be reached if a SOCKS outproxy within I2P is known, though it depends on whether or not the outproxy has been blocked by the IRC network."
msgstr "اگر I2P کے اندر کا کوئی SOCKS outproxy معلوم ہو تو I2P سے باہر کے IRC نیٹ ورکس تک بھی رسائی حاصل کی جا سکتی ہے، حالانکہ اس بات پر منحصر ہے کہ آیا outproxy کو IRC نیٹ ورک نے بلاک کیا ہے یا نہیں۔"

msgid "A basic server tunnel for hosting a generic service inside I2P."
msgstr "I2P کے اندر کوئی عمومی سروس میزبان کرنے کے لیے بنیادی سرور ٹنل۔"

msgid "A server tunnel that is customised for HTTP connections."
msgstr "وہ سرور ٹنل جو HTTP کنکشنز کے لیے حسبِ ضرورت بنایا گیا ہے۔"

msgid "Use this tunnel type if you want to host an eepsite."
msgstr "اگر آپ کوئی eepsite میزبان کرنا چاہتے ہیں تو اس ٹنل قسم کو استعمال کریں۔"

msgid "A customised server tunnel for hosting IRC networks inside I2P."
msgstr "I2P کے اندر IRC نیٹ ورکس میزبان کرنے کے لیے حسبِ ضرورت بنایا گیا سرور ٹنل۔"

msgid "Usually, a separate tunnel needs to be created for each IRC server that is to be accessible inside I2P."
msgstr "عام طور پر، I2P کے اندر رسائی والے ہر IRC سرور کے لیے الگ ٹنل بنانے کی ضرورت ہوتی ہے۔"

msgid "Select tunnel type"
msgstr "ٹنل کی قسم منتخب کریں"

msgid "Choose a name and description for your tunnel."
msgstr "اپنے ٹنل کے لیے نام اور تفصیل منتخب کریں۔"

msgid "These can be anything you want - they are just for ease of identifying the tunnel in the routerconsole."
msgstr "یہ آپ جو کچھ بھی چاہیں ہو سکتے ہیں - یہ صرف routerconsole میں ٹنل کی شناخت آسان بنانے کے لیے ہیں۔"

msgid "If you know of any outproxies for this type of tunnel (either HTTP or SOCKS), fill them in below."
msgstr "اگر آپ کو اس قسم کے ٹنل کے لیے کوئی outproxy معلوم ہو (چاہے HTTP ہو یا SOCKS)، انہیں نیچے درج کریں۔"

msgid "Separate multiple proxies with commas."
msgstr "ایک سے زیادہ پراکسیز کو کوما سے الگ کریں۔"

msgid "List of I2P outproxy destinations, separated with commas (e.g. proxy1.i2p,proxy2.i2p)"
msgstr "I2P outproxy مقاصد کی فہرست، کوما سے الگ (مثلاً proxy1.i2p,proxy2.i2p)"

msgid "Type in the I2P destination of the service that this client tunnel should connect to."
msgstr "اس سروس کا I2P مقصد درج کریں جس سے یہ کلائنٹ ٹنل منسلک ہونا چاہیے۔"

msgid "This could be the full Base64 destination key, or an I2P URL from your address book."
msgstr "یہ مکمل Base64 مقصد کلید ہو سکتی ہے، یا آپ کی پتہ کتاب کا I2P URL۔"

msgid "Enter a b64 or .i2p address here"
msgstr "یہاں b64 یا .i2p پتہ درج کریں"

msgid "This is the IP that your service is running on, this is usually on the same machine so 127.0.0.1 is autofilled."
msgstr "یہ وہ IP ہے جس پر آپ کی سروس چل رہی ہے، جو عام طور پر اسی مشین پر ہوتی ہے لہذا 127.0.0.1 خود بھر دیا جاتا ہے۔"

msgid "This is the port that the service is accepting connections on."
msgstr "یہ وہ پورٹ ہے جس پر سروس کنکشنز قبول کر رہی ہے۔"

msgid "This is the port that the client tunnel will be accessed from locally."
msgstr "یہ وہ پورٹ ہے جس سے کلائنٹ ٹنل تک مقامی طور پر رسائی حاصل کی جائے گی۔"

msgid "How do you want this tunnel to be accessed? By just this machine, your entire subnet, or external internet?"
msgstr "آپ چاہتے ہیں کہ اس ٹنل تک رسائی کیسے حاصل ہو؟ صرف اس مشین سے، اپنے مکمل سبنیٹ سے، یا بیرونی انٹرنیٹ سے؟"

msgid "You will most likely want to just allow 127.0.0.1"
msgstr "آپ اکثر صرف 127.0.0.1 کو اجازت دینا چاہیں گے"

msgid "The I2P router can automatically start this tunnel for you when the router is started."
msgstr "I2P روٹر روٹر شروع ہونے پر یہ ٹنل آپ کے لیے خودکار طور پر شروع کر سکتا ہے۔"

msgid "This can be useful for frequently-used tunnels (especially server tunnels), but for tunnels that are only used occasionally it would mean that the I2P router is creating and maintaining unnecessary tunnels."
msgstr "یہ باقاعدہ استعمال ہونے والے ٹنلز (خاص طور پر سرور ٹنلز) کے لیے مفید ہو سکتا ہے، لیکن صرف وقفے وقفے سے استعمال ہونے والے ٹنلز کے لیے اس کا مطلب ہوگا کہ I2P روٹر غیر ضروری ٹنلز بنا رہا ہے اور اُن کی دیکھ بھال کر رہا ہے۔"

msgid "The wizard has now collected enough information to create your tunnel."
msgstr "ویزارڈ نے اب آپ کا ٹنل بنانے کے لیے کافی معلومات جمع کر لی ہیں۔"

msgid "Upon clicking the Save button below, the wizard will set up the tunnel, and take you back to the main I2PTunnel page."
msgstr "نیچے دیے گئے محفوظ کریں بٹن پر کلک کرنے پر ویزارڈ ٹنل ترتیب دے گا اور آپ کو واپس بنیادی I2PTunnel صفحے پر لے جائے گا۔"

msgid "Because you chose to automatically start the tunnel when the router starts, you don't have to do anything further."
msgstr "کیونکہ آپ نے روٹر شروع ہونے پر ٹنل خودکار طور پر شروع کرنے کا انتخاب کیا ہے، آپ کو مزید کچھ نہیں کرنا۔"

msgid "The router will start the tunnel once it has been set up."
msgstr "ترتیب دے جانے کے بعد روٹر ٹنل شروع کر دے گا۔"

msgid "Because you chose not to automatically start the tunnel, you will have to manually start it."
msgstr "کیونکہ آپ نے ٹنل کو خودکار طور پر شروع نہ کرنے کا انتخاب کیا ہے، آپ کو اسے دستی طور پر شروع کرنا ہوگا۔"

msgid "You can do this by clicking the Start button on the main page which corresponds to the new tunnel."
msgstr "یہ آپ بنیادی صفحے پر موجود شروع کریں بٹن پر کلک کر کے کر سکتے ہیں جو نئے ٹنل سے مطابقت رکھتا ہے۔"

msgid "Below is a summary of the options you chose:"
msgstr "نیچے آپ کے منتخب کردہ آپشنز کا خلاصہ ہے:"

msgid "Tunnel description"
msgstr "ٹنل کی تفصیل"

msgid "Binding address"
msgstr "بائنڈنگ پتہ"

msgid "Tunnel port"
msgstr "ٹنل پورٹ"

msgid "Alongside these basic settings, there are a number of advanced options for tunnel configuration."
msgstr "ان بنیادی ترتیبات کے ساتھ، ٹنل کی ترتیبات کے لیے کئی ایڈوانسڈ آپشنز بھی موجود ہیں۔"

msgid "The wizard will set reasonably sensible default values for these, but you can view and/or edit these by clicking on the tunnel's name in the main I2PTunnel page."
msgstr "ویزارڈ ان کے لیے مناسب طے شدہ قدریں مقرر کرے گا، لیکن آپ بنیادی I2PTunnel صفحے پر ٹنل کے نام پر کلک کر کے انہیں دیکھ اور/یا ترمیم کر سکتے ہیں۔"

msgid "Cancel the wizard and return to Tunnel Manager home page"
msgstr "ویزارڈ منسوخ کریں اور ٹنل مینیجر کے بنیادی صفحے پر واپس جائیں"

msgid "Return to previous page"
msgstr "پچھلے صفحے پر واپس جائیں"

msgid "Previous"
msgstr "پچھلا"

msgid "Save tunnel configuration"
msgstr "ٹنل کی ترتیبات محفوظ کریں"

msgid "Save Tunnel"
msgstr "ٹنل محفوظ کریں"

msgid "Finish Wizard and review tunnel settings"
msgstr "ویزارڈ مکمل کریں اور ٹنل کی ترتیبات دیکھیں"

msgid "Finish"
msgstr "مکمل کریں"

msgid "Advance to next page"
msgstr "اگلے صفحے پر آگے بڑھیں"

msgid "Next"
msgstr "اگلا"
