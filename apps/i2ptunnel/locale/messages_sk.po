msgstr "Autorizácia outproxy"

msgid "Remote Credentials"
msgstr "Vzdialené prihlasovacie údaje"

msgid "Enable if the outproxy a username and password to access"
msgstr "Povoliť ak outproxy vyžaduje používateľské meno a heslo"

msgid "Outproxy requires authorization"
msgstr "Outproxy vyžaduje autorizáciu"

msgid "Enter username required by outproxy"
msgstr "Zadajte používateľské meno vyžadované outproxy"

