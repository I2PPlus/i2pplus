msgid "Reduce tunnel quantity"
msgstr "Znížiť počet tunelov"

msgid ""
"Reduce tunnel count when idle to conserve resources but keep tunnel open (to"
" ensure immediate availability)"
msgstr ""
"Znížiť počet tunelov pri nečinnosti pre šetrenie zdrojov, ale ponechať tunel"
" otvorený (pre okamžitú dostupnosť)"

