msgstr "Outproxy"

msgid "SSL Outproxies"
msgstr "SSL Outproxy"

msgid ""
"Specify the .i2p address or destination (b32 or b64) of the outproxy here."
msgstr "Zadajte .i2p adresu alebo cieľ (b32 alebo b64) outproxy."

msgid ""
"For a random selection from a pool, separate with commas e.g. "
"server1.i2p,server2.i2p"
msgstr ""
"Pre náhodný výber z poolu oddeľte čiarkami, napr. server1.i2p,server2.i2p"

