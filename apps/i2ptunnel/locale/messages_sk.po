"Random startup delay (when auto-start is enabled) to defend against "
"correlation attacks"
msgstr ""
"Náhodné oneskorenie štartu (keď je povolený auto-štart) na obranu proti "
"korelačným útokom"

msgid "Startup Delay"
msgstr "Oneskorenie štartu"

msgid "Minimum"
msgstr "Minimum"

msgid "Minimum startup delay"
msgstr "Minimálne oneskorenie štartu"

msgid "seconds"
msgstr "sekúnd"

msgid "Maximum"
msgstr "Maximum"

