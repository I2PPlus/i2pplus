msgid "This seems to be a bad destination:"
msgstr "Hii inaonekana kuwa lengo batili:"

msgid "i2paddresshelper cannot help you with a destination like that!"
msgstr "i2paddresshelper haiwezi kukusaidia na lengo kama hilo!"

#, java-format
msgid "To visit the destination in your addressbook, click <a href=\"{0}\">here</a>. To visit the conflicting addresshelper destination, click <a href=\"{1}\">here</a>."
msgstr "Kutembelea lengo kilichomo katika kitabu chenu cha anwani, bofya <a href=\"{0}\">hapa</a>. Kutembelea lengo la msaidia wa anwani lenye mgongano, bofya <a href=\"{1}\">hapa</a>."

#, java-format
msgid "Destination for {0} in addressbook"
msgstr "Lengo la {0} katika kitabu cha anwani"

msgid "Conflicting address helper destination"
msgstr "Lengo la msaidia wa anwani lenye mgongano"

msgid "Corrupt Base32 address"
msgstr "Anwani ya Base32 imeharibika"

msgid "Destination LeaseSet not found"
msgstr "LeaseSet ya lengo haijapatikana"

