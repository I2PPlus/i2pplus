msgid "This seems to be a bad destination:"
msgstr "Aquesta sembla ser una destinació incorrecta:"

msgid "i2paddresshelper cannot help you with a destination like that!"
msgstr "i2paddresshelper no us pot ajudar amb una destinació com aquesta!"

#, java-format
msgid "To visit the destination in your addressbook, click <a href=\"{0}\">here</a>. To visit the conflicting addresshelper destination, click <a href=\"{1}\">here</a>."
msgstr "Per visitar la destinació de la vostra llibreta d’adreces, feu clic <a href=\"{0}\">aquí</a>. Per visitar la destinació conflictiva de l’ajudant d’adreces, feu clic <a href=\"{1}\">aquí</a>."

#, java-format
