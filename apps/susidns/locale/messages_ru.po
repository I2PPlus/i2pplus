msgstr "Настройки сохранены."

msgid "Configuration reloaded."
msgstr "Настройки перезагружены."

msgid "New domain"
msgstr "Новый домен"

msgid "Subscription log reloaded."
msgstr "Журнал подписки перезагружен."

