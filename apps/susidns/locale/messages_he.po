msgid ""
"Invalid form submission, probably because you used the \"back\" or "
"\"reload\" button on your browser. Please resubmit."
msgstr ""
"שליחת הטופס אינה תקינה, כנראה משום השתמשת בכפתור \"חזרה\" או \"טען מחדש\" "
"בדפדפן שלך. נא לשלוח שוב."

msgid ""
"If the problem persists, verify that you have cookies enabled in your "
"browser."
msgstr "אם הבעיה נמשכת, ודא שהפעלת cookies בדפדפן שלך."

msgid "Save"
msgstr "שמור"

