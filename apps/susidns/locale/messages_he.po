msgstr[1] "דולגו {0} רשומות כפולות מהקובץ"

msgid "Import from file failed"
msgstr "ייבוא מקובץ נכשל"

msgid "Subscriptions saved."
msgstr "המינויים נשמרו."

msgid "Update"
msgstr "עדכון"

msgid "Attempting to update addressbook from subscription sources..."
msgstr "מנסה לעדכן את פנקס הכתובות ממקורות המינויים..."

msgid "Cannot update subscriptions: HTTP proxy is not running!"
msgstr "לא ניתן לעדכן את המינויים: פרוקסי HTTP אינו פועל!"

msgid "Subscriptions reloaded."
msgstr "המינויים נטענו מחדש."

msgid ""
"If SusiDNS is configured to publish your Router address book, the entries "
"will appear in your Published address book and saved to a hosts.txt file for"
" sharing."
msgstr ""
"אם SusiDNS מוגדר לפרסם את פנקס הכתובות של הנתב, הרשומות יופיעו בפנקס הכתובות"
" המפורסם שלך ויישמרו בקובץ hosts.txt לשיתוף."

msgid "Published Addressbook"
msgstr "פנקס כתובות מפורסם"

msgid ""
"To configure SusiDNS to push your Router address book to your Published "
"address book, set 'should_publish=true' on the configuration page."
msgstr ""
"כדי להגדיר את SusiDNS לדחוף את פנקס הכתובות של הנתב אל פנקס הכתובות המפורסם "
"שלך, הגדר 'should_publish=true' בדף ההגדרות."

msgid ""
"All hosts derived from subscriptions will appear in this address book, in "
"addition to any you manually add here or to your Master address book."
msgstr ""
"כל המחשבים המארחים הנגזרים מהמינויים יופיעו בפנקס הכתובות הזה, בנוסף לאלה "
"שתוסיף ידנית כאן או לפנקס הכתובות הראשי שלך."

msgid "Router Addressbook"
msgstr "פנקס כתובות של הנתב"

msgid ""
"Hosts you manually add here will never be published. You can also add "
"aliases to hosts in other address books here."
msgstr ""
"מחשבים מארחים שתוסיף כאן ידנית לא יתפרסמו לעולם. ניתן גם להוסיף כאן כינויים "
"למחשבים מארחים בפנקסי כתובות אחרים."

msgid "Private Addressbook"
msgstr "פנקס כתובות פרטי"

msgid "Local Records"
msgstr "רשומות מקומיות"

msgid ""
"I2P applications (including the HTTP proxy) use the hosts in your local "
"address books to resolve .i2p hostnames."
msgstr ""
"יישומי I2P (כולל פרוקסי HTTP) משתמשים במחשבים המארחים שבפנקסי הכתובות "
"המקומיים שלך כדי לפתור שמות מחשב של .i2p."

msgid ""
"Additional subscriptions can be found in the FAQ section of the Router help "
"page."
msgstr "מינויים נוספים ניתן למצוא במקטע השאלות הנפוצות בדף העזרה של הנתב."

msgid "Subscriptions"
msgstr "מינויים"

msgid ""
"Hosts sourced from your subscriptions are added to your Router address book,"
" and are automatically synced (by default every 12 hours)."
msgstr ""
"מחשבים מארחים המתקבלים מהמינויים שלך נוספים לפנקס הכתובות של הנתב, "
"ומסונכרנים אוטומטית (כל 12 שעות כברירת מחדל)."

msgid "Configure Subscriptions"
msgstr "הגדר מינויים"

msgid ""
"If you manually add hosts here, they will be included your Published address"
" book (if configured)."
msgstr ""
"אם תוסיף כאן מחשבים מארחים ידנית, הם ייכללו בפנקס הכתובות המפורסם שלך (אם "
"מוגדר)."

msgid "Master Addressbook"
msgstr "פנקס כתובות ראשי"

msgid "Searchable by"
msgstr "ניתן לחיפוש לפי"

msgid "I2P applications"
msgstr "יישומי I2P"

msgid ""
"The Master, Router and Private address books collectively serve as the DNS "
"authority for I2P applications."
msgstr ""
"פנקסי הכתובות הראשי, של הנתב והפרטי משמשים יחד כרשות ה-DNS עבור יישומי I2P."

msgid "Optional,"
msgstr "אופציונלי,"

msgid "for websites"
msgstr "לאתרי אינטרנט"

msgid ""
"If you configure SusiDNS to publish your Router address book, it will export"
" a hosts.txt file containing all the hosts (by default to the root of your "
"eepsite)."
msgstr ""
"אם תגדיר את SusiDNS לפרסם את פנקס הכתובות של הנתב, הוא יייצא קובץ hosts.txt "
"המכיל את כל המחשבים המארחים (כברירת מחדש לשורש ה-eepsite שלך)."

msgid ""
"Addresses manually added to your Master address book will merge with your "
"Router address book."
msgstr ""
"כתובות שנוספו ידנית לפנקס הכתובות הראשי שלך יתמזגו עם פנקס הכתובות של הנתב."

msgid ""
"Hosts you receive from your subscriptions will merge with your Router "
"address book."
msgstr "מחשבים מארחים שאתה מקבל מהמינויים שלך יתמזגו עם פנקס הכתובות של הנתב."

