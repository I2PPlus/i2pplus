msgid "Enter I2P addresses to blacklist (one per line)"
msgstr "Εισάγετε διευθύνσεις I2P για τη μαύρη λίστα (μία ανά γραμμή)"

msgid "The blacklist file contains a list of I2P hostnames that should be blocked from access via the HTTP proxy, and excluded from the address book display."
msgstr "Το αρχείο της μαύρης λίστας περιέχει μια λίστα ονομάτων κεντρικών υπολογιστών I2P που πρέπει να αποκλειστούν από την πρόσβαση μέσω του διακομιστή μεσολάβησης HTTP και να εξαιρούνται από την εμφάνιση στο βιβλίο διευθύνσεων."

msgid "configuration"
msgstr "ρυθμίσεις"

msgid "HostChecker is already running a scan"
msgstr "Το HostChecker εκτελεί ήδη σάρωση"

msgid "Run HostChecker"
msgstr "Εκτέλεση HostChecker"

msgid "Hints"
msgstr "Συμβουλές"

msgid "File and directory paths here are relative to the addressbook's working directory, which is normally ~/.i2p/addressbook/ (Linux) or %LOCALAPPDATA%\\I2P\\addressbook\\ (Windows)."
msgstr "Οι διαδρομές αρχείων και καταλόγων εδώ είναι σχετικές με τον κατάλογο εργασίας του βιβλίου διευθύνσεων, ο οποίος συνήθως είναι ~/.i2p/addressbook/ (Linux) ή %LOCALAPPDATA%\\I2P\\addressbook\\ (Windows)."

msgid "If you want to manually add lines to an addressbook, add them to the private or master addressbooks."
msgstr "Αν θέλετε να προσθέσετε γραμμές χειροκίνητα σε ένα βιβλίο διευθύνσεων, προσθέστε τες στο ιδιωτικό ή στο κύριο βιβλίο διευθύνσεων."

msgid "The router addressbook and the published addressbook are updated by the addressbook application."
msgstr "Το βιβλίο διευθύνσεων του δρομολογητή και το δημοσιευμένο βιβλίο διευθύνσεων ενημερώνονται από την εφαρμογή βιβλίου διευθύνσεων."

msgid "When you publish your addressbook, ALL destinations from the master and router addressbooks appear there."
msgstr "Όταν δημοσιεύετε το βιβλίο διευθύνσεών σας, εμφανίζονται εκεί ΟΛΟΙ οι προορισμοί από το κύριο και από το βιβλίο διευθύνσεων του δρομολογητή."

msgid "Use the private addressbook for private destinations, these are not published."
msgstr "Χρησιμοποιήστε το ιδιωτικό βιβλίο διευθύνσεων για ιδιωτικούς προορισμούς, αυτοί δεν δημοσιεύονται."

msgid "Options"
msgstr "Επιλογές"

msgid "File containing the list of subscriptions URLs (no need to change)"
msgstr "Αρχείο με τη λίστα των URL συνδρομών (δεν χρειάζεται αλλαγή)"

msgid "Update interval in hours"
msgstr "Διάστημα ενημέρωσης σε ώρες"

msgid "Your public hosts.txt file (choose a path within your webserver document root)"
msgstr "Το δημόσιο αρχείο hosts.txt σας (επιλέξτε μια διαδρομή μέσα στον ριζικό φάκελο του διακομιστή σας)"

msgid "Your hosts.txt (don't change)"
msgstr "Το hosts.txt σας (μην το αλλάξετε)"

msgid "Your personal addressbook, these hosts will be published"
msgstr "Το κύριο βιβλίο διευθύνσεών σας, αυτοί οι κεντρικοί υπολογιστές θα δημοσιευτούν"

msgid "Your private addressbook, it is never published"
msgstr "Το ιδιωτικό βιβλίο διευθύνσεών σας, δεν δημοσιεύεται ποτέ"

msgid "Port for your eepProxy (no need to change)"
msgstr "Θύρα για το eepProxy σας (δεν χρειάζεται αλλαγή)"

msgid "Hostname for your eepProxy (no need to change)"
msgstr "Όνομα κεντρικού υπολογιστή για το eepProxy σας (δεν χρειάζεται αλλαγή)"

msgid "Whether to update the published addressbook"
msgstr "Αν γίνεται ενημέρωση του δημοσιευμένου βιβλίου διευθύνσεων"

msgid "File containing the etags header from the fetched subscription URLs (no need to change)"
msgstr "Αρχείο με την κεφαλίδα etags από τα URL συνδρομών που ανακτήθηκαν (δεν χρειάζεται αλλαγή)"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "Αρχείο με τη χρονική σήμανση τροποποίησης για κάθε URL συνδρομής που ανακτήθηκε (δεν χρειάζεται αλλαγή)"

msgid "File to log activity to (change to /dev/null if you like)"
