msgid "Hints"
msgstr "اشارے"

msgid "File and directory paths here are relative to the addressbook's working directory, which is normally ~/.i2p/addressbook/ (Linux) or %LOCALAPPDATA%\\I2P\\addressbook\\ (Windows)."
msgstr "یہاں دیے گئے فائل اور ڈائریکٹری راستے پتہ کتاب کے کام کی ڈائریکٹری کے لحاظ سے نسبی ہیں، جو عام طور پر ~/.i2p/addressbook/ (Linux) یا %LOCALAPPDATA%\\I2P\\addressbook\\ (Windows) ہوتی ہے۔"

msgid "If you want to manually add lines to an addressbook, add them to the private or master addressbooks."
msgstr "اگر آپ کسی پتہ کتاب میں سطریں دستی طور پر شامل کرنا چاہتے ہیں تو انہیں نجی یا ماسٹر پتہ کتابوں میں شامل کریں۔"

msgid "The router addressbook and the published addressbook are updated by the addressbook application."
msgstr "روٹر پتہ کتاب اور شائع شدہ پتہ کتاب پتہ کتاب ایپلیکیشن کے ذریعے اپ ڈیٹ ہوتی ہیں۔"

msgid "When you publish your addressbook, ALL destinations from the master and router addressbooks appear there."
msgstr "جب آپ اپنی پتہ کتاب شائع کرتے ہیں تو ماسٹر اور روٹر پتہ کتابوں کے تمام مقاصد وہاں نظر آتے ہیں۔"

msgid "Use the private addressbook for private destinations, these are not published."
msgstr "نجی مقاصد کے لیے نجی پتہ کتاب استعمال کریں، یہ شائع نہیں کی جاتیں۔"

msgid "Options"
msgstr "آپشنز"

msgid "File containing the list of subscriptions URLs (no need to change)"
msgstr "سبسکرپشن URL کی فہرست پر مشتمل فائل (تبدیل کرنے کی ضرورت نہیں)"

msgid "Update interval in hours"
msgstr "اپ ڈیٹ کا وقفہ گھنٹوں میں"

msgid "Your public hosts.txt file (choose a path within your webserver document root)"
msgstr "آپ کی عوامی hosts.txt فائل (اپنی ویب سرور دستاویزی جڑ کے اندر کا راستہ منتخب کریں)"

msgid "Your hosts.txt (don't change)"
msgstr "آپ کی hosts.txt (تبدیل نہ کریں)"

msgid "Your personal addressbook, these hosts will be published"
msgstr "آپ کی ذاتی پتہ کتاب، یہ میزبان شائع کیے جائیں گے"

msgid "Your private addressbook, it is never published"
msgstr "آپ کی نجی پتہ کتاب، یہ کبھی شائع نہیں کی جاتی"

msgid "Port for your eepProxy (no need to change)"
msgstr "آپ کے eepProxy کا پورٹ (تبدیل کرنے کی ضرورت نہیں)"

msgid "Hostname for your eepProxy (no need to change)"
msgstr "آپ کے eepProxy کا ہوسٹ نیم (تبدیل کرنے کی ضرورت نہیں)"

msgid "Whether to update the published addressbook"
msgstr "شائع شدہ پتہ کتاب اپ ڈیٹ کرنے کی فرماندگی"

msgid "File containing the etags header from the fetched subscription URLs (no need to change)"
msgstr "حاصل کردہ سبسکرپشن URL کے etags ہیڈر پر مشتمل فائل (تبدیل کرنے کی ضرورت نہیں)"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "ہر حاصل کردہ سبسکرپشن URL کے لیے تبدیلی کے ٹائم اسٹیمپ پر مشتمل فائل (تبدیل کرنے کی ضرورت نہیں)"

msgid "File to log activity to (change to /dev/null if you like)"
msgstr "سرگرمی لاگ کرنے کے لیے فائل (چاہیں تو /dev/null میں تبدیل کر دیں)"

msgid "Name of override theme to use (defaults to console-selected theme)"
msgstr "استعمال کرنے کے لیے اوور رائیڈ تھیم کا نام (طے شدہ طور پر کنسول میں منتخب کردہ تھیم)"

msgid "Interval (in hours) for running host checker (default is 4 hours)"
msgstr "ہوسٹ چیکر چلانے کا وقفہ (گھنٹوں میں) (طے شدہ 4 گھنٹے ہے)"

msgid "Maximum concurrent pings when running host checker (Default is 16, max is 160)"
msgstr "ہوسٹ چیکر چلاتے وقت زیادہ سے زیادہ بیک وقت پنگز (طے شدہ 16 ہے، زیادہ سے زیادہ 160)"

