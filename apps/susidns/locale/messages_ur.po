msgid "Update"
msgstr "اپ ڈیٹ کریں"

msgid "Attempting to update addressbook from subscription sources..."
msgstr "سبسکرپشن ماخذوں سے پتہ کتاب اپ ڈیٹ کرنے کی کوشش جاری ہے…"

msgid "Cannot update subscriptions: HTTP proxy is not running!"
msgstr "سبسکرپشنز اپ ڈیٹ نہیں ہو سکتیں: HTTP پراکسی چل نہیں رہی!"

msgid "Subscriptions reloaded."
msgstr "سبسکرپشنز دوبارہ لوڈ ہو گئیں۔"

msgid "If SusiDNS is configured to publish your Router address book, the entries will appear in your Published address book and saved to a hosts.txt file for sharing."
msgstr "اگر SusiDNS کو آپ کی روٹر پتہ کتاب شائع کرنے کے لیے ترتیب دیا گیا ہو تو اندراجات آپ کی شائع شدہ پتہ کتاب میں نظر آئیں گے اور شیئر کرنے کے لیے ایک hosts.txt فائل میں محفوظ ہوں گے۔"

msgid "Published Addressbook"
msgstr "شائع شدہ پتہ کتاب"

msgid "To configure SusiDNS to push your Router address book to your Published address book, set 'should_publish=true' on the configuration page."
msgstr "اپنی روٹر پتہ کتاب اپنی شائع شدہ پتہ کتاب میں بھیجنے کے لیے SusiDNS کو ترتیب دینے کے لیے ترتیبات صفحے پر 'should_publish=true' مقرر کریں۔"

msgid "All hosts derived from subscriptions will appear in this address book, in addition to any you manually add here or to your Master address book."
msgstr "سبسکرپشنز سے حاصل ہونے والے تمام میزبان اس پتہ کتاب میں نظر آئیں گے، نیز وہ بھی جو آپ یہاں یا اپنی ماسٹر پتہ کتاب میں دستی طور پر شامل کرتے ہیں۔"

msgid "Router Addressbook"
msgstr "روٹر پتہ کتاب"

msgid "Hosts you manually add here will never be published. You can also add aliases to hosts in other address books here."
msgstr "یہاں دستی طور پر شامل کیے گئے میزبان کبھی شائع نہیں کیے جائیں گے۔ آپ یہاں دوسری پتہ کتابوں کے میزبانوں کے لیے بھی ایلیاس شامل کر سکتے ہیں۔"

msgid "Private Addressbook"
msgstr "نجی پتہ کتاب"

msgid "Local Records"
msgstr "مقامی ریکارڈ"

msgid "I2P applications (including the HTTP proxy) use the hosts in your local address books to resolve .i2p hostnames."
msgstr "I2P ایپلیکیشنز (جن میں HTTP پراکسی بھی شامل ہے) آپ کی مقامی پتہ کتابوں کے میزبانوں کو استعمال کر کے .i2p ہوسٹ نیم حل کرتی ہیں۔"

msgid "Additional subscriptions can be found in the FAQ section of the Router help page."
msgstr "مزید سبسکرپشنز روٹر مدد صفحے کے FAQ حصے میں مل سکتی ہیں۔"

msgid "Subscriptions"
msgstr "سبسکرپشنز"

msgid "Hosts sourced from your subscriptions are added to your Router address book, and are automatically synced (by default every 12 hours)."
msgstr "آپ کی سبسکرپشنز سے حاصل ہونے والے میزبان آپ کی روٹر پتہ کتاب میں شامل ہوتے ہیں اور خودکار طور پر مطابقت پیدا کیے جاتے ہیں (طے شدہ طور پر ہر 12 گھنٹے)۔"

msgid "Configure Subscriptions"
msgstr "سبسکرپشنز ترتیب دیں"

msgid "If you manually add hosts here, they will be included your Published address book (if configured)."
msgstr "اگر آپ یہاں دستی طور پر میزبان شامل کریں تو وہ آپ کی شائع شدہ پتہ کتاب (اگر ترتیب دی گئی ہو) میں شامل ہوں گے۔"

msgid "Master Addressbook"
msgstr "ماسٹر پتہ کتاب"

msgid "Searchable by"
msgstr "تلاش کا ذریعہ"

msgid "I2P applications"
msgstr "I2P ایپلیکیشنز"

msgid "The Master, Router and Private address books collectively serve as the DNS authority for I2P applications."
msgstr "ماسٹر، روٹر اور نجی پتہ کتابیں مل کر I2P ایپلیکیشنز کے لیے DNS اتھارٹی کا کام کرتی ہیں۔"

msgid "Optional,"
msgstr "اختیاری،"

msgid "for websites"
msgstr "ویب سائٹس کے لیے"

msgid "If you configure SusiDNS to publish your Router address book, it will export a hosts.txt file containing all the hosts (by default to the root of your eepsite)."
msgstr "اگر آپ SusiDNS کو اپنی روٹر پتہ کتاب شائع کرنے کے لیے ترتیب دیں تو یہ تمام میزبانوں پر مشتمل hosts.txt فائل برآمد کرے گا (طے شدہ طور پر آپ کے eepsite کی جڑ پر)۔"

msgid "Addresses manually added to your Master address book will merge with your Router address book."
msgstr "آپ کی ماسٹر پتہ کتاب میں دستی طور پر شامل کیے گئے پتے آپ کی روٹر پتہ کتاب میں ضم ہو جائیں گے۔"

msgid "Hosts you receive from your subscriptions will merge with your Router address book."
msgstr "آپ کی سبسکرپشنز سے موصول ہونے والے میزبان آپ کی روٹر پتہ کتاب میں ضم ہو جائیں گے۔"

