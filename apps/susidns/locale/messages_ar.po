msgstr "إرشادات"

msgid "File and directory paths here are relative to the addressbook's working directory, which is normally ~/.i2p/addressbook/ (Linux) or %LOCALAPPDATA%\\I2P\\addressbook\\ (Windows)."
msgstr "مسارات الملفات والمجلدات هنا نسبية إلى مجلد عمل دفتر العناوين، وهو عادةً ~/.i2p/addressbook/ (لينكس) أو %LOCALAPPDATA%\\I2P\\addressbook\\ (ويندوز)."

msgid "If you want to manually add lines to an addressbook, add them to the private or master addressbooks."
msgstr "إذا أردت إضافة أسطر يدويًا إلى دفتر عناوين، فأضفها إلى دفتر العناوين الخاص أو دفتر العناوين الرئيسي."

msgid "The router addressbook and the published addressbook are updated by the addressbook application."
msgstr "يتم تحديث دفتر عناوين جهاز التوجيه ودفتر العناوين المنشور بواسطة تطبيق دفتر العناوين."

msgid "When you publish your addressbook, ALL destinations from the master and router addressbooks appear there."
msgstr "عند نشر دفتر العناوين الخاص بك، تظهر فيه جميع الوجهات من دفتر العناوين الرئيسي ودفتر عناوين جهاز التوجيه."

msgid "Use the private addressbook for private destinations, these are not published."
msgstr "استخدم دفتر العناوين الخاص للوجهات الخاصة، فهي لا تُنشر."

msgid "Options"
msgstr "الخيارات"

msgid "File containing the list of subscriptions URLs (no need to change)"
msgstr "الملف الذي يحتوي على قائمة عناوين URL للاشتراكات (لا حاجة لتغييره)"

msgid "Update interval in hours"
msgstr "فترة التحديث بالساعات"

msgid "Your public hosts.txt file (choose a path within your webserver document root)"
msgstr "ملف hosts.txt العام الخاص بك (اختر مسارًا داخل جذر مستندات خادم الويب)"

msgid "Your hosts.txt (don't change)"
msgstr "ملف hosts.txt الخاص بك (لا تغيّره)"

msgid "Your personal addressbook, these hosts will be published"
msgstr "دفتر العناوين الشخصي الخاص بك، ستُنشر هذه المضيفات"

msgid "Your private addressbook, it is never published"
msgstr "دفتر العناوين الخاص بك، لا يُنشر أبدًا"

msgid "Port for your eepProxy (no need to change)"
msgstr "المنفذ الخاص بـ eepProxy (لا حاجة لتغييره)"

msgid "Hostname for your eepProxy (no need to change)"
msgstr "اسم المضيف الخاص بـ eepProxy (لا حاجة لتغييره)"

msgid "Whether to update the published addressbook"
msgstr "ما إذا كان دفتر العناوين المنشور سيُحدَّث"

msgid "File containing the etags header from the fetched subscription URLs (no need to change)"
msgstr "الملف الذي يحتوي على ترويسة etags من عناوين URL للاشتراكات المجلوبة (لا حاجة لتغييره)"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "الملف الذي يحتوي على الطابع الزمني للتعديل لكل عنوان URL اشتراك مجلوب (لا حاجة لتغييره)"

msgid "File to log activity to (change to /dev/null if you like)"
