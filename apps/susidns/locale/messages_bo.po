msgstr "ཁྱོད་ཀྱི་ eepProxy གི་སྒོ་ཁོན (འགོག་དགོས་མེད།)"

msgid "Hostname for your eepProxy (no need to change)"
msgstr "ཁྱོད་ཀྱི་ eepProxy གི་གཟིགས་མིང (འགོག་དགོས་མེད།)"

msgid "Whether to update the published addressbook"
msgstr "བཀོད་པའི་ཡིག་ཆ་བང་བསྐྱར་བཏང་དགོས་ཡིན་དང་མིན།"

msgid "File containing the etags header from the fetched subscription URLs (no need to change)"
msgstr "ལེན་ཐོག་བྱས་པའི་འབྲེལ་ཡོད་པའི་དྲ་གྲོའི་ཐོ་གཞུང་ནས་ etags སྟེངས་འབྲེལ་དང་བཅས་པའི་ཡིག་ཆ (འགོག་དགོས་མེད།)"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "ལེན་ཐོག་བྱས་པའི་འབྲེལ་ཡོད་པའི་དྲ་གྲོ་རེ་བའི་མཇུག་སྲོག་དུས་དང་བཅས་པའི་ཡིག་ཆ (འགོག་དགོས་མེད།)"

msgid "File to log activity to (change to /dev/null if you like)"
msgstr "ཉིན་ཐོག་བཟོས་པའི་ཡིག་ཆ (དགའ་བ་ཡོད་ན་/dev/null ར་བརྗེ་བའི་ཐུབ།)"

msgid "Name of override theme to use (defaults to console-selected theme)"
msgstr "འདེབས་བའི་རྣམ་གྲང་གི་མཚན་མིང (ལས་སུ་འཁོར་བའི་རྣམ་གྲང་ལ་སྤོས།)"

msgid "Interval (in hours) for running host checker (default is 4 hours)"
msgstr "གྲངས་ཀྱིས་ལྟ་ཚང་བཀོལ་པའི་ཚད་འཛིན (ཆུ་ཚོད་གྱིས། གདོག་པ་ནི་ 4 ཆུ་ཚོད།)"

msgid "Maximum concurrent pings when running host checker (Default is 16, max is 160)"
msgstr "གྲངས་ཀྱིས་ལྟ་ཚང་བཀོལ་སྐབས་ཀྱི་མཉམ་འགྲོའི་ ping གང་ཤོས (གདོག་པ་ 16, མང་ཤོས 160)"

msgid "delete hosts"
msgstr "གཟིགས་མིང་སོར་ཆུབ་པ།"

msgid "addressbook"
msgstr "ཡིག་ཆ་བང"

msgid "Details"
msgstr "ཞིབ་བཤེར།"

msgid "Address Helper"
msgstr "གཟིགས་མིང་གི་རོགས་པ།"

msgid "link"
msgstr "འབྲེལ་མཚོག"

msgid "Encoded Name"
msgstr "བཀག་བསྡུས་མིང།"

msgid "Base 32 Address"
msgstr "32 གཞི་གྲངས་ཀྱི་གཟིགས་མིང།"

msgid "Base 64 Hash"
msgstr "64 གཞི་གྲངས་ཀྱི་བརྒྱ་བསྡུས།"

msgid "Public Key"
msgstr "སྤྱི་གཟིགས་གསང་ལྡན།"

msgid "Signing Key"
msgstr "བརྐྱ་མཚོགས་གསང་ལྡན།"

msgid "Certificate"
msgstr "དཔང་རྟེན།"

msgid "Validated"
msgstr "རྟོགས་འཇུག་བྱས་པ།"

msgid "no"
msgstr "མིན"

msgid "yes"
msgstr "ཡིན"

msgid "Added Date"
msgstr "སྣོན་པའི་དུས།"

msgid "Last Modified"
msgstr "མཇུག་སྲོག།"

msgid "Notes"
msgstr "ཐོ་ཡིག།"

msgid "Add notes about domain"
msgstr "གཞི་གྲངས་ཀྱི་ཐོ་ཡིག་བཅུག"

msgid "Visual Identification for"
msgstr "མཐོང་རྟགས་འབྱེད་པ།"

msgid "Create your own identification images"
msgstr "ངང་རང་གི་མཐོང་རྟགས་དང་བྱེད་པ།"

msgid "Launch Image Generator"
msgstr "མཚོན་པ་བཅོས་སྐྱེད་འཇུག"

msgid "Introduction"
msgstr "འཕྲོད་སྐར།"

msgid "What is the addressbook?"
msgstr "ཡིག་ཆ་བང་ཞེས་གང་ཟབ་བྱེད།"

msgid "The addressbook application is part of your I2P installation."
msgstr "ཡིག་ཆ་བང་ལྟའི་རིགས་ཀྱིས་ཁྱོད་ཀྱི་ I2P ནང་འཇུག་གི་ཆ་ཤས་ཞིག་ཡིན།"

msgid "It regularly updates your hosts.txt file from distributed sources or \"subscriptions\"."
msgstr "ཁྱོད་ཀྱི་ hosts.txt ཡིག་ཆ་ནི་ཡོད་གཞིའི་རིགས་དང་\"འབྲེལ་ཡོད་པ\" ནས་བརྟན་ཐུབ་རྔུས་འགྱུར་བའི་སྐྱེད་ཀྱིས་བསྐྱར་བཏང་བ།"

msgid "Subscribing to additional sites is easy, just add them to your <a href=\"subscriptions\">subscriptions</a> file."
msgstr "དྲ་གྲོའི་གཟིགས་མིང་གཞན་དག་ལ་འབྲེལ་ཡོད་པ་བྱེད་ཐབས་གཅིག་མེད། དེ་དག <a href=\"subscriptions\">འབྲེལ་ཡོད་པ</a> ཡིག་ཆར་ཁེར་འཇུག་ནས་གཅིག"

msgid "For more information on naming in I2P, see <a href=\"http://i2p-projekt.i2p/naming.html\" target=_blank>the overview</a>."
msgstr "I2P ནང་གི་མིང་བརྒྱུད་སྟབས་ཀྱི་ཞིབ་བཤེར་དོན་ལ་ <a href=\"http://i2p-projekt.i2p/naming.html\" target=_blank>ཐོག་མཚོན</a> ལ་ལྟ།"

msgid "How does the addressbook application work?"
msgstr "ཡིག་ཆ་བང་ལྟའི་རིགས་ཀྱིས་ཇི་ལྟར་སྒྲུབ་གནས།"

msgid "The addressbook application regularly polls your subscriptions and merges their content into your \"router\" address book."
msgstr "བརྟན་ཐུབ་རྔུས་འགྱུར་བའི་སྐྱེད་ཀྱིས་ཁྱོད་ཀྱི་འབྲེལ་ཡོད་པ་ལྟོགས་ཏུ་དཔྱད་དུ་བལྟས་ཏེ་དེའི་ནང་དོན་\"གཞི་གྲངས\"གྱི་ཡིག་ཆ་བང་ལ་མཉམ་དུ་སྣོན་པ།"

msgid "Then it merges your \"master\" address book into the router address book as well."
msgstr "དེ་ནས་\"གཙོ་བོ\"གྱི་ཡིག་ཆ་བང་ཀྱང་གཞི་གྲངས་གྱི་ཡིག་ཆ་བང་དུ་མཉམ་དུ་བསྣོན་པ།"

msgid "If configured, the router address book is now written to the \"published\" address book, which will be publicly available if you are running an eepsite."
msgstr "སྒྲིག་འཇུག་བྱས་ན་གཞི་གྲངས་གྱི་ཡིག་ཆ་བང་ནི \"བཀོད་པ\"གྱི་ཡིག་ཆ་བང་ལ་དེ་ནས་འདེཇོག་འགྲོ། ངང་གིས་དྲ་གྲོའི་གཟིགས་མིང་འཁོར་བཞག་ན་དེ་སྤྱི་གིས་འདེབས་ཐུབ་ངང་།"

msgid "The router also uses a private address book, which is not merged or published."
msgstr "གཞི་གྲངས་ཀྱིས་གསང་བའི་ཡིག་ཆ་བང་ཀྱང་བེད་སྤྱོད་བྱེད་ཡོད། དེའི་ནང་དོན་མཉམ་དུ་བསྣོན་མི་ནུས་པས་བཀོད་པའང་མི་ནུས།"

msgid "Hosts in the private address book can be accessed by you but their addresses are never distributed to others."
msgstr "གསང་བའི་ཡིག་ཆ་བང་ནང་གི་གཟིགས་མིང་ལ་ངང་གིས་ལྟོགས་ཐུབ་ཀྱང་། འོན་ཀྱང་དེ་དག་གི་གཟིགས་མིང་གཞན་ལ་བརྒྱུད་པར་གྲགས་མེད།"

msgid "The private address book can also be used for aliases of hosts in your other address books."
msgstr "གསང་བའི་ཡིག་ཆ་བང་ནས་ཁྱོད་ཀྱི་ཡིག་ཆ་བང་གཞན་དག་ནང་གི་གཟིགས་མིང་གྲགས་པའི་གྲོག་མཚན་ལ་ཀྱང་སྣང་བ་ཡིན།"

msgid "subscription log"
msgstr "འབྲེལ་ཡོད་པའི་ཐོ་གཞུང"

msgid "Subscription Log"
msgstr "འབྲེལ་ཡོད་པའི་ཐོ་གཞུང།"

msgid "Most recent (excluding bad domains)"
msgstr "གཙང་མ་ཤིག (ཁྲགས་མི་ཆགས་པའི་གཞི་གྲངས་མེད་པར་བྱས་པ)"

msgid "subscriptions"
msgstr "འབྲེལ་ཡོད་པ"

msgid "The subscription file contains a list of i2p URLs."
msgstr "འབྲེལ་ཡོད་པའི་ཡིག་ཆ་ནང་ནི i2p དྲ་གྲོའི་ཐོ་གཞུང་ཞིག་བཞག་ཡོད།"

msgid "The addressbook application regularly checks this list for new eepsites."
msgstr "ཡིག་ཆ་བང་ལྟའི་རིགས་ཀྱིས་བརྟན་ཐུབ་རྔུས་འགྱུར་བའི་སྐྱེད་ཀྱིས་འདིར་དྲ་གྲོའི་གཟིགས་མིང་གསར་པ་ཡོད་མེད་ལྟོགས་ཏུ་བལྟས།"

msgid "Those URLs refer to published hosts.txt files."
msgstr "དེ་དག་ནི་བཀོད་པའི་ hosts.txt ཡིག་ཆ་དག་ལ་འདོད་པའི་དྲ་གྲོ་ཡིན།"

msgid "See the FAQ for a list of subscription URLs."
msgstr "འབྲེལ་ཡོད་པའི་དྲ་གྲོའི་ཐོ་གཞུང་ཞིག་མཐོང་བར་ FAQ ལ་ལྟ།"
