msgstr "Nie je možné aktualizovať odbery: HTTP proxy nebeží!"

msgid "Subscriptions reloaded."
msgstr "Odbery obnovené."

msgid "If SusiDNS is configured to publish your Router address book, the entries will appear in your Published address book and saved to a hosts.txt file for sharing."
msgstr "Ak je SusiDNS nakonfigurovaný na publikovanie adresára smerovača, záznamy sa objavia v publikovanom adresári a uložia do hosts.txt súboru na zdieľanie."

msgid "Published Addressbook"
msgstr "Publikovaný adresár"

msgid "To configure SusiDNS to push your Router address book to your Published address book, set 'should_publish=true' on the configuration page."
msgstr "Pre konfiguráciu SusiDNS na prenos adresára smerovača do publikovaného adresára nastavte 'should_publish=true' na konfiguračnej stránke."

msgid "All hosts derived from subscriptions will appear in this address book, in addition to any you manually add here or to your Master address book."
msgstr "Všetky hostitele z odberov sa zobrazia v tomto adresári, okrem tých, ktoré sem ručne pridáte alebo do hlavného adresára."

msgid "Router Addressbook"
msgstr "Adresár smerovača"

msgid "Hosts you manually add here will never be published. You can also add aliases to hosts in other address books here."
msgstr "Hostitelia, ktorých sem ručne pridáte, nebudú nikdy publikovaní. Môžete tiež pridať aliasy hostiteľov z iných adresárov."

msgid "Private Addressbook"
msgstr "Súkromný adresár"

msgid "Local Records"
msgstr "Miestne záznamy"

msgid "I2P applications (including the HTTP proxy) use the hosts in your local address books to resolve .i2p hostnames."
msgstr "I2P aplikácie (vrátane HTTP proxy) používajú hostiteľov z miestnych adresárov na rozlíšenie .i2p názvov hostiteľov."

msgid "Additional subscriptions can be found in the FAQ section of the Router help page."
msgstr "Ďalšie odbery nájdete v sekcii FAQ na stránke pomocníka smerovača."

msgid "Subscriptions"
msgstr "Odbery"

msgid "Hosts sourced from your subscriptions are added to your Router address book, and are automatically synced (by default every 12 hours)."
msgstr "Hostitelia z vašich odberov sú pridaní do adresára smerovača a automaticky synchronizovaní (štandardne každých 12 hodín)."

msgid "Configure Subscriptions"
msgstr "Nastaviť odbery"

msgid "If you manually add hosts here, they will be included your Published address book (if configured)."
msgstr "Ak sem ručne pridáte hostiteľov, budú zahrnutí do publikovaného adresára (ak je nakonfigurovaný)."

msgid "Master Addressbook"
msgstr "Hlavný adresár"

msgid "Searchable by"
msgstr "Vyhľadávateľné pomocou"

msgid "I2P applications"
msgstr "I2P aplikácie"

msgid "The Master, Router and Private address books collectively serve as the DNS authority for I2P applications."
msgstr "Hlavný, smerovací a súkromný adresár spoločne slúžia ako DNS autorita pre I2P aplikácie."

msgid "Optional,"
msgstr "Voliteľné,"

msgid "for websites"
msgstr "pre webstránky"

msgid "If you configure SusiDNS to publish your Router address book, it will export a hosts.txt file containing all the hosts (by default to the root of your eepsite)."
msgstr "Ak nakonfigurujete SusiDNS na publikovanie adresára smerovača, exportuje hosts.txt súbor obsahujúci všetkých hostiteľov (štandardne do koreňa vašej eepstránky)."

msgid "Addresses manually added to your Master address book will merge with your Router address book."
msgstr "Adresy ručne pridané do hlavného adresára sa zlúčia s adresárom smerovača."

msgid "Hosts you receive from your subscriptions will merge with your Router address book."
msgstr "Hostitelia z vašich odberov sa zlúčia s adresárom smerovača."

