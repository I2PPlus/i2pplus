msgstr "Súbor s hlavičkou etags z načítaných URL adries odberov (nie je potrebné meniť)"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "Súbor s časovou pečiatkou úpravy každej načítanej URL adresy odberu (nie je potrebné meniť)"

msgid "File to log activity to (change to /dev/null if you like)"
