msgid "Whether to update the published addressbook"
msgstr "是否更新已發布位址簿"

msgid "File containing the etags header from the fetched subscription URLs (no need to change)"
msgstr "包含已擷取訂閱URL之etags標頭的檔案（無須變更）"

msgid "File containing the modification timestamp for each fetched subscription URL (no need to change)"
msgstr "包含每個已擷取訂閱URL之修改時間戳記的檔案（無須變更）"

msgid "File to log activity to (change to /dev/null if you like)"
msgstr "要寫入日誌的檔案（如有需要可改為/dev/null）"

msgid "Name of override theme to use (defaults to console-selected theme)"
msgstr "要使用的覆寫主題名稱（預設為主控台選取的主題）"

msgid "Interval (in hours) for running host checker (default is 4 hours)"
msgstr "執行HostChecker的間隔（以小時為單位）（預設為4小時）"

msgid "Maximum concurrent pings when running host checker (Default is 16, max is 160)"
msgstr "執行HostChecker時同時作用的ping數量上限（預設為16，最大為160）"

