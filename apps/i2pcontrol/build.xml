<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="all" name="source">
  <property name="build.root" value="${java.io.tmpdir}/build-i2p/"/>
  <property name="build.dir" value="${build.root}apps/i2pcontrol/build"/>

  <property name="core.java.build.dir" value="${build.root}core/java/build"/>

  <property name="i2pbase" value="../.."/>
  <property name="i2plib" value="${i2pbase}/build"/>
  <property name="jettylib" value="${i2pbase}/apps/jetty/jettylib"/>
  <property name="jetty.pkg.dir" value="${jettylib}"/>
  <property name="wrapperlib" value="${i2pbase}/installer/lib/wrapper/all"/>

  <!--
         Supports four build options:
         1) war (jsonrpc.war) for running under the console
         2) jar (i2pcontrol.jar) for starting and running on its own Jetty instance,
            no console dependency
         3) socketJar (i2pcontrol.jar) for running on a ServerSocket (JSON splitting),
            no Jetty dependency (Work in progress)
         4) TODO xxxjar with bundled, small non-Jetty server, similar to I2PTunnelHTTPClient?
     -->

  <!-- The two router jars are named through properties: a release build has them in
       ${i2plib}, while a module run in a development tree takes them from the shared
       build root the other app modules build into. Override either with
       -Di2p.jar=... -Drouter.jar=... -->
  <available file="${i2plib}/i2p.jar" property="i2plib.i2p.present"/>
  <condition property="i2p.jar" value="${i2plib}/i2p.jar">
    <isset property="i2plib.i2p.present"/>
  </condition>
  <property name="i2p.jar" value="${core.java.build.dir}/i2p.jar"/>
  <available file="${i2plib}/router.jar" property="i2plib.router.present"/>
  <property name="router.java.build.dir" value="${build.root}router/java/build"/>
  <condition property="router.jar" value="${i2plib}/router.jar">
    <isset property="i2plib.router.present"/>
  </condition>
  <property name="router.jar" value="${router.java.build.dir}/router.jar"/>

  <path id="cp">
    <pathelement location="${i2p.jar}"/>
    <pathelement location="${router.jar}"/>
    <pathelement location="${jettylib}/org.mortbay.jetty.jar"/>
    <pathelement location="${jettylib}/javax.servlet.jar"/>
    <pathelement location="${jettylib}/jetty-servlet.jar"/>
    <pathelement location="${jetty.pkg.dir}/jetty-util.jar"/>
    <pathelement location="${wrapperlib}/wrapper.jar"/>
    <!-- following jar only present for debian builds -->
    <pathelement location="${core.java.build.dir}/json-simple.jar"/>
  </path>

  <path id="cpSocket">
    <pathelement location="${i2plib}/i2p.jar"/>
    <pathelement location="${i2plib}/router.jar"/>
    <!-- TODO get rid of wraper dependency also -->
    <pathelement location="${wrapperlib}/wrapper.jar"/>
    <!-- following jar only present for debian builds -->
    <pathelement location="${core.java.build.dir}/json-simple.jar"/>
  </path>

  <target name="all" depends="clean, build"/>
  <target name="build" depends="jar"/>
  <condition property="depend.available">
    <typefound name="depend"/>
  </condition>
  <target name="builddep" if="depend.available">
    <depend
      cache="${build.dir}/depend-cache"
      srcdir="./java"
      destdir="${build.dir}/obj">
      <classpath refid="cp"/>
    </depend>
  </target>

  <property name="javac.compilerargs" value=""/>
  <property name="javac.version" value="1.8"/>
  <property name="javac.release" value="8"/>

  <target name="compile" depends="builddep">
    <mkdir dir="${build.dir}"/>
    <mkdir dir="${build.dir}/obj"/>
    <javac
      srcdir="./java"
      debug="true" deprecation="on" source="${javac.version}" target="${javac.version}"
      release="${javac.release}"
      includeAntRuntime="false"
      encoding="UTF-8"
      destdir="${build.dir}/obj">
      <compilerarg line="${javac.compilerargs}"/>
      <classpath refid="cp"/>
      <!-- the junit sources are compiled by junit.compileTest, against junit4 -->
      <exclude name="test/**"/>
    </javac>
  </target>

  <!--
      More TODO here. jsonrpc2 lib uses MessageContext which depends on servlet
     -->
  <target name="compileSocketJar" depends="builddep">
    <!-- Separate destdir: this compiles the same sources as "compile" but against the
         narrower cpSocket classpath, so sharing ${build.dir}/obj would let the two
         entry points interleave classes built against different classpaths. -->
    <mkdir dir="${build.dir}"/>
    <mkdir dir="${build.dir}/obj-socket"/>
    <javac
      sourcepath=""
      srcdir="./java"
      debug="true" deprecation="on" source="${javac.version}" target="${javac.version}"
      release="${javac.release}"
      includeAntRuntime="false"
      encoding="UTF-8"
      destdir="${build.dir}/obj-socket">
      <compilerarg line="${javac.compilerargs}"/>
      <classpath refid="cpSocket"/>
      <exclude name="**/I2PControlController.java"/>
      <exclude name="**/HostCheckHandler.java"/>
      <exclude name="**/JSONRPC2Servlet.java"/>
      <exclude name="test/**"/>
    </javac>
  </target>

  <target name="jarUpToDate">
    <uptodate property="jar.uptodate" targetfile="${build.dir}/i2pcontrol.jar">
      <srcfiles dir="${build.dir}/obj" includes="**/*.class"/>
    </uptodate>
  </target>

  <target name="jar" depends="compile, jarUpToDate" unless="jar.uptodate">
    <!-- set if unset -->
    <property name="workspace.changes.tr" value=""/>
    <jar destfile="${build.dir}/i2pcontrol.jar" basedir="${build.dir}/obj" includes="**/*.class">
      <manifest>
        <attribute name="Implementation-Version" value="${full.version}"/>
        <attribute name="Built-By" value="${build.built-by}"/>
        <attribute name="Build-Date" value="${build.timestamp}"/>
        <attribute name="Base-Revision" value="${workspace.version}"/>
        <attribute name="Workspace-Changes" value="${workspace.changes.tr}"/>
        <attribute name="X-Compile-Source-JDK" value="${javac.version}"/>
        <attribute name="X-Compile-Target-JDK" value="${javac.version}"/>
      </manifest>
    </jar>
  </target>

  <target name="socketJar" depends="compileSocketJar">
    <!-- set if unset -->
    <property name="workspace.changes.tr" value=""/>
    <jar destfile="${build.dir}/i2pcontrol.jar" basedir="${build.dir}/obj-socket" includes="**/*.class">
      <manifest>
        <attribute name="Implementation-Version" value="${full.version}"/>
        <attribute name="Built-By" value="${build.built-by}"/>
        <attribute name="Build-Date" value="${build.timestamp}"/>
        <attribute name="Base-Revision" value="${workspace.version}"/>
        <attribute name="Workspace-Changes" value="${workspace.changes.tr}"/>
        <attribute name="X-Compile-Source-JDK" value="${javac.version}"/>
        <attribute name="X-Compile-Target-JDK" value="${javac.version}"/>
      </manifest>
    </jar>
  </target>

  <target name="warUpToDate">
    <uptodate property="war.uptodate" targetfile="${build.dir}/jsonrpc.war">
      <srcfiles dir="${build.dir}/obj" includes="**/*.class"/>
    </uptodate>
  </target>

  <target name="war" depends="compile, warUpToDate" unless="war.uptodate">
    <!-- set if unset -->
    <property name="workspace.changes.tr" value=""/>
    <war destfile="${build.dir}/jsonrpc.war" webxml="web.xml">
      <classes dir="${build.dir}/obj" excludes="net/i2p/i2pcontrol/I2PControlController.class net/i2p/i2pcontrol/HostCheckHandler.class net/i2p/i2pcontrol/SocketController*.class"/>
      <manifest>
        <attribute name="Implementation-Version" value="${full.version}"/>
        <attribute name="Built-By" value="${build.built-by}"/>
        <attribute name="Build-Date" value="${build.timestamp}"/>
        <attribute name="Base-Revision" value="${workspace.version}"/>
        <attribute name="Workspace-Changes" value="${workspace.changes.tr}"/>
        <attribute name="X-Compile-Source-JDK" value="${javac.version}"/>
        <attribute name="X-Compile-Target-JDK" value="${javac.version}"/>
      </manifest>
    </war>
  </target>

  <target name="junit.compileTest" depends="compile">
    <property name="junit.home" value="../../tools/test/junit/"/>
    <property name="hamcrest.home" value="../../tools/test/hamcrest/"/>
    <mkdir dir="${build.dir}/testobj"/>
    <javac debug="true" deprecation="on" source="${javac.version}" target="${javac.version}"
      release="${javac.release}" includeAntRuntime="false" encoding="UTF-8"
      destdir="${build.dir}/testobj" srcdir="./java/test/junit" includes="**/*Test.java">
      <classpath>
        <path refid="cp"/>
        <pathelement location="${build.dir}/obj"/>
        <pathelement location="${junit.home}/junit4.jar"/>
        <pathelement location="${hamcrest.home}/hamcrest-core.jar"/>
      </classpath>
      <compilerarg line="${javac.compilerargs}"/>
    </javac>
  </target>

  <target name="junit.test" depends="junit.compileTest">
    <property name="junit.reports.dir" value="${build.root}reports"/>
    <property name="junit.home" value="../../tools/test/junit/"/>
    <property name="hamcrest.home" value="../../tools/test/hamcrest/"/>
    <mkdir dir="${junit.reports.dir}/i2pcontrol/junit/"/>
    <delete>
      <fileset dir="${junit.reports.dir}/i2pcontrol/junit">
        <include name="TEST-*.xml"/>
      </fileset>
    </delete>
    <!-- One scratch directory per module, under the shared test root, as in the
         other app modules: the forked test JVM reads the properties file ant
         wrote for it here and writes its vmwatcher file here. -->
    <property name="test.base.root" value="${java.io.tmpdir}/test-i2p/"/>
    <property name="junit.tmp.dir" value="${test.base.root}i2pcontrol/tmp"/>
    <mkdir dir="${junit.tmp.dir}"/>
    <!-- Scratch I2P base for the forked test JVM, so a test that builds a
         context does not write runtime state into the workspace. -->
    <property name="junit.test.base" value="${test.base.root}i2pcontrol/base"/>
    <delete dir="${junit.test.base}"/>
    <mkdir dir="${junit.test.base}"/>
    <property name="junit.test.filter" value="**/*Test.java"/>
    <junit printsummary="withOutAndErr" fork="yes" showoutput="yes" tempdir="${junit.tmp.dir}" timeout="15000">
      <sysproperty key="i2p.dir.base" value="${junit.test.base}"/>
      <classpath>
        <path refid="cp"/>
        <pathelement location="${junit.home}/junit4.jar"/>
        <pathelement location="${hamcrest.home}/hamcrest-core.jar"/>
        <pathelement location="${hamcrest.home}/hamcrest-library.jar"/>
        <pathelement location="${build.dir}/obj"/>
        <pathelement location="${build.dir}/testobj"/>
      </classpath>
      <batchtest todir="${junit.reports.dir}/i2pcontrol/junit/">
        <fileset dir="./java/test/junit" includes="${junit.test.filter}"/>
      </batchtest>
      <formatter type="xml"/>
    </junit>
    <delete dir="${junit.test.base}"/>
  </target>

  <target name="test" depends="junit.test"/>

  <target name="clean">
    <delete dir="${build.dir}"/>
  </target>

  <target name="cleandep" depends="clean">
  </target>

  <target name="distclean" depends="clean">
  </target>
</project>
