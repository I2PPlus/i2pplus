# NOTE: This I2P config file must use UTF-8 encoding
#
# If you have a 'split' directory installation, with configuration
# files in ~/.i2p (Linux), %LOCALAPPDATA%\I2P (Windows),
# or /Users/(user)/Library/Application Support/i2p (Mac), be sure to
# edit the file in the configuration directory, NOT the install directory.
# When running as a Linux daemon, the configuration directory is /var/lib/i2p
# and the install directory is /usr/share/i2p .
# When running as a Windows service, the configuration directory is \ProgramData\i2p
# and the install directory is \Program Files\i2p .
#
i2psnark.dir=i2psnark
#
# Optional: staging directory for incomplete downloads.
# When set, partial files are written here and only moved into the data
# directory (i2psnark.dir) once a file's pieces are all downloaded, which
# can reduce wear on a small or flash-based data partition. The directory
# must be writable and have room for the largest downloads you intend to
# run at the same time. Comment this out or leave it empty to disable.
# If the path contains spaces, surround it with double quotes.
#i2psnark.tempDir=/tmp/i2psnark
# Add BEP 47 padding files to new torrents created by I2PSnark, so each
# file except the last ends on a piece boundary. Existing padded torrents
# are handled the same either way. The config file is re-read every 30
# seconds, so changes apply without a restart.
#i2psnark.shouldPadFiles=false
