msgid "I2P+ installation complete!"
msgstr "Inštalácia I2P+ dokončená!"

msgid "Welcome to I2P+!"
msgstr "Vitajte v I2P+!"

#, java-format
msgid "Please {0}have patience{1} as I2P+ boots up and finds peers."
msgstr "Prosím {0}buďte trpezliví{1}, kým sa I2P+ spúšťa a hľadá peerov."

#, java-format
msgid ""
"While you are waiting, please {0}adjust your bandwidth settings{1} on the "
"{2}configuration page{3}."
msgstr ""
"Počas čakania {0}upravte nastavenia šírky pásma{1} na {2}konfiguračnej "
"stránke{3}."

#, java-format
msgid ""
"You can also run the bandwidth test via the {0}Setup Wizard{1} to help with "
"determining your bandwidth, and a guide for new users and additional "
"documentation including an FAQ is available in the {2}help section{1}."
msgstr ""
"Test šírky pásma môžete spustiť cez {0}Sprievodcu nastavením{1}. Príručka "
"pre nových používateľov a FAQ sú k dispozícii v {2}sekcii pomocníka{1}."

#, java-format
msgid ""
"You may also wish to enable I2P+ updates on {0}the update configuration "
"page{1}."
msgstr ""
"Tiež môžete povoliť aktualizácie I2P+ na {0}stránke konfigurácie "
"aktualizácií{1}."

msgid ""
"Also you can setup your browser to use the I2P proxy to reach eepsites."
msgstr ""
"Tiež môžete nastaviť prehliadač na používanie I2P proxy na prístup k "
"eepstránkam."

msgid ""
"Just enter 127.0.0.1 (or localhost) port 4444 as a http proxy into your "
"browser settings."
msgstr ""
"Stačí zadať 127.0.0.1 (alebo localhost) port 4444 ako http proxy do "
"nastavení prehliadača."

msgid "Do not use SOCKS for this."
msgstr "Na to nepoužívajte SOCKS."

#, java-format
msgid ""
"More information can be found on the {0}I2P browser proxy setup page{1}."
msgstr ""
"Viac informácií nájdete na {0}stránke nastavenia I2P proxy prehliadača{1}."

#, java-format
msgid ""
"Point your IRC client to {0}localhost:6668{1} and say hi to us on "
"{2}#saltR{3}."
msgstr ""
"Nasmerujte IRC klienta na {0}localhost:6668{1} a pozdravte nás na "
"{2}#saltR{3}."
