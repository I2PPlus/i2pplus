"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "I2P+ installation complete!"
msgstr "I2P+ انسٹالیشن مکمل ہو گئی!"

msgid "Welcome to I2P+!"
msgstr "I2P+ میں خوش آمدید!"

#, java-format
msgid "Please {0}have patience{1} as I2P+ boots up and finds peers."
msgstr "براہِ کرم {0}صبر کریں{1} جبکہ I2P+ شروع ہوتا ہے اور peer تلاش کرتا ہے۔"

#, java-format
msgid "While you are waiting, please {0}adjust your bandwidth settings{1} on the {2}configuration page{3}."
msgstr "انتظار کرتے ہوئے، براہِ کرم {0}اپنی بینڈ وائٹ ترتیبات ایڈجسٹ کریں{1} {2}ترتیبات صفحے{3} پر۔"

#, java-format
msgid "You can also run the bandwidth test via the {0}Setup Wizard{1} to help with determining your bandwidth, and a guide for new users and additional documentation including an FAQ is available in the {2}help section{1}."
msgstr "آپ {0}سیٹ اپ ویزارڈ{1} کے ذریعے بینڈ وائٹ ٹیسٹ بھی چلا سکتے ہیں جو آپ کی بینڈ وائٹ کا تعین کرنے میں مدد کرتا ہے، اور نئے صارفوں کے لیے رہنمائی اور FAQ سمیت اضافی دستاویزات {2}مدد سیکشن{1} میں دستیاب ہیں۔"

#, java-format
msgid "You may also wish to enable I2P+ updates on {0}the update configuration page{1}."
msgstr "آپ {0}اپ ڈیٹ کی ترتیبات والے صفحے{1} پر I2P+ اپ ڈیٹس بھی فعال کرنا چاہیں گے۔"

msgid "Also you can setup your browser to use the I2P proxy to reach eepsites."
msgstr "نیز آپ اپنا براؤزر ترتیب دے سکتے ہیں تاکہ eepsites تک رسائی کے لیے I2P پراکسی استعمال کرے۔"

msgid "Just enter 127.0.0.1 (or localhost) port 4444 as a http proxy into your browser settings."
msgstr "بس اپنی براؤزر ترتیبات میں 127.0.0.1 (یا localhost) پورٹ 4444 کو http پراکسی کے طور پر درج کریں۔"

msgid "Do not use SOCKS for this."
msgstr "اس کے لیے SOCKS استعمال نہ کریں۔"

#, java-format
msgid "More information can be found on the {0}I2P browser proxy setup page{1}."
msgstr "{0}I2P براؤزر پراکسی سیٹ اپ صفحے{1} پر مزید معلومات مل سکتی ہیں۔"

#, java-format
msgid "Point your IRC client to {0}localhost:6668{1} and say hi to us on {2}#saltR{3}."
msgstr "اپنا IRC کلائنٹ {0}localhost:6668{1} کی طرف متوجہ کریں اور {2}#saltR{3} پر ہمیں سلام بھیجیں۔"
