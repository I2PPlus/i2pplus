msgstr "介面設定"

msgid "User Interface Configuration"
msgstr "使用者介面組態"

msgid "Router Console Theme"
msgstr "路由器主控台主題"

msgid "Apply"
msgstr "套用"

msgid "Theme selection disabled for Internet Explorer, sorry."
msgstr "很抱歉，Internet Explorer的主題選擇功能已停用。"

msgid ""
"A very old version has been detected. It's not recommended to use I2P with "
"unmaintained browsers."
msgstr "已偵測到非常舊的版本。不建議在未維護的瀏覽器上使用I2P。"

msgid ""
"If you're not using IE, it's likely that your browser is pretending to be "
"IE; please configure your browser (or proxy) to use a different User Agent "
"string if you'd like to access the console themes."
msgstr "如果您使用的不是IE，很可能是您的瀏覽器在模擬IE；請設定您的瀏覽器（或代理）使用不同的User Agent字串，才能存取主控台主題。"

