msgstr "在<i>選擇zip或su3檔案</i>下點選<i>瀏覽&hellip;</i>"

msgid "Select the i2preseed.zip file"
msgstr "選取i2preseed.zip檔案"

msgid "Click the <i>Reseed from File</i> button"
msgstr "點選<i>Reseed from File</i>按鈕"

