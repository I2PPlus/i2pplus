msgstr "Outproxy d’I2P"

msgid "Use HTTP Proxy for HTTP Reseed Hosts"
msgstr "Utilitzeu el servidor intermediari HTTP per als amfitrions HTTP de reseed"

msgid "Proxy requires authorization"
msgstr "El servidor intermediari requereix autorització"

msgid "Manual Reseed"
msgstr "Reseed manual"

msgid "The su3 format is preferred, as it will be verified as signed by a trusted source."
msgstr "Es prefereix el format su3, perquè es verificarà que està signat per una font de confiança."

msgid "The zip format is unsigned; use a zip file only from a source that you trust."
msgstr "El format zip no està signat; utilitzeu un fitxer zip només d’una font de confiança."

