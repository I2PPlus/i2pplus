msgstr "سیکیورٹی کے ملاحظات"

#, java-format
msgid "Always change the default API password from {0} to a strong, unique password"
msgstr "طے شدہ API پاس ورڈ کو {0} سے تبدیل کر کے ہمیشہ مضبوط اور منفرد پاس ورڈ رکھیں"

msgid "Consider binding I2PControl to localhost only if not accessed remotely"
msgstr "اگر دوری رسائی نہ ہو تو I2PControl کو صرف localhost سے باندھنے پر غور کریں"

msgid "Use HTTPS when accessing I2PControl over untrusted networks"
msgstr "غیر قابل اعتماد نیٹ ورکس پر I2PControl تک رسائی کے لیے HTTPS استعمال کریں"

msgid "Tokens may expire - implement re-authentication logic in your applications"
msgstr "ٹوکن کی میعاد ختم ہو سکتی ہے - اپنی ایپلیکیشنز میں دوبارہ تصدیق کا منطق شامل کریں"

msgid "Monitor I2PControl access logs for unauthorized usage"
msgstr "غیر مجاز استعمال کی نگرانی کے لیے I2PControl رسائی لاگز زیر نظر رکھیں"

msgid "Be cautious with router management operations - they can affect network connectivity"
msgstr "روٹر انتظامی آپریشنز میں احتیاط بریں - یہ نیٹ ورک کنکٹیوٹی کو متاثر کر سکتے ہیں"

msgid "Integration Examples"
msgstr "انٹیگریشن مثالیں"

msgid "The I2PControl API can be integrated with:"
msgstr "I2PControl API کو ان کے ساتھ انٹیگریٹ کیا جا سکتا ہے:"

msgid "Monitoring systems:"
msgstr "نگرانی نظام:"

msgid "Create custom dashboards for router performance"
msgstr "روٹر کی کارکردگی کے لیے حسبِ ضرورت ڈیش بورڈ بنائیں"

msgid "Automation scripts:"
msgstr "خودکار اسکرپٹس:"

msgid "Schedule restarts or configuration changes"
msgstr "دوبارہ شروع یا ترتیبات کی تبدیلیاں شیڈول کریں"

msgid "Mobile applications:"
msgstr "موبائل ایپلیکیشنز:"

msgid "Monitor and manage your router remotely"
msgstr "اپنے روٹر کو دوری طور پر زیر نظر رکھیں اور منظم کریں"

msgid "Network management tools:"
msgstr "نیٹ ورک انتظامی ٹولز:"

msgid "Integrate I2P status into broader network monitoring"
msgstr "I2P حالت کو وسیع تر نیٹ ورک نگرانی میں انٹیگریٹ کریں"

msgid "Alerting systems:"
msgstr "اطلاع دینے والے نظام:"

msgid "Send notifications based on router status changes"
msgstr "روٹر حالت کی تبدیلیوں کی بنیاد پر اطلاعیں بھیجیں"

msgid "Licensing Information"
msgstr "لائسنسنگ معلومات"

msgid "Legal &amp; Licensing"
msgstr "قانونی &amp; لائسنسنگ"

msgid "Introduction to I2P"
msgstr "I2P کا تعارف"

msgid "Reseeding Your Router"
msgstr "اپنے روٹر کا reseed"

msgid "Reseeding is the bootstrapping process used to find other routers when you first install I2P, or when your router has too few router references remaining. The default settings will work for most people. Change these only if HTTPS is blocked by a restrictive firewall and reseed has failed."
msgstr "reseed وہ ابتدائی عمل ہے جو I2P پہلی بار انسٹال کرنے پر یا جب آپ کے روٹر کے پاس بہت کم روٹر حوالے باقی ہوں تب دوسرے روٹرز تلاش کرنے کے لیے استعمال ہوتا ہے۔ طے شدہ ترتیبات زیادہ تر لوگوں کے لیے کام کرے گی۔ یہ صرف اس صورت میں تبدیل کریں جب کوئی محدود کنندہ فائر وال HTTPS کو روک رہی ہو اور reseed ناکام رہا ہو۔"

msgid "If reseeding has failed, you should first check your network connection."
msgstr "اگر reseed ناکام رہا ہو تو پہلے اپنا نیٹ ورک کنکشن چیک کریں۔"

msgid "If a firewall is blocking your connections to reseed hosts, you may have access to a proxy."
msgstr "اگر کوئی فائر وال آپ کے reseed میزبانوں سے کنکشنز کو روک رہی ہو تو آپ کے پاس کسی پراکسی تک رسائی ہو سکتی ہے۔"

msgid "The proxy may be remotely hosted or a service running on your computer (localhost/127.0.0.1)."
msgstr "پراکسی دوری طور پر ہوسٹ شدہ ہو سکتی ہے یا آپ کے کمپیوٹر پر چلنے والی سروس ہو سکتی ہے (localhost/127.0.0.1)۔"

msgid "Reseed Configuration page"
msgstr "reseed ترتیبات صفحہ"

#, java-format
msgid "To use a proxy to reseed, configure the proxy type, hostname, and port on the {0}."
msgstr "reseed کے لیے پراکسی استعمال کرنے کی مقصد سے، {0} پر پراکسی کی قسم، ہوسٹ نیم اور پورٹ ترتیب دیں۔"

msgid "If you are running the Tor Browser, you may use its Tor instance by configuring I2P to use: <i>Proxy type:</i> <code>SOCKS 5</code> <i>Host:</i> <code>127.0.0.1</code> <i>Port:</i> <code>9150</code>."
msgstr "اگر آپ Tor براؤزر چلا رہے ہیں تو آپ اس کا Tor انسٹنس استعمال کر سکتے ہیں، I2P کو اس طرح ترتیب دہ کر کے: <i>پراکسی کی قسم:</i> <code>SOCKS 5</code> <i>میزبان:</i> <code>127.0.0.1</code> <i>پورٹ:</i> <code>9150</code>۔"

msgid "If you are running a standalone Tor instance locally, you may use it by configuring I2P to use: <i>Proxy type:</i> <code>SOCKS 5</code> <i>Host:</i> <code>127.0.0.1</code> <i>Port:</i> <code>9050</code>."
msgstr "اگر آپ مقامی طور پر الگ Tor انسٹنس چلا رہے ہیں تو آپ اسے استعمال کر سکتے ہیں، I2P کو اس طرح ترتیب دہ کر کے: <i>پراکسی کی قسم:</i> <code>SOCKS 5</code> <i>میزبان:</i> <code>127.0.0.1</code> <i>پورٹ:</i> <code>9050</code>۔"

msgid "If you have some peers but need more, you may try the I2P Outproxy option. This will not work for the initial reseed when you have 0 known peers. Selecting this option will use the I2P HTTP outproxy (by default on <code>127.0.0.1:4444</code>) or, if configured, the Orchid Tor plugin."
msgstr "اگر آپ کے پاس کچھ peer ہیں لیکن مزید چاہیئیں تو آپ I2P outproxy آپشن آزما سکتے ہیں۔ یہ ابتدائی reseed کے لیے کام نہیں کرے گا جب آپ کے پاس 0 معلوم peer ہوں۔ یہ آپشن منتخب کرنے پر I2P HTTP outproxy (طے شدہ طور پر <code>127.0.0.1:4444</code> پر) یا ترتیب شدہ ہونے پر Orchid Tor پلگ ان استعمال کی جائے گی۔"

msgid "Then click the <i>Save changes</i> button to confirm the proxy configuration and then the <i>Reseed now</i> button to initiate the reseed process."
msgstr "پھر پراکسی ترتیبات کی تصدیق کے لیے <i>تبدیلیاں محفوظ کریں</i> بٹن پر کلک کریں اور پھر reseed کا عمل شروع کرنے کے لیے <i>ابھی reseed کریں</i> بٹن پر کلک کریں۔"

#, java-format
msgid "If you know and trust somebody that runs I2P, ask them to send you a reseed file generated using this page in their router console. Then, select the <i>Reseed from file</i> option on the {0} using the file you received."
msgstr "اگر آپ کوئی ایسا شخص جانتے اور اس پر بھروسہ کرتے ہیں جو I2P چلاتا ہے تو اس سے کہیں کہ وہ آپ کو اپنے روٹر کنسول میں اس صفحے کا استعمال کر کے بنائی گئی reseed فائل بھیجے۔ پھر دریافت کردہ فائل کا استعمال کر کے {0} پر <i>فائل سے reseed</i> آپشن منتخب کریں۔"

#, java-format
msgid "If you know and trust somebody that publishes reseed files, ask them for the URL. Then, click the <i>Reseed from URL</i> button on the {0} to reseed using the URL you received."
msgstr "اگر آپ کوئی ایسا شخص جانتے اور اس پر بھروسہ کرتے ہیں جو reseed فائلز شائع کرتا ہے تو اس سے URL مانگیں۔ پھر دریافت کردہ URL کے ذریعے reseed کرنے کے لیے {0} پر <i>URL سے reseed</i> بٹن پر کلک کریں۔"

msgid "How do I reseed manually?"
msgstr "میں دستی reseed کیسے کروں؟"

msgid "An I2P router usually only needs to be seeded once, to join the network for the first time. However, if the router is running for an extended period without network connectivity it may also need to be reseeded. Reseeding involves fetching multiple \"RouterInfo\" files (bundled into a signed zip-file) from at least two predefined server URLs picked from a volunteer-run group of clearnet HTTPS servers."
msgstr "ایک I2P روٹر کو عموماً صرف ایک بار reseed کی ضرورت ہوتی ہے تاکہ پہلی بار نیٹ ورک میں شامل ہو سکے۔ تاہم اگر روٹر بغیر نیٹ ورک کنکٹیوٹی کے لمبے عرصے سے چل رہا ہو تو اسے بھی reseed کی ضرورت پڑ سکتی ہے۔ reseed میں رضاکارانہ طور پر چلائے جانے والے clearnet HTTPS سرورز کے گروپ سے منتخب کیے گئے کم از کم دو پیش کیے گئے سرور URL سے کئی «RouterInfo» فائلیں (ایک دستخط شدہ zip فائل میں بندھی ہوئی) حاصل کی جاتی ہیں۔"

msgid "If the number of known peers drops below 50, I2P will attempt to reseed automatically. If the reseed attempt fails, a notification will appear in the sidebar with an option to manually reseed. A failed reseed attempt can occur if your local firewall limits outbound traffic, you are experiencing network connectivity issues, or if the reseed request is blocked entirely."
msgstr "معلوم peer کی تعداد 50 سے کم ہونے پر I2P خودکار طور پر reseed کرنے کی کوشش کرے گا۔ اگر reseed کی کوشش ناکام ہو تو سائیڈ بار میں ایک اطلاع دکھائی دے گی جس میں دستی طور پر reseed کرنے کا آپشن ہوگا۔ reseed کی کوشش اس صورت ناکام ہو سکتی ہے جب آپ کی مقامی فائر وال آؤٹ بانڈ ٹریفک کو محدود کرتی ہو، آپ کو نیٹ ورک کنکشن کے مسائل ہو رہے ہوں، یا reseed کی درخواست مکمل طور پر بلاک ہو۔"

#, java-format
msgid "In the event that you suspect the request is being blocked, you can configure I2P to use a proxy to reseed. Go to the {0} and configure the proxy type, hostname, and port."
msgstr "اگر آپ کو لگتا ہے کہ درخواست بلاک کی جا رہی ہے تو آپ I2P کو reseed کے لیے پراکسی استعمال کرنے کے لیے ترتیب دے سکتے ہیں۔ {0} پر جائیں اور پراکسی کی قسم، ہوسٹ نیم اور پورٹ ترتیب دیں۔"

msgid "If you are stuck behind an ISP firewall or filter, you can use the following manual method (non-automated technical solution) to join the I2P network."
msgstr "اگر آپ ISP کی فائر وال یا فلٹر کے پیچھے پھنسے ہوئے ہیں تو I2P نیٹ ورک میں شامل ہونے کے لیے آپ مندرجہ ذیل دستی طریقہ (غیر خودکار تکنیکی حل) استعمال کر سکتے ہیں۔"

msgid "Joining the I2P Network using a reseed file"
msgstr "reseed فائل کے ذریعے I2P نیٹ ورک میں شامل ہونا"

msgid "Please contact a known trustworthy friend who has a running I2P router, and ask them for help with reseeding your I2P router. Request that they send you a reseed file exported from their running I2P router. It is vital that the file is exchanged over a secure channel, e.g. encrypted to avoid external tampering (PGP Sign, Encrypt and Verified with a trusted public key). The file itself is unsigned, so please accept files only from known trusted friends. Never import a reseed file if you cannot verify its source."
msgstr "ایسے کسی جانے پہچانے والے قابلِ اعتماد دوست سے رابطہ کریں جس کا I2P روٹر چل رہا ہو، اور اپنے I2P روٹر کو reseed کرنے میں مدد مانگیں۔ ایسے کہیں کہ وہ آپ کو اپنے چلتے ہوئے I2P روٹر سے برآمد کی گئی reseed فائل بھیجیں۔ یہ ضروری ہے کہ فائل کا تبادلہ محفوظ چینل پر ہو، مثلاً خفیہ کاری شدہ تاکہ بیرونی مداخلت نہ ہو (قابلِ اعتماد عوامی کلید کے ساتھ PGP دستخط، خفیہ کاری اور تصدیق)۔ فائل خود غیر دستخط شدہ ہے، اس لیے صرف جانے پہچانے والے قابلِ اعتماد دوستوں کی فائلیں قبول کریں۔ اگر آپ فائل کا ماخذ تصدیق نہ کر سکیں تو reseed فائل کبھی درآمد نہ کریں۔"

msgid "To import the received i2preseed.zip file into your local I2P router:"
msgstr "دریافت کردہ i2preseed.zip فائل اپنے مقامی I2P روٹر میں درآمد کرنے کے لیے:"

#, java-format
msgid "Go to the {0}"
msgstr "{0} پر جائیں"

msgid "Under <i>Select zip or su3 file</i> click <i>Browse&hellip;</i>"
msgstr "<i>zip یا su3 فائل منتخب کریں</i> کے تحت <i>دیکھیں&hellip;</i> پر کلک کریں"

msgid "Select the i2preseed.zip file"
msgstr "i2preseed.zip فائل منتخب کریں"

msgid "Click the <i>Reseed from File</i> button"
msgstr "<i>فائل سے reseed</i> بٹن پر کلک کریں"

msgid "Service (Wrapper) log"
msgstr "سروس (wrapper) لاگ"

#, java-format
msgid "The reseed status will be indicated on the sidebar. You can also check the {0} for the following message: <code>Reseed got 100 router infos from file with 0 errors</code>"
msgstr "reseed کی حالت سائیڈ بار پر دکھائی دے گی۔ آپ مندرجہ ذیل پیغام کے لیے {0} بھی دیکھ سکتے ہیں: <code>Reseed got 100 router infos from file with 0 errors</code>"

msgid "Sharing a reseed file"
msgstr "reseed فائل شیئر کرنا"

msgid "For trusted friends you can use your local I2P router to give them a jump start:"
msgstr "قابلِ اعتماد دوستوں کے لیے آپ اپنے مقامی I2P روٹر کو استعمال کر کے انہیں ابتدائی راستہ دے سکتے ہیں:"

msgid "Under <i>Create Reseed File</i> click the <i>Create reseed file</i> button"
msgstr "<i>reseed فائل بنائیں</i> کے تحت <i>reseed فائل بنائیں</i> بٹن پر کلک کریں"

msgid "Securely send the i2preseed.zip file to your friend"
msgstr "i2preseed.zip فائل اپنے دوست کو محفوظ طریقے سے بھیجیں"

msgid "Do not reveal this file to unknown users, as it contains sensitive data (100 RouterInfo files) from your own I2P router which potentially could be used by an adversary to decloak your identity. In order to protect your anonymity: you should wait for a few hours/days before sharing the file with your trusted friend. It is also advisable to use this procedure sparingly (no more than once a week)."
msgstr "یہ فائل نامعلوم صارفین کو مت دکھائیں، کیونکہ اس میں آپ کے اپنے I2P روٹر کا حساس ڈیٹا (100 RouterInfo فائلیں) موجود ہے جو دشمن کے ذریعے آپ کی شناخت ظاہر کرنے کے لیے استعمال ہو سکتا ہے۔ اپنی گمنیمیت کی حفاظت کے لیے: فائل اپنے قابلِ اعتماد دوست کے ساتھ شیئر کرنے سے چند گھنٹے یا دن رکیں۔ یہ طریقہ کم سے کم استعمال کرنا بھی بہتر ہے (ہفتے میں ایک بار سے زیادہ نہیں)۔"

msgid "General guidelines for manual reseeding of I2P"
msgstr "I2P کے دستی reseed کے لیے عمومی رہنمائی"

msgid "Do not publicly publish the reseed file or share these files with a friend of a friend!"
msgstr "reseed فائل کو عوامی طور پر شائع نہ کریں اور نہ ہی یہ فائلیں کسی دوست کے دوست کے ساتھ شیئر کریں!"

msgid "This file should be used only for a very limited number of friends (less than 3)."
msgstr "یہ فائل صرف بہت محدود تعداد کے دوستوں کے لیے استعمال ہونی چاہیے (3 سے کم)۔"

msgid "The file will only be valid for a limited time (less than 3 weeks)."
msgstr "فائل صرف محدود وقت کے لیے درست رہے گی (3 ہفتوں سے کم)۔"

msgid "If you're experiencing issues with running I2P+, the following information may help identify and resolve the problem:"
msgstr "اگر آپ کو I2P+ چلانے میں مسائل کا سامنا ہے تو مندرجہ ذیل معلومات مسئلے کی شناخت اور حل میں مدد کر سکتی ہیں:"

msgid "Be Patient!"
msgstr "صبر کریں!"

msgid "I2P+ may be slow to integrate into network the first time you run it as it bootstraps into the network and learns of additional peers. The longer your I2P+ router is running, the better it will perform, so try and keep your router on as long as you can, 24/7 if possible! If, after 30 minutes, your <i>Active: [connected/recent]</i> count still has less than 10 peers, or your total number of <i>Integrated</i> peers is less than 5, there are several things you can do to check for problems:"
msgstr "پہلی بار چلانے پر I2P+ کا نیٹ ورک میں شامل ہونا سست ہو سکتا ہے، کیونکہ یہ نیٹ ورک میں ابتدائی جگہ بناتا ہے اور مزید peer سیکھتا ہے۔ آپ کا I2P+ روٹر جتنی دیر چلتا رہے گا، کارکردگی اتنی ہی بہتر ہوگی، اس لیے کوشش کریں کہ روٹر کو جتنے ممکن ہو زیادہ دیر چلا رہیں، ممکن ہو تو 24/7! اگر 30 منٹ کے بعد آپ کے <i>فعال: [منسلک/حالیہ]</i> کی تعداد میں اب بھی 10 سے کم peer ہیں، یا <i>انٹیگریٹڈ</i> peer کی کل تعداد 5 سے کم ہو تو مسائل جانچنے کے لیے کئی کام کیے جا سکتے ہیں:"

msgid "Check your Configuration &amp; Bandwidth Allocation"
msgstr "اپنی ترتیبات &amp; بینڈ وائٹ کی تخصیص چیک کریں"

msgid "I2P+ functions best when you can accurately reflect the speed of your network connection in the <a href=/config>bandwidth configuration section</a>. By default I2P+ is configured with some fairly conservative values that will not suit many use cases, so please take time to review these settings and correct where necessary. The more bandwidth you allocate, <i>specifically</i> upstream bandwidth, the more you will benefit from the network."
msgstr "اگر آپ اپنے نیٹ ورک کنکشن کی رفتار کو <a href=/config>بینڈ وائٹ کی ترتیبات کے سیکشن</a> میں درست طور پر ظاہر کر سکیں تو I2P+ بہترین کام کرتا ہے۔ طے شدہ طور پر I2P+ کی ترتیب میں کچھ نسبتاً محفوظ قدریں رکھی گئی ہیں جو بہت سے استعمال کی صورتوں کے لیے مناسب نہیں ہیں، اس لیے براہِ کوشش ان ترتیبات کا جائزہ لیں اور جہاں ضرورت ہو درست کریں۔ آپ جو زیادہ بینڈ وائٹ مختص کریں گے، <i>خاص طور پر</i> اپ اسٹریم بینڈ وائٹ، اتنی ہی نیٹ ورک سے زیادہ فائدہ ہوگا۔"

msgid "Firewalls, Modems &amp; Routers"
msgstr "فائر والز، ماڈیم &amp; روٹرز"

msgid "Where possible, please ensure I2P+/Java is allowed bi-directional port access from the internet by configuring your modem/router/pc firewall accordingly. If you're behind a prohibitive firewall but have unrestricted outbound access, I2P+ can still function; you can turn off inbound access and rely on <a href=http://i2p-projekt.i2p/udp.html target=_blank rel=noreferrer class=sitelink>SSU IP Address Detection</a> (<a href=https://wikipedia.org/wiki/Hole_punching target=_blank rel=noreferrer class='sitelink external'>firewall hole punching</a>) to connect you to the network, and your network status in the side panel will indicate \"Status: Firewalled\". For optimal performance, please ensure I2P's <a href=/confignet#udpconfig>external port</a> is visible from the internet (see below for more information)."
msgstr "جہاں ممکن ہو، اپنے ماڈیم/روٹر/پی سی فائر وال کی ترتیب دہ کر یہ یقینی بنائیں کہ انٹرنیٹ سے I2P+/Java کو دوطرفہ پورٹ رسائی ملے۔ اگر آپ کسی بہت سخت فائر وال کے پیچھے ہیں لیکن آؤٹ بانڈ رسائی پر پابندی نہیں ہے تو بھی I2P+ کام کر سکتا ہے؛ آپ ان بانڈ رسائی بند کر کے آپ کو نیٹ ورک سے جوڑنے کے لیے <a href=http://i2p-projekt.i2p/udp.html target=_blank rel=noreferrer class=sitelink>SSU IP پتہ کی شناخت</a> (<a href=https://wikipedia.org/wiki/Hole_punching target=_blank rel=noreferrer class='sitelink external'>فائر وال ہول پنچنگ</a>) پر بھی اعتماد کر سکتے ہیں، اور سائیڈ پینل میں نیٹ ورک کی حالت \"Status: Firewalled\" کی طرف سے اشارہ کرے گی۔ بہترین کارکردگی کے لیے یقینی بنائیں کہ I2P کا <a href=/confignet#udpconfig>باہری پورٹ</a> انٹرنیٹ سے نظر آتا ہو (مزید معلومات کے لیے نیچے دیکھیں)۔"

msgid "Check Your Proxy Settings"
msgstr "اپنی پراکسی کی ترتیبات چیک کریں"

msgid "If you cannot see any websites at all (not even <a href=http://i2p-projekt.i2p/ target=_blank rel=noreferrer>i2p-projekt.i2p</a>), make sure your browser's proxy is set to access http traffic (<i>not</i> https, <i>not</i> socks) via <code>127.0.0.1 port 4444</code>. If you need some help, there's <a href=https://geti2p.net/en/about/browser-config target=_blank rel=noreferrer class='sitelink external'>a guide</a> to configuring your browser for I2P use."
msgstr "اگر آپ کو کوئی بھی ویب سائٹ نظر نہیں آ رہی ہے (یہاں تک کہ <a href=http://i2p-projekt.i2p/ target=_blank rel=noreferrer>i2p-projekt.i2p</a> بھی نہیں)، تو یقینی بنائیں کہ آپ کے براؤزر کی پراکسی <code>127.0.0.1 port 4444</code> کے ذریعے http ٹریفک کے لیے مقرر ہے (<i>نہیں</i> https، <i>نہیں</i> socks)۔ اگر آپ کو مدد چاہیے تو I2P کے لیے اپنے براؤزر کی ترتیب دینے کی <a href=https://geti2p.net/en/about/browser-config target=_blank rel=noreferrer class='sitelink external'>رہنمائی</a> موجود ہے۔"

msgid "Check Your Logs"
msgstr "اپنے لاگز چیک کریں"

msgid "<a href=/logs>Logs</a> may help resolve a problem. You may wish to paste excerpts in a <a href=http://i2pforum.i2p/ target=_blank rel=noreferrer>forum</a> for help, or perhaps <a href=http://cake.i2p/pastebin/ target=_blank rel=noreferrer class='sitelink external'>paste</a> it instead and reference the link on IRC for help."
msgstr "<a href=/logs>لاگز</a> مسئلے کو حل کرنے میں مدد دے سکتے ہیں۔ مدد کے لیے آپ ان حصوں کو کسی <a href=http://i2pforum.i2p/ target=_blank rel=noreferrer>فورم</a> میں پیسٹ کر سکتے ہیں، یا اس کے بجائے صرف <a href=http://cake.i2p/pastebin/ target=_blank rel=noreferrer class='sitelink external'>پیسٹ</a> کر کے IRC پر لنک کا حوالہ دیں۔"

msgid "Verify Java is Up to Date"
msgstr "تصدیق کریں کہ Java تازہ ہے"

msgid "Ensure your Java is up to date. Version 1.8 or higher is required; version 11 or higher is recommended. Check your Java version at the top of <a href=/info>the router information page</a>."
msgstr "یقینی بنائیں کہ آپ کا Java تازہ ہے۔ ورژن 1.8 یا اس سے نیا ضروری ہے؛ ورژن 11 یا اس سے نیا تجویز کردہ ہے۔ <a href=/info>روٹر معلومات کے صفحے</a> کے اوپر اپنے Java کا ورژن چیک کریں۔"

msgid "Problems running on Legacy Hardware"
msgstr "پرانے ہارڈ ویئر پر چلانے کے مسائل"

msgid "[Linux/Unix/Solaris] If you can't start the router with <code>i2p/i2prouter start</code> try the <code>runplain.sh</code> script in the same directory. Root privileges are never required to run I2P+. If you need to compile the <a href=http://i2p-projekt.i2p/jbigi.html target=_blank rel=noreferrer>jBigi library</a> (which is necessary in rare cases), consult the documentation, visit the forums, or visit <a href=irc://127.0.0.1:6668/saltR class=chatlink>the I2P+ channel</a> or <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>IRC developer channel</a>."
msgstr "[Linux/Unix/Solaris] اگر آپ روٹر کو <code>i2p/i2prouter start</code> سے شروع نہیں کر سکتے تو اسی ڈائریکٹری کی <code>runplain.sh</code> اسکرپٹ آزمائیں۔ I2P+ چلانے کے لیے کبھی بھی root کے امتیازیات درکار نہیں ہوتے۔ اگر آپ کو <a href=http://i2p-projekt.i2p/jbigi.html target=_blank rel=noreferrer>jBigi لائبریری</a> (جو شاذ و نادر صورتوں میں ضروری ہوتی ہے) کمپائل کرنی پڑے تو دستاویزات پڑھیں، فورمز دیکھیں، یا <a href=irc://127.0.0.1:6668/saltR class=chatlink>I2P+ چینل</a> یا <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>IRC ڈویلپر چینل</a> پر تشریف لائیں۔"

msgid "Enable Universal Plug and Play (UPnP)"
msgstr "یونیورسل پلگ اینڈ پلے (UPnP) فعال کریں"

msgid "Your modem or router may support <a href=https://wikipedia.org/wiki/Universal_Plug_and_Play target=_blank rel=noreferrer>Universal Plug &amp; Play</a> (UPnP), which permits automatic port forwarding. Ensure UPnP support for I2P+ is enabled on the <a href=/confignet>config page</a>, then try to activate UPnP on your modem/router and possibly your computer also. Now try restarting the <a href=/>I2P+ router</a>. If successful, I2P+ should report \"Status: OK\" in the side panel once the I2P+ router completes initial connectivity tests."
msgstr "آپ کا ماڈیم یا روٹر <a href=https://wikipedia.org/wiki/Universal_Plug_and_Play target=_blank rel=noreferrer>یونیورسل پلگ &amp; پلے</a> (UPnP) کو سپورٹ کر سکتا ہے، جو خودکار پورٹ فارورڈ کی اجازت دیتا ہے۔ یقینی بنائیں کہ <a href=/confignet>کنفیگ صفحے</a> پر I2P+ کے لیے UPnP سپورٹ فعال ہو، پھر اپنے ماڈیم/روٹر اور ممکن ہو تو اپنے کمپیوٹر پر بھی UPnP فعال کرنے کی کوشش کریں۔ اب <a href=/>I2P+ روٹر</a> کو دوبارہ شروع کرنے کی کوشش کریں۔ اگر کامیاب ہو جائے تو I2P+ روٹر کے ابتدائی کنکشن ٹیسٹ مکمل ہونے کے بعد I2P+ سائیڈ پینل میں \"Status: OK\" کی طرف سے اشارہ کرے گا۔"

msgid "Port Forwarding"
msgstr "پورٹ فارورڈنگ"

msgid "Open <a href=/confignet#udpconfig>I2P+'s port</a> on your modem, router and/or firewall(s) for better connectivity (ideally both UDP and TCP). More information on how to go about port forwarding can be found at <a href=http://portforward.com/ target=_blank rel=noreferrer class='sitelink external'>portforward.com</a>, in addition to our forums and IRC channels listed below. Note that I2P does not support connecting to the internet via an http or socks proxy [patches welcome!], though you can connect to proxies via I2P itself once connected to the network."
msgstr "<a href=/confignet#udpconfig>I2P+ کا پورٹ</a> اپنے ماڈیم، روٹر اور/یا فائر وال(ز) پر کھولیں تاکہ رسائی بہتر ہو (ترجیحی طور پر UDP اور TCP دونوں)۔ پورٹ فارورڈنگ کا طریقہ جاننے کے بارے میں مزید معلومات <a href=http://portforward.com/ target=_blank rel=noreferrer class='sitelink external'>portforward.com</a> پر، اور اس کے علاوہ مندرجہ ذیل ذکر کردہ ہمارے فورمز اور IRC چینلز پر مل سکتی ہیں۔ نوٹ کریں کہ I2P http یا socks پراکسی کے ذریعے انٹرنیٹ سے منسلک ہونے کی سپورٹ نہیں کرتا [پیچ پیچیں خوش آمدید!]، ہرچندکہ نیٹ ورک سے منسلک ہونے کے بعد آپ خود پراکسیز سے I2P کے ذریعے منسلک ہو سکتے ہیں۔"

msgid "Getting Support Online"
msgstr "آن لائن مدد حاصل کرنا"

msgid "You may also want to review the information on the <a href=http://i2p-projekt.i2p/ target=_blank rel=noreferrer>I2P website</a>, post messages to the <a href='http://i2pforum.i2p/viewforum.php?f=8' target=_blank rel=noreferrer>I2P discussion forum</a> or swing by <a href=irc://127.0.0.1:6668/saltR class=chatlink>#saltR</a> or <a href=irc://127.0.0.1:6668/i2p class=chatlink>#i2p-dev</a> on I2P's internal IRC network."
msgstr "آپ <a href=http://i2p-projekt.i2p/ target=_blank rel=noreferrer>I2P ویب سائٹ</a> پر موجود معلومات بھی دیکھنا چاہیں گے، <a href='http://i2pforum.i2p/viewforum.php?f=8' target=_blank rel=noreferrer>I2P ڈسکشن فورم</a> پر پیغامات پوسٹ کریں یا I2P کے اندرونی IRC نیٹ ورک پر <a href=irc://127.0.0.1:6668/saltR class=chatlink>#saltR</a> یا <a href=irc://127.0.0.1:6668/i2p class=chatlink>#i2p-dev</a> پر تشریف لائیں۔"

msgid "Reporting Bugs"
msgstr "خرابیوں کی اطلاع دینا"

msgid "If you'd like to report a bug, please file a ticket on <a href=https://github.com/I2PPlus/i2pplus/issues target=_blank rel=noreferrer class=sitelink>github.com/I2PPlus/i2pplus/issues</a>. For developer-related discussions, please visit <a href=http://zzz.i2p/ target=_blank rel=noreferrer class=sitelink>zzz's developer forums</a> or come and visit the <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>developer channel</a> on I2P's IRC network."
msgstr "اگر آپ خرابی کی اطلاع دینا چاہیں تو <a href=https://github.com/I2PPlus/i2pplus/issues target=_blank rel=noreferrer class=sitelink>github.com/I2PPlus/i2pplus/issues</a> پر ٹکٹ درج کریں۔ ڈویلپر سے متعلق بحثوں کے لیے <a href=http://zzz.i2p/ target=_blank rel=noreferrer class=sitelink>zzz کے ڈویلپر فورمز</a> دیکھیں یا I2P کے IRC نیٹ ورک پر <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>ڈویلپر چینل</a> پر تشریف لائیں۔"

msgid "Further assistance is available here:"
msgstr "یہاں مزید مدد دستیاب ہے:"

msgid "I2P Support Forum"
msgstr "I2P سپورٹ فورم"

msgid "I2P Developers' Forum"
msgstr "I2P ڈویلپرز کا فورم"

msgid "I2P Wiki"
msgstr "I2P وائیکی"

msgid "The FAQ on <a href=http://i2p-projekt.i2p/en/faq target=_blank rel=noreferrer>i2p-projekt.i2p</a> or <a href=https://geti2p.net/en/faq target=_blank rel=noreferrer>geti2p.net</a>"
msgstr "<a href=http://i2p-projekt.i2p/en/faq target=_blank rel=noreferrer>i2p-projekt.i2p</a> یا <a href=https://geti2p.net/en/faq target=_blank rel=noreferrer>geti2p.net</a> پر موجود سوالات و جوابات"

msgid "You may also try <a href=irc://127.0.0.1:6668/saltR class=chatlink>#saltR</a> or <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>#i2p</a> on I2P's IRC network."
msgstr "آپ I2P کے IRC نیٹ ورک پر <a href=irc://127.0.0.1:6668/saltR class=chatlink>#saltR</a> یا <a href=irc://127.0.0.1:6668/i2p-dev class=chatlink>#i2p</a> بھی آزمائیں۔"

msgid "Introduction to Tunnel Filtering"
msgstr "ٹنل فلٹرنگ کا تعارف"

msgid "Server tunnels, configurable in the <a href=/i2ptunnelmgr>Tunnel Manager</a>, provide a number of ways to limit access to the hosted service. Destination whitelisting, blacklisting, connection throttling, and tunnel filtering are methods provisioned to mitigate denial of service attacks, grant exclusive access to known I2P destinations, and manage traffic to the server."
msgstr "<a href=/i2ptunnelmgr>ٹنل مینیجر</a> میں ترتیب دے ہونے والے سرور ٹنلز میزبان سروس تک رسائی محدود کرنے کے کئی طریقے فراہم کرتے ہیں۔ مقصد کی وائٹ لسٹ بندی، بلیک لسٹ بندی، کنکشن پٹ بندی اور ٹنل فلٹرنگ وہ طریقے ہیں جو ڈینیل آف سروس حملوں کو کم کرنے، جانے پہچانے گئے I2P مقاصد تک خصوصی رسائی دینے اور سرور کا ٹریفک منظم کرنے کے لیے فراہم کیے گئے ہیں۔"

msgid "A tunnel filter can provide protection against denial of service attacks, without otherwise interrupting the service for genuine users, either in conjunction with the tunnel throttler or as an alternative strategy. It can also be used to log access to a hosted service to determine if the server is under attack, or simply to log all visitors by I2P destination. Additionally, a filter can function simultaneously as a whitelist and blacklist making it more flexible than the Tunnel Manager's access list controls. Note that multiple server tunnels can share a single filter file if you wish to implement a global filter."
msgstr "ایک ٹنل فلٹر اصل صارفین کے لیے سروس میں خلل ڈالے بغیر ڈینیل آف سروس حملوں سے تحفظ فراہم کر سکتا ہے، چاہے ٹنل پٹ بند کرنے والے کے ساتھ مل کر یا بطور متبادل حکمتِ عملی۔ اسے میزبان سروس تک رسائی لاگ کرنے کے لیے بھی استعمال کیا جا سکتا ہے تاکہ یہ معلوم ہو کہ سرور پر حملہ ہو رہا ہے یا نہیں، یا بس I2P مقصد کے لحاظ سے تمام وزیٹرز کو لاگ کرنے کے لیے۔ نیز فلٹر ایک ہی وقت میں وائٹ لسٹ اور بلیک لسٹ کا کام کر سکتا ہے جو اسے ٹنل مینیجر کی رسائی فہرست کے کنٹرولز سے زیادہ لچکدار بناتا ہے۔ نوٹ کریں کہ عالمی فلٹر بنانا چاہیں تو چند سرور ٹنلز ایک ہی فلٹر فائل شیئر کر سکتی ہیں۔"

msgid "A filter is a text file that can contain one or more declarations. Blank lines and lines beginning with <i class=example>#</i> are ignored."
msgstr "فلٹر ایک ٹیکسٹ فائل ہے جس میں ایک یا زیادہ بیان ہو سکتے ہیں۔ خالی سطریں اور جن سطروں کا آغاز <i class=example>#</i> سے ہو وہ نظرانں ہیں۔"

msgid "A declaration will contain a directive (keyword) with parameters to define the scope of the declaration, and can represent one of the following:"
msgstr "بیان میں پیمانوں کے ساتھ ایک ڈائریکٹو (کلیدی لفظ) ہوگا تاکہ بیان کی حدود کی وضاحت ہو، اور یہ مندرجہ ذیل میں سے کسی ایک کی نمائندگی کر سکتا ہے:"

msgid "A default threshold to apply to all remote destinations not listed in the containing file or any of the referenced files"
msgstr "ایک طے شدہ حد جو اس فائل یا کسی بھی حوالہ دیے گئے فائل میں درج نہ ہونے والے تمام ریموٹ مقاصد پر لاگو ہوگی"

msgid "A threshold to apply to a specific remote destination"
msgstr "ایک حد جو کسی مخصوص ریموٹ مقصد پر لاگو ہوگی"

msgid "A threshold to apply to remote destinations listed in a file"
msgstr "ایک حد جو فائل میں درج ریموٹ مقاصد پر لاگو ہوگی"

msgid "A threshold that if breached will cause the offending remote destination to be recorded in a specified file"
msgstr "ایک حد جس کی تجاوز کرنے پر متجاوز ریموٹ مقصد کا ریکارڈ مخصوص فائل میں درج ہوگا"

msgid "Note: The order of the declarations matters. The first threshold declaration for a given destination (whether explicit or listed in a referenced file) overrides any future thresholds for the same destination, whether explicit or listed in a file. Note: to apply a new filter file, the tunnel must be restarted after the location has been specified in the tunnel manager. Once configured, a definition file can be updated without requiring a restart of the target tunnel, although destinations that are blocked will persist until the tunnel is restarted."
msgstr "نوٹ: بیانوں کی ترتیب اہم ہے۔ کسی مخصوص مقصد کے لیے پہلا حد بیان (چاہے واضح ہو یا حوالہ دیے گئے فائل میں درج ہو) اسی مقصد کی بعد کی ہر حد کو مسترد کر دیتا ہے، چاہے وہ واضح ہو یا فائل میں درج ہو۔ نوٹ: نئی فلٹر فائل لاگو کرنے کے لیے ٹنل مینیجر میں مقام متعین کرنے کے بعد ٹنل کو دوبارہ شروع کرنا ضروری ہے۔ ایک بار ترتیب دے جانے کے بعد تعریف فائل کو اپ ڈیٹ کیا جا سکتا ہے اور ٹنل کے دوبارہ آغاز کی ضرورت نہیں ہوتی، ہاچکہ بلاک شدہ مقاصد ٹنل کے دوبارہ آغاز تک باقی رہتے ہیں۔"

msgid "Thresholds"
msgstr "حدود"

msgid "A threshold is defined by the number of connection attempts a remote destination is permitted to perform over a specified number of seconds before a \"breach\" occurs."
msgstr "حد اس سے متعین ہوتی ہے کہ کسی مخصوص سیکنڈ کے دوران ایک ریموٹ مقصد کو کتنی کنکشن کوششیں کرنے کی اجازت ہے، «تجاوز» ہونے سے پہلے۔"

msgid "A threshold declaration can be expressed in one of the following ways:"
msgstr "حد کا بیان مندرجہ ذیل طریقوں میں سے کسی ایک کے ذریعے بیان کیا جا سکتا ہے:"

msgid "Numeric definition of the number of connection attempts in the period specified (in seconds) e.g. <i class=example>15/5</i>, <i class=example>60/60</i> etc."
msgstr "مخصوص مدت (سیکنڈ میں) میں کنکشن کوششوں کی تعداد کی عددی تعریف مثلاً <i class=example>15/5</i>، <i class=example>60/60</i> وغیرہ۔"

msgid "Note that if the number of connections is 1 (e.g. <i class=example>1/60</i>), the first connection attempt will result in a breach."
msgstr "نوٹ کریں کہ اگر کنکشنز کی تعداد 1 ہو (مثلاً <i class=example>1/60</i>) تو پہلی کنکشن کوشش ہی تجاوز کا نتیجہ دے گی۔"

msgid "The keyword <i class=example>allow</i>. This threshold is never breached, i.e. an infinite number of connection attempts is permitted."
msgstr "کلیدی لفظ <i class=example>allow</i>۔ اس حد کی کبھی تجاوز نہیں ہوتی، یعنی کنکشن کوششوں کی لامحدود تعداد کی اجازت ہے۔"

msgid "The keyword <i class=example>deny</i>. This threshold is always breached, i.e. no connection attempts will be allowed."
msgstr "کلیدی لفظ <i class=example>deny</i>۔ اس حد کی ہمیشہ تجاوز ہوتی ہے، یعنی کوئی کنکشن کوشش اجازت نہیں ملے گی۔"

msgid "Default Threshold"
msgstr "طے شدہ حد"

msgid "The <i class=example>default</i> threshold applies to any remote destination not explicitly listed in the definition or in any of the referenced files. To set a default threshold use the keyword <i class=example>default</i>."
msgstr "<i class=example>default</i> حد ایسے کسی بھی ریموٹ مقصد پر لاگو ہوتی ہے جو تعریف یا کسی بھی حوالہ دیے گئے فائل میں واضح طور پر درج نہیں ہے۔ طے شدہ حد مقرر کرنے کے لیے <i class=example>default</i> کلیدی لفظ استعمال کریں۔"

msgid "The following threshold definition <i class=example>180/60</i> specifies that the same remote destination is allowed to make 179 connection attempts during a 60 second period. If it makes one more attempt within the same period, the threshold will be breached and further connection attempts will be rejected until the end of the period:"
msgstr "مندرجہ ذیل حد کی تعریف <i class=example>180/60</i> یہ بتاتی ہے کہ ایک ہی ریموٹ مقصد کو 60 سیکنڈ کی مدت کے دوران 179 کنکشن کوششیں کرنے کی اجازت ہے۔ اگر وہ اسی مدت میں ایک مزید کوشش کرے تو حد کی تجاوز ہو جائے گی اور مدت کے آخر تک مزید کنکشن کوششیں مسترد کر دی جائیں گی:"

msgid "To allow all unspecified client destinations:"
msgstr "تمام غیر متعین کلائنٹ مقاصد کی اجازت دینے کے لیے:"

msgid "Or to deny all unspecified destinations:"
msgstr "یا تمام غیر متعین مقاصد کو مسترد کرنے کے لیے:"

msgid "Note that there can only be a single reference to the <i class=example>default</i> keyword in a filter file. If unstated, all connections are permitted unless explicitly forbidden. Errors in the filter file will prevent a stopped tunnel from starting, so be sure to double check the syntax before deployment."
msgstr "نوٹ کریں کہ فلٹر فائل میں <i class=example>default</i> کلیدی لفظ کا صرف ایک حوالہ ہو سکتا ہے۔ اگر بیان نہ کیا جائے تو تمام کنکشنز اجازت یافتہ رہتے ہیں جب تک کہ واضح طور پر پابندی نہ لگائی جائے۔ فلٹر فائل کی خرابیاں بند ٹنل کو شروع ہونے سے روکتی ہیں، اس لیے لاگو کرنے سے پہلے نحو ضرور دوبارہ چیک کریں۔"

msgid "Explicit Thresholds"
msgstr "صریح حدود"

msgid "Using the <i class=example>explicit</i> directive, a threshold can be applied to a remote destination listed in the definition itself, with the option to specify custom thresholds for multiple destinations. Remote destinations can also be excluded from the default threshold using the <i class=example>allow</i> keyword, or permanently blocked using the <i class=example>deny</i> keyword:"
msgstr "<i class=example>explicit</i> ڈائریکٹو کے ذریعے کسی ریموٹ مقصد پر حد لاگو کی جا سکتی ہے جو خود تعریف میں درج ہو، اور اس آپشن کے ساتھ چند مقاصد کے لیے حسبِ ضرورت حدود مقرر کی جا سکتی ہیں۔ ریموٹ مقاصد کو <i class=example>allow</i> کلیدی لفظ کے ذریعے طے شدہ حد سے بھی خارج کیا جا سکتا ہے، یا <i class=example>deny</i> کلیدی لفظ کے ذریعے مستقل طور پر بلاک کیا جا سکتا ہے:"

msgid "Bulk Thresholds"
msgstr "اکڑی حدود"

msgid "For convenience you can maintain a list of destinations in a file and define a threshold for all of them in bulk:"
msgstr "سہولت کے لیے آپ فائل میں مقاصد کی فہرست رکھ سکتے ہیں اور سب کے لیے ایک ہی حد مقرر کر سکتے ہیں:"

msgid "Recorders"
msgstr "ریکارڈرز"

msgid "Recorders keep track of connection attempts made by a remote destination, and if that breaches the defined threshold, the destination gets logged in the specified file. Multiple recorders can be specified:"
msgstr "ریکارڈرز ریموٹ مقصد کی کیے گئے کنکشن کوششوں کا ریکارڈ رکھتے ہیں، اور اگر اس سے مقرر کردہ حد کی تجاوز ہو تو مقصد کا ریکارڈ مخصوص فائل میں لاگ ہو جاتا ہے۔ چند ریکارڈر مقرر کیے جا سکتے ہیں:"

msgid "You can use a recorder to log the destinations of aggressive clients to a specified file, and then use that same file to throttle them. The following snippet defines a filter that initially allows all connection requests, but if any single destination exceeds 180 requests in 60 seconds, it gets throttled down to 30 requests every 60 seconds:"
msgstr "آپ سخت کلائنٹس کے مقاصد کو کسی مخصوص فائل میں لاگ کرنے کے لیے ریکارڈر استعمال کر سکتے ہیں، اور پھر ان پر پٹ بندی لگانے کے لیے وہی فائل استعمال کر سکتے ہیں۔ مندرجہ ذیل نمونہ ایسا فلٹر متعین کرتا ہے جو ابتدائی طور پر تمام کنکشن درخواستوں کی اجازت دیتا ہے، لیکن اگر کوئی ایک مقصد 60 سیکنڈ میں 180 سے زیادہ درخواستیں کرے تو اس پر پٹ بندی لگ جاتی ہے اور درخواستیں ہر 60 سیکنڈ میں 30 تک محدود ہو جاتی ہیں:"

msgid "by default there are no limits"
msgstr "طے شدہ طور پر کوئی حد نہیں"

msgid "but log overly aggressive destinations"
msgstr "لیکن حد سے زیادہ سخت مقاصد لاگ کریں"

msgid "and any that end up in that file will get throttled in the future"
msgstr "اور جو بھی اس فائل میں پہنچ جائیں گے آئندہ ان پر پٹ بندی ہوگی"

msgid "To log all unique remote destinations connecting to a server, and also log aggressive connection attempts:"
msgstr "کسی سرور سے منسلک ہونے والے تمام منفرد ریموٹ مقاصد لاگ کرنے کے لیے، اور سخت کنکشن کوششیں بھی لاگ کرنے کے لیے:"

msgid "log all unique destinations"
msgstr "تمام منفرد مقاصد لاگ کریں"

msgid "log visitors making 90 or more connections a minute"
msgstr "فی منٹ 90 یا اس سے زیادہ کنکشنیں کرنے والے وزیٹرز لاگ کریں"

msgid "You can use a recorder in one tunnel that writes to a file that another tunnel, or multiple tunnels, can use for throttling. These files can also be edited by hand."
msgstr "آپ ایک ٹنل میں ریکارڈر استعمال کر سکتے ہیں جو ایسی فائل میں لکھتا ہے جسے دوسرا ٹنل یا چند ٹنلز پٹ بندی کے لیے استعمال کر سکتے ہیں۔ یہ فائلیں ہاتھ سے بھی ترمیم کی جا سکتی ہیں۔"

msgid "The following filter definition applies some throttling by default, no throttling for destinations in the file <i class=example>friends.txt</i>, forbids any connections from destinations in the file <i class=example>enemies.txt</i>, and logs any aggressive behavior in a file called <i class=example>suspicious.txt</i>:"
msgstr "مندرجہ ذیل فلٹر تعریف طے شدہ طور پر کچھ پٹ بندی لاگو کرتی ہے، <i class=example>friends.txt</i> فائل میں درج مقاصد پر کوئی پٹ بندی نہیں، <i class=example>enemies.txt</i> فائل میں درج مقاصد کی ہر کنکشن کو منع کرتی ہے، اور سخت رویہ کو <i class=example>suspicious.txt</i> نامی فائل میں لاگ کرتی ہے:"

msgid "Note that the full path to the output files must be accessible before deploying the filter. If the target directory does not exist, the destinations will not be recorded and an error will appear in the router logs. The files will be created as required. The examples provided above are not recommendations; your configuration should be tuned according to the amount of content (number and size of files) your site is serving, the speed of the server, and the frequency with which the site is updated. Configuring recorders and monitoring the resulting files will help you fine tune the settings."
msgstr "نوٹ کریں کہ فلٹر لاگو کرنے سے پہلے آؤٹ پٹ فائلوں تک پورا راستہ قابلِ رسائی ہونا چاہیے۔ اگر متعین ڈائریکٹری موجود نہ ہو تو مقاصد ریکارڈ نہیں ہوں گے اور روٹر لاگز میں ایک خرابی ظاہر ہوگی۔ فائلیں ضرورت کے مطابق بنا لی جائیں گی۔ اوپر دیے گئے مثالیں تجاویز نہیں ہیں؛ آپ کی ترتیبات آپ کی سائٹ کے فراہم کردہ مواد کے حجم (فائلوں کی تعداد اور حجم)، سرور کی رفتار اور سائٹ کی تازہ کاری کی کثرت کے مطابق ہونی چاہیے۔ ریکارڈرز ترتیب دے کر بننے والی فائلوں کی نگرانی سے ترتیبات کو بہترین بنانے میں مدد ملے گی۔"

msgid "User Interface Help"
msgstr "صارف انٹرفیس مدد"

msgid "Note: Many of the labels and options in the console have tooltips that indicate purpose or explain the meaning. Hover over the label or option to activate the tooltip."
msgstr "نوٹ: کنسول میں بہت سے لیبلز اور آپشنز کے ٹول ٹپ ہیں جو مقصد بتاتے ہیں یا مطلب سمجھاتے ہیں۔ ٹول ٹپ فعال کرنے کے لیے لیبل یا آپشن پر ہوور کریں۔"

msgid "Theme Overrides"
msgstr "تھیم اوور رائیڈز"

msgid "I2P+ supports custom theme overrides for the console, the tunnel manager, I2PSnark, SusiDNS and Susimail, permitting changes to the themes which are persistent after upgrades. In order to activate an override, create a css file named <code>override.css</code> with your theme modifications and place it in the relevant theme directory of the theme you wish to change, or rename one of the example files, and then hard refresh the browser. Note that the tunnel manager and the console share the same override.css. To deactivate an override, delete or rename the <code>override.css</code> file and then hard refresh the browser (usually Control + Shift + R)."
msgstr "I2P+ کنسول، ٹنل مینیجر، I2PSnark، SusiDNS اور Susimail کے لیے حسبِ ضرورت تھیم اوور رائیڈز کی سپورٹ کرتا ہے، جو اپ ڈیٹ کے بعد بھی برقرار رہتے ہیں۔ کوئی اوور رائیڈ فعال کرنے کے لیے اپنی تھیم کی تبدیلیوں کے ساتھ <code>override.css</code> نامی سی ایس ایس فائل بنائیں اور اسے جس تھیم کو بدلنا چاہیتے ہیں اس کی متعلقہ تھیم ڈائریکٹری میں رکھیں، یا مثالی فائلوں میں سے کسی ایک کا نام بدلیں، پھر براؤزر کو ہارڈ ریفریش کریں۔ نوٹ کریں کہ ٹنل مینیجر اور کنسول ایک ہی override.css استعمال کرتے ہیں۔ کوئی اوور رائیڈ غیر فعال کرنے کے لیے <code>override.css</code> فائل حذف کریں یا نام بدلیں، پھر براؤزر کو ہارڈ ریفریش کریں (عام طور پر Control + Shift + R)۔"

msgid "The themes directory is located in the I2P application directory under <code>docs/themes</code>. There are example override files in the console and I2PSnark theme sub-directories."
msgstr "تھیمز ڈائریکٹری I2P ایپلیکیشن ڈائریکٹری کے اندر <code>docs/themes</code> کے نیچے موجود ہے۔ کنسول اور I2PSnark کی تھیم سب ڈائریکٹریز میں مثالی اوور رائیڈ فائلیں موجود ہیں۔"

msgid "Sidebar Information"
msgstr "سائیڈ بار معلومات"

msgid "Many of the stats on the sidebar may be <a href='/configstats'>configured</a> to be <a href='/graphs'>graphed</a> for further analysis. You may also customize the sections that appear on the Sidebar and their positioning on the <a href='/configsidebar'>Sidebar Configuration page</a>."
msgstr "سائیڈ بار پر موجود بہت سے شماریات کو مزید تجزیے کے لیے <a href='/configstats'>ترتیب دیا</a> جا سکتا ہے تاکہ <a href='/graphs'>گراف</a> بنائے جا سکتے ہیں۔ آپ سائیڈ بار پر ظاہر ہونے والے سیکشنز اور ان کی پوزیشن کو <a href='/configsidebar'>سائیڈ بار ترتیب کے صفحے</a> پر حسبِ ضرورت بدل سکتے ہیں۔"

msgid "Local Identity"
msgstr "مقامی شناخت"

msgid "If you hover over the <i>Router Info</i> heading, your truncated router identity will be shown (the first four characters (24 bits) of your 44-character (256-bit) Base64 router hash). The full hash is shown on your <a href='netdb?show=local'>Network Database entry</a>. Never reveal this to anyone, as your router identity is uniquely linked to your IP address in the network database."
msgstr "اگر آپ <i>روٹر انفو</i> ہیڈنگ پر ہوور کریں تو آپ کی مختصر کردہ روٹر شناخت دکھائی دے گی (آپ کے 44 حروف (256 بٹ) کے Base64 روٹر ہیش کے پہلے چار حروف (24 بٹ))۔ مکمل ہیش آپ کے <a href='netdb?show=local'>نیٹ ورک ڈیٹابیس اندراج</a> میں دکھایا جاتا ہے۔ اسے کسی کو بھی ظاہر نہ کریں، کیونکہ آپ کی روٹر شناخت نیٹ ورک ڈیٹابیس میں آپ کے IP پتے سے منفرد طور پر منسلک ہے۔"

msgid "The version of the I2P software you are running. If a new version is available, you will be notified in the Sidebar. It is recommended to keep your router up to date to ensure optimal performance and security. Router updates are usually made available on average every 2-3 months."
msgstr "یہ وہ ورژن ہے جو آپ I2P سافٹ ویئر کے طور پر چلا رہے ہیں۔ اگر نیا ورژن دستیاب ہو تو سائیڈ بار میں آپ کو اطلاع دی جائے گی۔ بہترین کارکردگی اور سیکیورٹی کے لیے اپنے روٹر کو تازہ رکھنے کی تجویز کی جاتی ہے۔ روٹر اپ ڈیٹس اوسط میں ہر 2-3 ماہ میں دستیاب ہوتی ہیں۔"

msgid "The skew (offset) of your computer's clock relative to the network-synced time (if known). I2P requires your computer's time be accurate. If the skew is more than a few seconds, please correct the problem by adjusting your computer's time. If I2P cannot connect to the internet, a reading of 0ms may be indicated. Note: This is only displayed in the <i>Router Information (advanced)</i> section. You may add this section to your Sidebar on the <a href='/configsidebar'>Sidebar Configuration page</a>."
msgstr "یہ آپ کے کمپیوٹر کی گھڑی کا نیٹ ورک سے مطابقت شدہ وقت (اگر معلوم ہو) کے نسبت انحراف (آفسیٹ) ہے۔ I2P کے لیے ضروری ہے کہ آپ کے کمپیوٹر کا وقت درست ہو۔ اگر انحراف کئی سیکنڈ سے زیادہ ہو تو اپنے کمپیوٹر کا وقت بدل کر مسئلہ درست کریں۔ اگر I2P انٹرنیٹ سے منسلک نہیں ہو سکتا تو 0ms کی پڑھائی دکھائی دے سکتی ہے۔ نوٹ: یہ صرف <i>روٹر معلومات (ایڈوانسڈ)</i> سیکشن میں دکھایا جاتا ہے۔ آپ <a href='/configsidebar'>سائیڈ بار ترتیب کے صفحے</a> پر یہ سیکشن اپنے سائیڈ بار میں شامل کر سکتے ہیں۔"

msgid "This indicates the amount of RAM I2P is using, and the total amount available, allocated by Java. If the usage is consistently high relative to the available RAM, this may indicate that you need to increase the ram allocated to the JVM. You can allocate more RAM by editing your <code>wrapper.config</code> file which is normally located in the I2P application directory. You will need to edit the <code>wrapper.java.maxmemory</code> parameter, which by default is set to 256(MB) for I2P, or 384 for I2P+. Note: if the memory bar is enabled, the memory entry in the router info section will be suppressed."
msgstr "یہ بتاتا ہے کہ I2P کتنی RAM استعمال کر رہا ہے اور Java کی تخصیص کردہ کل دستیاب میموری کتنی ہے۔ اگر دستیاب RAM کے مقابلے میں استعمال مسلسل زیادہ ہو تو اس کا مطلب ہو سکتا ہے کہ JVM کو مختص کردہ میموری بڑھانی ہے۔ آپ اپنی <code>wrapper.config</code> فائل میں ترمیم کر کے مزید RAM مختص کر سکتے ہیں جو عام طور پر I2P ایپلیکیشن ڈائریکٹری میں موجود ہوتی ہے۔ آپ کو <code>wrapper.java.maxmemory</code> پیمانے میں ترمیم کرنی پڑے گی، جو طے شدہ طور پر I2P کے لیے 256(MB) اور I2P+ کے لیے 384 پر مقرر ہے۔ نوٹ: اگر میموری بار فعال ہو تو روٹر انفو سیکشن میں میموری کا اندراج دکھایا نہیں جائے گا۔"

msgid "The first number is the number of peers your router has sent or received a message from in the last few minutes. This may range from 8-10 to several hundred, depending on your total bandwidth, shared bandwidth, and locally-generated traffic. The second number is the number of peers seen in the last hour or so. Do not be concerned if these numbers vary widely. <a href='/configstats#router.activePeers'>[Enable graphing]</a>."
msgstr "پہلا نمبر ان peer کی تعداد ہے جن سے آپ کے روٹر نے گزشتہ چند منٹوں میں پیغام بھیجا یا وصول کیا ہے۔ یہ آپ کی کل بینڈ وائٹ، شیئر شدہ بینڈ وائٹ اور مقامی طور پر تیار کردہ ٹریفک کے لحاظ سے 8-10 سے چند سو تک ہو سکتی ہے۔ دوسرا نمبر ان peer کی تعداد ہے جو تقریباً گزشتہ گھنٹے میں دیکھے گئے۔ اگر یہ نمبر بہت زیادہ تبدیل ہوں تو پریشان نہ ہوں۔ <a href='/configstats#router.activePeers'>[گراف فعال کریں]</a>۔"

msgid "This is the number of peers your router has available for building client tunnels. It is generally in the range 8-30. Your fast peers are shown on the <a href='/profiles'>Profiles page</a>. <a href='/configstats#router.fastPeers'>[Enable graphing]</a>"
msgstr "یہ ان peer کی تعداد ہے جو آپ کے روٹر کے پاس کلائنٹ ٹنلز بنانے کے لیے دستیاب ہیں۔ یہ عموماً 8-30 کے درمیان رہتی ہے۔ آپ کے تیز peer <a href='/profiles'>پروفائلیں کے صفحے</a> پر دکھائی دیتے ہیں۔ <a href='/configstats#router.fastPeers'>[گراف فعال کریں]</a>"

msgid "This is the number of peers your router has available for building your exploratory tunnels which are used to determine network performance. It is generally in the range 8-75. The fast peers are included in the high capacity tier. Your high capacity peers are shown on the <a href='/profiles'>Profiles page</a>. <a href='/configstats#router.highCapacityPeers'>[Enable graphing]</a>"
msgstr "یہ ان peer کی تعداد ہے جو آپ کے روٹر کے پاس ایکسپلوریٹری ٹنلز بنانے کے لیے دستیاب ہیں جو نیٹ ورک کی کارکردگی طے کرنے کے لیے استعمال ہوتی ہیں۔ یہ عموماً 8-75 کے درمیان رہتی ہے۔ تیز peer زیادہ گنجائش والے درجے میں شامل ہوتے ہیں۔ آپ کے زیادہ گنجائش والے peer <a href='/profiles'>پروفائلیں کے صفحے</a> پر دکھائی دیتے ہیں۔ <a href='/configstats#router.highCapacityPeers'>[گراف فعال کریں]</a>"

msgid "This is the number of peers your router will use for network database inquiries. These are usually the <i>floodfill</i> routers which are responsible for maintaining network integrity. Your well integrated peers are shown on the bottom of the <a href='/profiles'>Profiles page</a>."
msgstr "یہ ان peer کی تعداد ہے جو آپ کا روٹر نیٹ ورک ڈیٹابیس کی معلومات کے لیے استعمال کرے گا۔ یہ عموماً وہ <i>floodfill</i> روٹرز ہوتے ہیں جو نیٹ ورک کی سالمت ذمہ دار ہوتے ہیں۔ آپ کے اچھی طرح انٹیگریٹڈ peer <a href='/profiles'>پروفائلیں کے صفحے</a> کے نچلے حصے پر دکھائی دیتے ہیں۔"

msgid "This is the total number of peers that are known by your router. They are listed on the <a href='/netdb'>Network Database page</a>. This may range from under 100 to 1000 or more. This number is not the total size of the network; it may vary widely depending on your total bandwidth, shared bandwidth, and locally-generated traffic. I2P does not require a router to know every other router in the network."
msgstr "یہ ان peer کی کل تعداد ہے جو آپ کے روٹر کو معلوم ہیں۔ ان کی فہرست <a href='/netdb'>نیٹ ورک ڈیٹابیس کے صفحے</a> پر درج ہے۔ یہ 100 سے کم سے 1000 یا اس سے زیادہ تک ہو سکتی ہے۔ یہ نمبر نیٹ ورک کے کل حجم کی نمائندگی نہیں کرتا؛ آپ کی کل بینڈ وائٹ، شیئر شدہ بینڈ وائٹ اور مقامی طور پر تیار کردہ ٹریفک کے لحاظ سے اس میں بہت زیادہ تبدیلی آ سکتی ہے۔ I2P کو یہ نہیں کہ ہر روٹر نیٹ ورک کے ہر دوسرے روٹر کو جاننا چاہیے۔"

msgid "Bandwidth In/Out"
msgstr "بینڈ وائٹ اندر / باہر"

msgid "This section indicates your average bandwidth speeds and total usage for the session. All values are in bytes per second. You may change your bandwidth limits on the <a href='/config'>Bandwidth Configuration page</a>. The more bandwidth you make available, the more you help the network and improve your own anonymity, so please take the time to review the settings. If you are unsure of your network's speed, using a service such as <a href='http://speedtest.net/'>SpeedTest</a> or similar will give you a good indication of your bandwidth capability. Your upstream share amount (KBps Out) will determine your overall contribution to the network. Bandwidth is <a href='/graphs'>graphed</a> by default."
msgstr "یہ سیکشن آپ کی اوسط بینڈ وائٹ رفتار اور سیشن کے لیے کل استعمال کو ظاہر کرتا ہے۔ تمام قدریں فی سیکنڈ بائٹس میں ہیں۔ آپ <a href='/config'>بینڈ وائٹ ترتیبات صفحے</a> پر اپنی بینڈ وائٹ کی حدود بدل سکتے ہیں۔ آپ جتنی زیادہ بینڈ وائٹ دستیاب کرائیں گے، نیٹ ورک کی اتنی ہی زیادہ مدد ہوگی اور اپنی گمنیمیت اتنی ہی بہتر ہوگی، اس لیے وقت نکال کر ان ترتیبات کا جائزہ ضرور لیں۔ اگر آپ اپنے نیٹ ورک کی رفتار کے بارے میں مطمئن نہیں ہیں تو <a href='http://speedtest.net/'>SpeedTest</a> یا اسی قسم کی کوئی سروس آپ کی بینڈ وائٹ گنجائش کا اچھا اندازہ دے گی۔ آپ کی اپ سٹریم شیئر کی مقدار (KBps Out) نیٹ ورک میں آپ کی مجموعی شراکت کا تعین کرے گی۔ بینڈ وائٹ طے شدہ طور پر <a href='/graphs'>گراف</a> کی جاتی ہے۔"

msgid "Local Destinations"
msgstr "مقامی مقاصد"

msgid "These are the local services provided by your router. They may be clients started through the <a href='/i2ptunnelmgr'>Tunnel Manager</a> or external programs connecting through SAM, BOB, or directly to I2CP. By default, most of your client services (mail, http proxy, IRC) will share the same set of tunnels and be listed as <i>Shared Clients</i> and <i>Shared Clients(DSA)</i>, which enhances anonymity by blending the traffic from all shared services, and reduces the overhead required to build and maintain tunnels. However, if you experience a tunnel failure, all your services will go offline at the same time, so in some scenarios you may wish to configure client services to use their own set of tunnels. This can be done by unchecking the <i>Share tunnels with other clients&hellip;</i> option listed under <i>Shared Clients</i> on the configuration page of the relevant client service in the Tunnel Manager, after which you will need to restart the client service from the <a href='/i2ptunnelmgr'>main Tunnel Manager page</a>."
msgstr "یہ وہ مقامی سروسز ہیں جو آپ کا روٹر فراہم کرتا ہے۔ یہ <a href='/i2ptunnelmgr'>ٹنل مینیجر</a> کے ذریعے شروع کی گئی کلائنٹس ہو سکتی ہیں یا باہری پروگرام جو SAM، BOB، یا براہِ راست I2CP کے ذریعے منسلک ہوتے ہیں۔ طے شدہ طور پر آپ کی زیادہ تر کلائنٹ سروسز (میل، http پراکسی، IRC) ایک ہی ٹنلز کا مجموعہ شیئر کریں گی اور <i>Shared Clients</i> اور <i>Shared Clients(DSA)</i> کے نام سے درج کی جائیں گی، جو تمام شیئر شدہ سروسز کے ٹریفک کو ملا کر گمنیمیت بڑھاتی ہے اور ٹنلز بنانے و انہیں برقرار رکھنے کے لیے درکار اوور ہیڈ کم کرتی ہے۔ لیکن اگر آپ کو کسی ٹنل کی ناکامی کا سامنا کرنا پڑے تو آپ کی تمام سروسز ایک ہی وقت میں آف لائن ہو جائیں گی، اس لیے کچھ صورتوں میں آپ کلائنٹ سروسز کو اپنے ٹنلز کے الگ مجموعے کے ساتھ ترتیب دینا چاہیں گے۔ یہ اس طرح کیا جا سکتا ہے کہ ٹنل مینیجر میں متعلقہ کلائنٹ سروس کی ترتیبات صفحے پر <i>Shared Clients</i> کے تحت درج <i>Share tunnels with other clients&hellip;</i> آپشن کا ٹک ہٹا دیا جائے، جس کے بعد آپ کو <a href='/i2ptunnelmgr'>مرکزی ٹنل مینیجر صفحے</a> سے کلائنٹ سروس دوبارہ شروع کرنی ہوگی۔"

msgid "The actual tunnels are shown on the <a href='/tunnels'>Tunnels page</a>."
msgstr "اصل ٹنلز <a href='/tunnels'>ٹنلز صفحے</a> پر دکھائی دیتی ہیں۔"

msgid "Tunnels built by your router and used for communication with the floodfill peers, building new tunnels, and testing existing tunnels."
msgstr "آپ کے روٹر کی بنائی ہوئی ٹنلز جو floodfill peer سے رابطے، نئی ٹنلز بنانے اور موجودہ ٹنلز کی جانچ کے لیے استعمال ہوتی ہیں۔"

msgid "Tunnels built by your router for each client's use."
msgstr "آپ کے روٹر کی بنائی ہوئی ٹنلز جو ہر کلائنٹ کے لیے ہیں۔"

msgid "Participating"
msgstr "شرکتی"

msgid "Tunnels built by other routers through your router. This may vary widely depending on network demand, your shared bandwidth, and amount of locally-generated traffic. The recommended method for limiting participating tunnels is to change your share percentage on the <a  href='/config'>Bandwidth Configuration page</a>. You may also limit the total number by setting <code>router.maxParticipatingTunnels=nnn</code> on the <a href='/configadvanced'>Advanced configuration page</a>. <a href='/configstats#tunnel.participatingTunnels'>[Enable graphing]</a>."
msgstr "دوسرے روٹرز کی آپ کے روٹر کے ذریعے بنائی گئی ٹنلز۔ نیٹ ورک کی ضرورت، آپ کی شیئر شدہ بینڈ وائٹ اور مقامی طور پر تیار کردہ ٹریفک کی مقدار کے لحاظ سے یہ بہت بدل سکتی ہیں۔ شریک ٹنلز کو محدود کرنے کا تجویز کردہ طریقہ <a  href='/config'>بینڈ وائٹ ترتیبات صفحے</a> پر اپنا شیئر فیصد بدلنا ہے۔ آپ <a href='/configadvanced'>ایڈوانسڈ ترتیبات صفحے</a> پر <code>router.maxParticipatingTunnels=nnn</code> مقرر کر کے کل تعداد بھی محدود کر سکتے ہیں۔ <a href='/configstats#tunnel.participatingTunnels'>[گراف فعال کریں]</a>۔"

msgid "Share Ratio"
msgstr "شیئر تناسب"

msgid "The number of participating tunnels you route for others, divided by the total number of hops in all your exploratory and client tunnels. A number greater than 1.00 means you are contributing more tunnels to the network than you are using."
msgstr "وہ تعداد شریک ٹنلز کی جن میں آپ دوسروں کے لیے روٹنگ کرتے ہیں، آپ کی تمام ایکسپلوریٹری اور کلائنٹ ٹنلز کے کل ہاپ کی تعداد سے تقسیم ہوتی ہے۔ 1.00 سے زیادہ قدر کا مطلب ہے کہ آپ نیٹ ورک میں اپنے استعمال سے زیادہ ٹنلز فراہم کر رہے ہیں۔"

msgid "Some basic indications of router overload:"
msgstr "روٹر کے اوور لوڈ کی کچھ بنیادی علامتیں:"

msgid "How long jobs are waiting before execution. The job queue is listed on the <a href='/jobs'>Jobs page</a>. Unfortunately, there are several other job queues in the router that may be congested, and their status is not available in the router console. The job lag should generally be zero. If it is consistently higher than 500ms, your computer is very slow, your network is experiencing connectivity issues, or the router has serious problems. <a href='/configstats#jobQueue.jobLag'>[Enable graphing]</a>."
msgstr "کام چلنے سے پہلے کتنے وقت تک انتظار کرتے ہیں۔ کام قطار <a href='/jobs'>کاموں کے صفحے</a> پر درج ہوتی ہے۔ افسوس، روٹر میں کئی دوسری کام قطاریں بھی ہیں جو جھسی ہو سکتی ہیں، اور ان کی حالت روٹر کنسول میں دستیاب نہیں ہوتی۔ کام کی تاخیر عموماً صفر ہونی چاہیے۔ اگر یہ مسلسل 500ms سے زیادہ رہے تو آپ کا کمپیوٹر بہت سست ہے، آپ کے نیٹ ورک میں کنکشن کے مسائل ہو رہے ہیں، یا روٹر میں سنگین خرابیاں ہیں۔ <a href='/configstats#jobQueue.jobLag'>[گراف فعال کریں]</a>۔"

msgid "Message Delay"
msgstr "پیغام کی تاخیر"

msgid "How long an outbound message waits in the queue. This should generally be a few hundred milliseconds or less. If it is consistently higher than 1000ms, your computer is very slow, or you should adjust your bandwidth limits, or your (BitTorrent?) clients may be sending too much data and should have their transmit bandwidth limit reduced. <a href='/configstats#transport.sendProcessingTime'>[Enable graphing]</a> (transport.sendProcessingTime)."
msgstr "آؤٹ بانڈ پیغام قطار میں کتنے وقت تک انتظار کرتا ہے۔ یہ عموماً چند سو ملی سیکنڈ یا اس سے کم ہونا چاہیے۔ اگر یہ مسلسل 1000ms سے زیادہ رہے تو آپ کا کمپیوٹر بہت سست ہے، یا آپ کو اپنی بینڈ وائٹ کی حدود ایڈجسٹ کرنی چاہییں، یا آپ کے (BitTorrent؟) کلائنٹس بہت زیادہ ڈیٹا بھیج رہے ہیں اور ان کی ٹرانسمٹ بینڈ وائٹ کی حد کم کرنی چاہیے۔ <a href='/configstats#transport.sendProcessingTime'>[گراف فعال کریں]</a> (transport.sendProcessingTime)۔"

msgid "This is the number of pending requests from other routers to build a participating tunnel through your router. It should usually be close to zero. If it is consistently high, your computer is too slow, and you should reduce your share bandwidth limits."
msgstr "یہ دوسرے روٹرز سے آپ کے روٹر کے ذریعے شریک ٹنل بنانے کی زیر التوا درخواستوں کی تعداد ہے۔ یہ عموماً صفر کے قریب ہونی چاہیے۔ اگر یہ مسلسل زیادہ رہے تو آپ کا کمپیوٹر بہت سست ہے، اور آپ کو اپنی شیئر بینڈ وائٹ کی حدود کم کرنی چاہییں۔"

msgid "Accepting/Rejecting"
msgstr "قبول کرنا / مسترد کرنا"

msgid "Your router's status on accepting or rejecting requests from other routers to build a participating tunnel through your router. Your router may accept all requests, accept or reject a percentage of requests, or reject all requests for a number of reasons, to control the bandwidth and CPU demands and maintain capacity for local clients. <b>Note"
msgstr "دوسرے روٹرز سے آپ کے روٹر کے ذریعے شریک ٹنل بنانے کی درخواستیں قبول یا مسترد کرنے پر آپ کے روٹر کی حالت۔ بینڈ وائٹ اور CPU کی ضروریات کو کنٹرول کرنے اور مقامی کلائنٹس کے لیے گنجائش برقرار رکھنے کے لیے آپ کا روٹر تمام درخواستیں قبول کر سکتا ہے، درخواستوں کا ایک حصہ قبول یا مسترد کر سکتا ہے، یا کئی وجوہات کی بنا پر تمام درخواستیں مسترد کر سکتا ہے۔ <b>نوٹ"

msgid "It will take at least 10 minutes from your router starting for it to accept building participating tunnels in order to ensure your router is stable and successfully bootstrapped to the network."
msgstr "یہ یقینی بنانے کے لیے کہ آپ کا روٹر مستحکم ہے اور نیٹ ورک میں کامیابی سے ابتدائی جگہ بنا چکا ہے، آپ کے روٹر کے شروع ہونے کے بعد کم از کم 10 منٹ لگیں گے اس سے پہلے کہ وہ شریک ٹنلز بنانا قبول کرے۔"

msgid "<b>Note"
msgstr "<b>نوٹ"

msgid "This section is not enabled by default unless <a href='/help/configuration#advancedconsole'>Advanced Console mode</a> is enabled. You may enable it on the <a href='/configsidebar'>Sidebar Configuration page</a>."
msgstr "جب تک <a href='/help/configuration#advancedconsole'>ایڈوانسڈ کنسول موڈ</a> فعال نہ ہو، یہ سیکشن طے شدہ طور پر فعال نہیں ہوتا۔ آپ اسے <a href='/configsidebar'>سائیڈ بار ترتیب کے صفحے</a> پر فعال کر سکتے ہیں۔"

msgid "Reachability Help"
msgstr "رسائی کی مدد"

msgid "If you think you have opened up your firewall and I2P still thinks you are firewalled, remember that you may have multiple firewalls, for example both software packages and external hardware routers."
msgstr "اگر آپ کو لگتا ہے کہ آپ نے اپنی فائر وال کھول دی ہے لیکن I2P اب بھی آپ کو فائر وال سمجھتا ہے تو یاد رکھیں کہ آپ کے پاس کئی فائر وال ہو سکتی ہیں، مثلاً سافٹ ویئر پیکجز اور باہری ہارڈ ویئر روٹرز دونوں۔"

msgid "If there is an error, the <a href=\"/logs\">logs</a> may also help diagnose the problem."
msgstr "اگر کوئی خرابی ہو تو <a href=\"/logs\">لاگز</a> مسئلے کی تشخیص میں بھی مدد کر سکتے ہیں۔"

msgid "Your UDP port does not appear to be firewalled."
msgstr "آپ کا UDP پورٹ فائر وال نہیں لگتا۔"

msgid "Firewalled"
msgstr "فائر وال"

msgid "Your UDP port appears to be firewalled."
msgstr "آپ کا UDP پورٹ فائر وال لگتا ہے۔"

msgid "As the firewall detection methods are not 100% reliable, this may occasionally be displayed in error."
msgstr "چونکہ فائر وال کی تشخیص کے طریقے 100% قابلِ اعتماد نہیں ہیں، اس لیے کبھی کبھی یہ غلطی سے دکھایا جاتا ہے۔"

msgid "However, if it appears consistently, you should check whether both your external and internal firewalls are open for your port."
msgstr "لیکن اگر یہ مسلسل دکھائی دے تو آپ کو چیک کرنا چاہیے کہ آپ کی باہری اور اندرونی دونوں فائر وال آپ کے پورٹ کے لیے کھلی ہیں یا نہیں۔"

msgid "I2P will work fine when firewalled, there is no reason for concern. When firewalled, the router uses \"introducers\" to relay inbound connections."
msgstr "فائر وال کے باوجود I2P اچھا کام کرے گا، فکر کرنے کی کوئی وجہ نہیں۔ فائر وال ہونے کی صورت میں روٹر اندرونی کنکشنز ریلے کرنے کے لیے «introducers» استعمال کرتا ہے۔"

msgid "However, you will get more participating traffic and help the network if you open your firewall."
msgstr "لیکن اگر آپ اپنی فائر وال کھولیں تو آپ کو زیادہ شرکتی ٹریفک ملے گا اور نیٹ ورک کی مدد ہوگی۔"

msgid "If you think you have already done so, remember that you may have both a hardware and a software firewall, or be behind an additional, institutional firewall you cannot control."
msgstr "اگر آپ کو لگتا ہے کہ آپ نے پہلے ہی یہ کر دیا ہے تو یاد رکھیں کہ آپ کے پاس ہارڈ ویئر اور سافٹ ویئر دونوں قسم کی فائر وال ہو سکتی ہے، یا آپ ایک اضافی اداری فائر وال کے پیچھے ہو سکتے ہیں جسے آپ کنٹرول نہیں کر سکتے۔"

msgid "Also, some routers cannot correctly forward both TCP and UDP on a single port, or may have other limitations or bugs that prevent them from passing traffic through to I2P."
msgstr "نیز، کچھ روٹرز ایک ہی پورٹ پر TCP اور UDP دونوں کو درست طریقے سے فارورڈ نہیں کر سکتے، یا ان میں دوسری حدود یا خرابیاں ایسی ہیں جو I2P تک ٹریفک بھیجنے سے روکتی ہیں۔"

msgid "The router is currently testing whether your UDP port is firewalled."
msgstr "روٹر ابھی یہ جانچ رہا ہے کہ آپ کا UDP پورٹ فائر وال ہے یا نہیں۔"

msgid "The router is not configured to publish its address, therefore it does not expect incoming connections."
msgstr "روٹر اپنا پتہ شائع کرنے کے لیے ترتیب شدہ نہیں ہے، اس لیے اس آنے والی کنکشنز کا انتظار نہیں کرتا۔"

msgid "Hidden mode is automatically enabled for added protection in certain countries."
msgstr "کچھ ممالک میں زیادہ حفاظت کے لیے چھپی ہوئی حالت خودکار طور پر فعال ہو جاتی ہے۔"

msgid "WARN - Firewalled and Fast"
msgstr "انتباہ - فائر وال اور تیز"

msgid "You have configured I2P to share more than 128KBps of bandwidth, but you are firewalled."
msgstr "آپ نے I2P کو 128KBps سے زیادہ بینڈ وائٹ شیئر کرنے کے لیے ترتیب دیا ہے، لیکن آپ فائر وال ہیں۔"

msgid "While I2P will work fine in this configuration, if you really have over 128KBps of bandwidth to share, it will be much more helpful to the network if you open your firewall."
msgstr "اس ترتیب میں I2P اچھا کام کرے گا، لیکن اگر واقعی آپ کے پاس شیئر کرنے کے لیے 128KBps سے زیادہ بینڈ وائٹ ہے تو فائر وال کھولنے سے نیٹ ورک کو کہیں زیادہ فائدہ ہوگا۔"

msgid "WARN - Firewalled and Floodfill"
msgstr "انتباہ - فائر WALL اور Floodfill"

msgid "You have configured I2P to be a floodfill router, but you are firewalled."
msgstr "آپ نے I2P کو floodfill روٹر بنانے کے لیے ترتیب دیا ہے، لیکن آپ فائر WALL ہیں۔"

msgid "For best participation as a floodfill router, you should open your firewall."
msgstr "floodfill روٹر کے طور پر بہترین شراکت کے لیے آپ کو اپنی فائر WALL کھولنی چاہیے۔"

msgid "WARN - Firewalled with Inbound TCP Enabled"
msgstr "انتباہ - اندرونی TCP فعال کے ساتھ فائر WALL"

msgid "You have configured inbound TCP, however your UDP port is firewalled, and therefore it is likely that your TCP port is firewalled as well."
msgstr "آپ نے اندرونی TCP ترتیب دیا ہے، لیکن آپ کا UDP پورٹ فائر WALL ہے، اور اس لیے بعامل ممکن ہے آپ کا TCP پورٹ بھی فائر WALL ہو۔"

msgid "If your TCP port is firewalled with inbound TCP enabled, routers will not be able to contact you via TCP, which will hurt the network."
msgstr "اگر اندرونی TCP فعال ہونے کے باوجود آپ کا TCP پورٹ فائر WALL ہے تو روٹرز آپ سے TCP کے ذریعے رابطہ نہیں کر سکیں گے، جو نیٹ ورک کے لیے نقصان دہ ہوگا۔"

msgid "Please open your firewall or disable inbound TCP above."
msgstr "براہِ کرم اپنی فائر WALL کھولیں یا اوپر اندرونی TCP غیر فعال کریں۔"

msgid "WARN - Firewalled with UDP Disabled"
msgstr "انتباہ - UDP غیر فعال کے ساتھ فائر WALL"

msgid "You have configured inbound TCP, however you have disabled UDP."
msgstr "آپ نے اندرونی TCP ترتیب دیا ہے، لیکن آپ نے UDP غیر فعال کر دیا ہے۔"

msgid "You appear to be firewalled on TCP, therefore your router cannot accept inbound connections."
msgstr "آپ کا TCP فائر WALL ہونا لگتا ہے، اس لیے آپ کا روٹر اندرونی کنکشنز قبول نہیں کر سکتا۔"

msgid "Please open your firewall or enable UDP."
msgstr "براہِ کرم اپنی فائر WALL کھولیں یا UDP فعال کریں۔"

msgid "ERR - Clock Skew"
msgstr "خرابی - گھڑی کا انحراف"

msgid "Your system's clock is skewed, which will make it difficult to participate in the network."
msgstr "آپ کے سسٹم کی گھڑی میں انحراف ہے، جس سے نیٹ ورک میں شرکت مشکل ہو جائے گی۔"

msgid "Correct your clock setting if this error persists."
msgstr "اگر یہ خرابی برقرار رہے تو اپنی گھڑی کی ترتیب درست کریں۔"

msgid "ERR - Private TCP Address"
msgstr "خرابی - نجی TCP پتہ"

msgid "You must never advertise an unroutable IP address such as 127.0.0.1 or 192.168.1.1 as your external address."
msgstr "آپ کو کبھی ایسا غیر قابلِ راستہ IP پتہ اعلان نہیں کرنا چاہیے جیسے 127.0.0.1 یا 192.168.1.1، بطور اپنا باہری پتہ۔"

msgid "Correct the address or disable inbound TCP on the Network Configuration page."
msgstr "پتہ درست کریں یا نیٹ ورک ترتیبات صفحے پر اندرونی TCP غیر فعال کریں۔"

msgid "ERR - SymmetricNAT"
msgstr "خرابی - SymmetricNAT"

msgid "I2P detected that you are firewalled by a Symmetric NAT."
msgstr "I2P نے پایا کہ آپ ایک سمیٹرک NAT کے پیچھے فائر WALL ہیں۔"

msgid "I2P does not work well behind this type of firewall. You will probably not be able to accept inbound connections, which will limit your participation in the network."
msgstr "اس قسم کی فائر WALL کے پیچھے I2P اچھا کام نہیں کرتا۔ آپ شاید اندرونی کنکشنز قبول نہ کر سکیں، جو آپ کی نیٹ ورک میں شراکت کو محدود کرے گی۔"

msgid "ERR - UDP Port In Use - Set i2np.udp.internalPort=xxxx in advanced config and restart"
msgstr "خرابی - UDP پورٹ زیر استعمال - ایڈوانسڈ ترتیبات میں i2np.udp.internalPort=xxxx مقرر کریں اور دوبارہ شروع کریں"

msgid "I2P was unable to bind to the configured port noted on the advanced network configuration page ."
msgstr "I2P ایڈوانسڈ نیٹ ورک ترتیبات صفحے پر درج مقرر کردہ پورٹ سے باندھا نہیں جا سکا۔"

msgid "Check to see if another program is using the configured port. If so, stop that program or configure I2P to use a different port."
msgstr "چیک کریں کہ کیا کوئی دوسرا پروگرام مقرر کردہ پورٹ استعمال کر رہا ہے۔ اگر ہاں تو اس پروگرام کو روکیں یا I2P کو کسی دوسرے پورٹ کے لیے ترتیب دیں۔"

msgid "This may be a transient error, if the other program is no longer using the port."
msgstr "اگر دوسرا پروگرام اب پورٹ استعمال نہیں کر رہا تو یہ عارضی خرابی ہو سکتی ہے۔"

msgid "However, a restart is always required after this error."
msgstr "لیکن اس خرابی کے بعد دوبارہ شروع کرنا ہمیشہ ضروری ہے۔"

msgid "ERR - UDP Disabled and Inbound TCP host/port not set"
msgstr "خرابی - UDP غیر فعال اور اندرونی TCP ہوسٹ / پورٹ مقرر نہیں"

msgid "You have not configured inbound TCP with a hostname and port on the Network Configuration page, however you have disabled UDP."
msgstr "آپ نے نیٹ ورک ترتیبات صفحے پر اندرونی TCP کو ہوسٹ نیم اور پورٹ کے ساتھ ترتیب نہیں دی، لیکن آپ نے UDP غیر فعال کر دیا ہے۔"

msgid "Therefore your router cannot accept inbound connections."
msgstr "اس لیے آپ کا روٹر اندرونی کنکشنز قبول نہیں کر سکتا۔"

msgid "Please configure a TCP host and port on the Network Configuration page or enable UDP."
msgstr "براہِ کرم نیٹ ورک ترتیبات صفحے پر TCP ہوسٹ اور پورٹ ترتیب دیں یا UDP فعال کریں۔"

msgid "ERR - Client Manager I2CP Error - check logs"
msgstr "خرابی - کلائنٹ مینیجر I2CP خرابی - لاگز چیک کریں"

msgid "This is usually due to a port 7654 conflict. Check the logs to verify."
msgstr "یہ عموماً 7654 پورٹ کی تصادم کی وجہ سے ہوتا ہے۔ تصدیق کے لیے لاگز چیک کریں۔"

msgid "Do you have another I2P instance running? Stop the conflicting program and restart I2P."
msgstr "کیا کوئی دوسرا I2P انسٹنس چل رہا ہے؟ متعارض پروگرام کو روکیں اور I2P دوبارہ شروع کریں۔"

msgid "The skew (offset) of your computer's clock relative to the network-synced time."
msgstr "یہ آپ کے کمپیوٹر کی گھڑی کا نیٹ ورک سے مطابقت شدہ وقت کے نسبت انحراف (آفسیٹ) ہے۔"

msgid "I2P requires your computer's time be accurate."
msgstr "I2P کے لیے ضروری ہے کہ آپ کے کمپیوٹر کا وقت درست ہو۔"

msgid "If the skew is more than a few seconds, please correct the problem by adjusting your computer's time."
msgstr "اگر انحراف کئی سیکنڈ سے زیادہ ہو تو اپنے کمپیوٹر کا وقت بدل کر مسئلہ درست کریں۔"

msgid "If I2P cannot connect to the internet, a reading of 0ms may be indicated."
msgstr "اگر I2P انٹرنیٹ سے منسلک نہیں ہو سکتا تو 0ms کی پڑھائی دکھائی دے سکتی ہے۔"

msgid "Web hosting on I2P"
msgstr "I2P پر ویب ہوسٹنگ"

msgid "Introduction to Hosting Websites on I2P"
msgstr "I2P پر ویب سائٹس ہوسٹ کرنے کا تعارف"

msgid "By default, I2P is supplied with a webserver to host your own anonymized website (traditionally referred to as an <i>eepsite</i>). Both the site and the I2P Router Console are running on a streamlined version of <a href='https://en.wikipedia.org/wiki/Jetty_(web_server)' target=_blank rel=noreferrer class='sitelink external'>Jetty</a>, customized for I2P."
msgstr "طے شدہ طور پر I2P ایک ویب سرور کے ساتھ فراہم کیا جاتا ہے تاکہ آپ اپنی گمنیم ویب سائٹ میزبان کر سکیں (روایتی طور پر اسے <i>eepsite</i> کہا جاتا ہے)۔ سائٹ اور I2P روٹر کنسول دونوں <a href='https://en.wikipedia.org/wiki/Jetty_(web_server)' target=_blank rel=noreferrer class='sitelink external'>Jetty</a> کے ایک ہلکے ورژن پر چلتے ہیں جو I2P کے لیے مخصوص ہے۔"

msgid "To serve your own static content, you only need to edit or replace the files in the webserver's root directory, and the site will be available on the I2P network after you've followed the instructions below. Additionally, cgi and python scripts can be run from the <code>cgi-bin</code> directory immediately above <code>docroot</code> if you have <a href=https://www.perl.org/about.html target=_blank rel=noreferrer class='sitelink external'>perl</a> and <a href=https://www.python.org/ target=_blank rel=noreferrer class='sitelink external'>python</a> installed."
msgstr "اپنا سٹیٹک مواد فراہم کرنے کے لیے آپ کو صرف ویب سرور کی روٹ ڈائریکٹری کی فائلیں ترمیم یا بدلنی ہیں، اور نیچے دی گئی ہدایات پر عمل کرنے کے بعد سائٹ I2P نیٹ ورک پر دستیاب ہو جائے گی۔ نیز، اگر آپ کے پاس <a href=https://www.perl.org/about.html target=_blank rel=noreferrer class='sitelink external'>perl</a> اور <a href=https://www.python.org/ target=_blank rel=noreferrer class='sitelink external'>python</a> انسٹال ہوں تو <code>docroot</code> سے فوراً اوپر موجود <code>cgi-bin</code> ڈائریکٹری سے cgi اور python اسکرپٹس بھی چلائے جا سکتے ہیں۔"

msgid "Directory listings (sometimes referred to as virtual directories) are enabled by default, so you can host files from a sub-directory of <code>docroot</code> without providing a page with links to the files. You can also serve content that exists outside of <code>docroot</code> by using a <a href=https://en.wikipedia.org/wiki/Symbolic_link target=_blank rel=noreferrer class='sitelink external'>symbolic link</a> to the desired directory."
msgstr "ڈائریکٹری فہرستیں (کبھی کبھی ورچوئل ڈائریکٹری کہا جاتا ہے) طے شدہ طور پر فعال ہوتی ہیں، اس لیے آپ فائلوں کے لنکس دینے والا صفحہ فراہم کیے بغیر <code>docroot</code> کی ذیلی ڈائریکٹری سے فائلیں میزبان کر سکتے ہیں۔ آپ مطلوبہ ڈائریکٹری کے لیے <a href=https://en.wikipedia.org/wiki/Symbolic_link target=_blank rel=noreferrer class='sitelink external'>symbolic link</a> استعمال کر کے <code>docroot</code> سے باہر موجود مواد بھی فراہم کر سکتے ہیں۔"

msgid "You can override the <a href=http://127.0.0.1:7658/help/images/>default appearance</a> of the directory listing by supplying an edited <a href=http://127.0.0.1:7658/.resources/jetty-dir.css>jetty-dir.css</a> file to set a global appearance. Note that this file will not be displayed in the webserver's directory listing. Files and directories prefixed with . and files named favicon.ico or files ending with ~ or .bak or .old will also be hidden from view (though still accessible). Note: To create hidden files with a . prefix on Windows, add a trailing . to the file or directory e.g. <code>.hidden.</code>; Windows explorer will then save the file with the correct name, removing the trailing dot in the process."
msgstr "آپ ڈائریکٹری فہرست کا <a href=http://127.0.0.1:7658/help/images/>طے شدہ ظاہری شکل</a> بدل سکتے ہیں، اس کے لیے عالمی ظاہری شکل قائم کرنے کے لیے ترمیم شدہ <a href=http://127.0.0.1:7658/.resources/jetty-dir.css>jetty-dir.css</a> فائل فراہم کریں۔ نوٹ کریں کہ یہ فائل ویب سرور کی ڈائریکٹری فہرست میں دکھائی نہیں دے گی۔ . سے شروع ہونے والی فائلیں اور ڈائریکٹریاں، favicon.ico نامی فائلیں یا ~ ، .bak یا .old پر ختم ہونے والی فائلیں بھی نظر سے چھپی رہیں گی (اگرچہ رسائی موجود رہے گی)۔ نوٹ: Windows پر . سے شروع ہونے والی چھپی ہوئی فائلیں بنانے کے لیے فائل یا ڈائریکٹری کے آخر میں . شامل کریں مثلاً <code>.hidden.</code>؛ Windows ایکسپلورر پھر فائل کو صحیح نام کے ساتھ محفوظ کرے گا اور اس عمل میں آخری نقطہ ہٹا دے گا۔"

msgid "To disable directory listings, find the entry for <code>org.eclipse.jetty.servlet.Default.dirAllowed</code> in the <code>base-context.xml</code> file, located in the <code>eepsite/contexts</code> folder (just above docroot folder), and change 'true' to 'false' immediately underneath. To apply the change immediately, stop and restart the <i>I2P Webserver</i> client on the <a href=/configclients>Client Configuration page</a>. You can also drop an empty <code>index.html</code> file in any exposed directory to suppress directory listings for that location."
msgstr "ڈائریکٹری فہرستیں غیر فعال کرنے کے لیے <code>eepsite/contexts</code> فولڈر میں موجود <code>base-context.xml</code> فائل (جو docroot فولڈر سے فوراً اوپر ہے) میں <code>org.eclipse.jetty.servlet.Default.dirAllowed</code> کا اندراج تلاش کریں اور اس کے فوراً نیچے 'true' کو 'false' میں بدل دیں۔ تبدیلی فوراً لاگو کرنے کے لیے <a href=/configclients>کلائنٹ ترتیبات صفحے</a> پر <i>I2P ویب سرور</i> کلائنٹ کو روکیں اور دوبارہ شروع کریں۔ آپ کسی بھی کھلی ڈائریکٹری میں ایک خالی <code>index.html</code> فائل رکھ کے اس مقام کی ڈائریکٹری فہرستیں بھی روک سکتے ہیں۔"

msgid "Location of the I2P webserver root directory"
msgstr "I2P ویب سرور کی روٹ ڈائریکٹری کا مقام"

msgid "Standard Java installation"
msgstr "معیاری Java انسٹالیشن"

msgid "Package/repository installation"
msgstr "پیکیج / ریپازٹری انسٹالیشن"

msgid "On the I2P network, remotely hosted services can be accessed using a <a href=https://en.wikipedia.org/wiki/Base32 target=_blank rel=noreferrer class='sitelink external'>Base32</a> address ending in \".b32.i2p\", a <i>destination</i> represented as a long <a href=https://en.wikipedia.org/wiki/Base64 class='sitelink external'>Base64</a> string, or more usually by using an .i2p domain. A destination is I2P's equivalent to an IP address, and is shown on the <a href='/i2ptunnel/edit?tunnel=3'>Tunnel Manager Configuration page</a>. You can share your b32.i2p address to allow others to access to your website until you've registered your own .i2p domain."
msgstr "I2P نیٹ ورک پر ریموٹ طور پر میزبان شدہ سروسز تک رسائی <a href=https://en.wikipedia.org/wiki/Base32 target=_blank rel=noreferrer class='sitelink external'>Base32</a> پتے سے ہو سکتی ہے جو \".b32.i2p\" پر ختم ہوتا ہے، لمبے <a href=https://en.wikipedia.org/wiki/Base64 class='sitelink external'>Base64</a> سٹرنگ کے طور پر ظاہر کیے گئے <i>مقصد</i> کے ذریعے، یا زیادہ تر ایک .i2p ڈومین استعمال کر کے۔ مقصد I2P میں IP پتے کا ہمتبادل ہے، اور <a href='/i2ptunnel/edit?tunnel=3'>ٹنل مینیجر ترتیبات صفحے</a> پر دکھایا جاتا ہے۔ آپ اپنا b32.i2p پتہ شیئر کر سکتے ہیں تاکہ دوسرے آپ کی ویب سائٹ تک رسائی حاصل کر سکیں، یہاں تک کہ آپ اپنا .i2p ڈومین رجسٹر نہ کر لیں۔"

msgid "Setting up &amp; announcing your website"
msgstr "اپنی ویب سائٹ کی ترتیب &amp; اعلان"

msgid "Your webserver is running by default at <a href=http://127.0.0.1:7658/>http://127.0.0.1:7658</a>, but is not accessible by others until you start the <i>I2P Webserver</i> tunnel. After starting the tunnel, your site will be difficult for other people to find. You could just tell people the destination or the Base32 address, but thankfully I2P has an address book to store domain names, and various services where you can <a href=/help/hostnameregistration>register a new .i2p domain</a> for free."
msgstr "آپ کا ویب سرور طے شدہ طور پر <a href=http://127.0.0.1:7658/>http://127.0.0.1:7658</a> پر چلتا ہے، لیکن جب تک آپ <i>I2P ویب سرور</i> ٹنل شروع نہیں کرتے، دوسرے اس تک رسائی حاصل نہیں کر سکتے۔ ٹنل شروع کرنے کے بعد آپ کی سائٹ دوسروں کے لیے تلاش کرنا مشکل ہو جائے گا۔ آپ لوگوں کو مقصد یا Base32 پتہ بتا سکتے ہیں، لیکن خوش قسمتی سے I2P کے پاس ڈومین نیم ذخیرہ کرنے کے لیے ایک پتہ کتاب ہے، اور کئی سروسز بھی جن میں آپ مفت میں <a href=/help/hostnameregistration>نیا .i2p ڈومین رجسٹر</a> کر سکتے ہیں۔"

msgid "Choose a name for your website (<i>hostname</i>.i2p), using lower-case. To verify that the hostname is available, check <a href=http://notbob.i2p/ target=_blank>notbob.i2p</a> or <a href=http://reg.i2p target=_blank>reg.i2p</a> before you decide. Enter the new name for your website on the <a href='/i2ptunnel/edit?tunnel=3'>Tunnel Manager Configuration page</a> where it says <i>Website name</i>, replacing the default <i>mysite.i2p</i> placeholder. If you want your website to be available when I2P starts, enable <i>Auto Start</i> and then click <i>Save</i>."
msgstr "اپنی ویب سائٹ کے لیے نام منتخب کریں (<i>hostname</i>.i2p)، سب چھوٹے حروف میں۔ یہ جانچنے کے لیے کہ ہوسٹ نیم دستیاب ہے، فیصلہ کرنے سے پہلے <a href=http://notbob.i2p/ target=_blank>notbob.i2p</a> یا <a href=http://reg.i2p target=_blank>reg.i2p</a> چیک کریں۔ <a href='/i2ptunnel/edit?tunnel=3'>ٹنل مینیجر ترتیبات صفحے</a> پر جہاں <i>ویب سائٹ کا نام</i> لکھا ہے وہاں اپنی ویب سائٹ کا نئے نام درج کریں اور طے شدہ <i>mysite.i2p</i> پلیس ہولڈر کی جگہ لے لیں۔ اگر آپ چاہتے ہیں کہ I2P شروع ہونے پر آپ کی ویب سائٹ دستیاب ہو تو <i>خودکار شروع</i> فعال کریں اور پھر <i>محفوظ کریں</i> پر کلک کریں۔"

msgid "Click the <i>Start</i> button for your webserver tunnel on the <a href=/i2ptunnelmgr/>main Tunnel Manager page</a>. You should now see it listed under <i>Service Tunnels</i> on the <a href=/>Router Console</a> sidebar. A green star displayed next to the tunnel name (<i>I2P Webserver</i> by default) indicates that your website is active on the I2P network."
msgstr "<a href=/i2ptunnelmgr/>مرکزی ٹنل مینیجر صفحے</a> پر اپنے ویب سرور ٹنل کے لیے <i>شروع کریں</i> بٹن پر کلک کریں۔ اب آپ کو <a href=/>روٹر کنسول</a> سائیڈ بار میں <i>سروس ٹنلز</i> کے تحت اسے درج دکھائی دے گا۔ ٹنل کے نام کے ساتھ دکھائی دینے والا سبز ستارہ (طے شدہ طور پر <i>I2P ویب سرور</i>) ظاہر کرتا ہے کہ آپ کی ویب سائٹ I2P نیٹ ورک پر فعال ہے۔"

msgid "Highlight and copy the entire <i>Local destination</i> on the <a href='/i2ptunnel/edit?tunnel=3'>Tunnel Manager Configuration page</a>."
msgstr "<a href='/i2ptunnel/edit?tunnel=3'>ٹنل مینیجر ترتیبات صفحے</a> پر مکمل <i>مقامی مقصد</i> کو منتخب کریں اور کاپی کریں۔"

msgid "Enter the name and paste the destination into your <a href='/dns?book=router&amp;filter=none'>address book</a>. Click <i>Add</i> to save the new entry."
msgstr "نام درج کریں اور مقصد کو اپنی <a href='/dns?book=router&amp;filter=none'>پتہ کتاب</a> میں پیسٹ کریں۔ نئے اندراج محفوظ کرنے کے لیے <i>شامل کریں</i> پر کلک کریں۔"

msgid "In the web browser you have configured for I2P usage, browse to your website name (<i>chosenhostname</i>.i2p) and you should be returned to this page."
msgstr "اپنے براؤزر میں، جسے آپ نے I2P کے لیے ترتیب دیا ہے، اپنے ویب سائٹ نام (<i>chosenhostname</i>.i2p) تک جائیں اور آپ کو یہی صفحہ واپس ملنا چاہیے۔"

msgid "Before you tell the world about your new website, you should add some content. Go to the server's root directory <a href=#rootdir>listed above</a> and replace the <i>index.html</i> redirect page with your own content. If you need a template for a basic site, feel free to adapt <a href=http://127.0.0.1:7658/help/pagetemplate.html>this page</a>. If you're returned to this page after editing the content, try clearing your browser's web cache."
msgstr "دنیا کو اپنی نئی ویب سائٹ کے بارے میں بتانے سے پہلے آپ کو کچھ مواد شامل کرنا چاہیے۔ اوپر <a href=#rootdir>درج کردہ</a> سرور کی روٹ ڈائریکٹری پر جائیں اور <i>index.html</i> ری ڈائریکٹ صفحے کی جگہ اپنا مواد رکھ دیں۔ اگر آپ کو بنیادی سائٹ کے لیے ٹیمپلیٹ چاہیے تو <a href=http://127.0.0.1:7658/help/pagetemplate.html>یہ صفحہ</a> اپنے مطابق ڈھال لیں۔ اگر مواد میں ترمیم کے بعد آپ کو یہی صفحہ واپس ملے تو اپنے براؤزر کا ویب کیش صاف کرنے کی کوشش کریں۔"

msgid "Content Optimization"
msgstr "مواد کا بہتر بنانا"

msgid "In order to provide the best experience for visitors to your site, there are various additional steps you may wish to consider once your site is up and running:"
msgstr "اپنی سائٹ آنے والوں کو بہترین تجربہ دینے کے لیے، سائٹ چل پڑنے کے بعد آپ کئی اضافی قدم غور کرنا چاہیں گے:"

msgid "Optimize your images"
msgstr "اپنی تصاویر بہتر بنائیں"

msgid "If you want your site to feel responsive, image compression is essential when hosting large images. Using a service like <a href=https://tinypng.com/ target=_blank class='sitelink external'>tinypng.com</a> to compress your png and jpeg images will often result in much smaller files with minimal loss of quality. In some situations the webp format can best jpegs, generating smaller files with approximately the same or better visual fidelity, and has wide browser support. Also consider using svgs instead of bitmaps for icons and illustrations - they're often smaller than the equivalent bitmap file (run them through a service like <a href=https://vecta.io/nano target=_blank class='sitelink external'>Nano SVG Optimizer</a> to remove unneeded cruft), scale without loss of quality, and can be gzipped by your webserver."
msgstr "اگر آپ اپنی سائٹ کو جوابی محسوس کرانا چاہتے ہیں تو بڑی تصاویر میزبان کرتے وقت تصویر کا کمپریشن انتہائی ضروری ہے۔ اپنی png اور jpeg تصاویر کمپریم کرنے کے لیے <a href=https://tinypng.com/ target=_blank class='sitelink external'>tinypng.com</a> جیسی سروس استعمال کرنے سے اکثر معیار کی ناقابلِ نظر کمی کے ساتھ کہیں چھوٹی فائلیں ملتی ہیں۔ کچھ صورتوں میں webp فارمیٹ jpeg سے بہتر رہتا ہے، کم فائلیں بناتا ہے جن کی بصری وفاداری تقریباً برابر یا بہتر ہوتی ہے، اور اس کی وسیع براؤزر معاونت ہے۔ آئیکنز اور تصویرات کے لیے bitmap کے بجائے svg استعمال کرنے پر بھی غور کریں - یہ اکثر ملتے bitmap فائل سے کہیں چھوٹے ہوتے ہیں (<a href=https://vecta.io/nano target=_blank class='sitelink external'>Nano SVG Optimizer</a> جیسی سروس سے گزرائیں تاکہ غیر ضروری فضول کاٹ دیا جا سکے)، معیار کی کمی کے بغیر سکیل ہوتے ہیں، اور آپ کا ویب سرور انہیں gzip کر سکتا ہے۔"

msgid "Use separate files for multi-use assets"
msgstr "کئی جگہ استعمال ہونے والے عناصر کے لیے الگ فائلیں استعمال کریں"

msgid "Wherever possible, assets that are used repeatedly on your site should be loaded from an external file and not inlined. If you're using the same CSS on several pages, create a separate css file and load that in the <code>&lt;head&gt;</code> section of your pages. This will make styling updates to your site easier to manage, and will also allow the file to be cached in the visitor's browser, resulting in less bandwidth demands on your webserver and faster page loads for your visitors."
msgstr "جہاں ممکن ہو، آپ کی سائٹ پر بار بار استعمال ہونے والے عناصر کو باہری فائل سے لوڈ کرنا چاہیے، ان لائن نہ کریں۔ اگر آپ کئی صفحات پر ایک ہی CSS استعمال کر رہے ہیں تو ایک الگ css فائل بنائیں اور اسے اپنے صفحات کے <code>&lt;head&gt;</code> سیکشن میں لوڈ کریں۔ اس سے آپ کی سائٹ کے اسٹائلنگ اپ ڈیٹس منجانبی ہو جائیں گے، اور فائل وزیٹر کے براؤزر میں کیش بھی ہو سکے گی، جس کے نتیجے میں آپ کے ویب سرور پر بینڈ وائٹ کی ضرورت کم ہوگی اور آپ کے وزیٹرز کے لیے صفحات تیزی سے لوڈ ہوں گی۔"

msgid "Consider using a backend cache"
msgstr "بیک اینڈ کیش کے استعمال پر غور کریں"

msgid "If you're running a dynamic site handling a large number of concurrent users, content caching can often improve the time taken to deliver pages. For content that rapidly changes, a <a href=https://blog.stackpath.com/glossary-micro-caching/ target=_blank class='sitelink external'>micro-caching strategy</a> may still yield some benefits. The <a href=https://www.nginx.com/ target=_blank class='sitelink external'>Nginx webserver</a> provides a competent caching sub-system, or for a more heavy-weight solution, have a look at <a href=https://varnish-cache.org/ target=_blank class='sitelink external'>Varnish</a>."
msgstr "اگر آپ ایسی متحرک سائٹ چلا رہے ہیں جو بہت زیادہ ہمزمان صارفین کو سنبھال رہی ہے تو مواد کی کیش اکثر صفحات فراہم کرنے میں لگنے والا وقت بہتر کر سکتی ہے۔ تیزی سے بدلتے والے مواد کے لیے <a href=https://blog.stackpath.com/glossary-micro-caching/ target=_blank class='sitelink external'>مائیکرو کیشنگ حکمتِ عملی</a> اب بھی کچھ فائدہ دے سکتی ہے۔ <a href=https://www.nginx.com/ target=_blank class='sitelink external'>Nginx webserver</a> ایک مہتر کیشنگ سب سسٹم فراہم کرتا ہے، یا زیادہ بھاری حل کے لیے <a href=https://varnish-cache.org/ target=_blank class='sitelink external'>Varnish</a> دیکھیں۔"

msgid "Using an alternative webserver"
msgstr "متبادل ویب سرور کا استعمال"

msgid "To configure an alternative webserver for use on I2P, you can either use the existing webserver tunnel and <a href=/configclients>disable the default webserver</a> from running, or create a new HTTP Server tunnel in the <a href=/i2ptunnelmgr>Tunnel Manager</a>. Ensure that the webserver's <i>listening port</i> is also configured in the Tunnel Manager settings. For example, if your webserver is listening by default on address 127.0.0.1 port 80, you'd also need to ensure that the <i>Target port</i> in the Tunnel Manager settings page for the service is also configured to port 80."
msgstr "I2P پر استعمال کے لیے متبادل ویب سرور ترتیب دینے کے لیے آپ یا تو موجودہ ویب سرور ٹنل استعمال کر کے <a href=/configclients>طے شدہ ویب سرور</a> چلنے سے روک دیں، یا <a href=/i2ptunnelmgr>ٹنل مینیجر</a> میں نیا HTTP Server ٹنل بنا دیں۔ یقینی بنائیں کہ ویب سرور کا <i>سننے والا پورٹ</i> بھی ٹنل مینیجر کی ترتیبات میں مقرر ہے۔ مثلاً اگر آپ کا ویب سرور طے شدہ طور پر پتہ 127.0.0.1 پورٹ 80 پر سن رہا ہے تو آپ کو یہ بھی یقینی بنانا ہوگا کہ سروس کے لیے ٹنل مینیجر کی ترتیبات صفحے پر <i>Target port</i> بھی پورٹ 80 پر مقرر ہے۔"

msgid "To preserve anonymity, make sure that the webserver is not publicly available outside of the I2P network, which is normally achieved by configuring the webserver to listen on localhost (127.0.0.1) rather than all interfaces (0.0.0.0)."
msgstr "گمنیمیت محفوظ رکھنے کے لیے یقینی بنائیں کہ ویب سرور I2P نیٹ ورک کے باہر عوامی طور پر دستیاب نہ ہو، جو عام طور پر ویب سرور کو تمام انٹرفیس (0.0.0.0) کے بجائے localhost (127.0.0.1) پر سننے کے لیے ترتیب دے کر حاصل کیا جاتا ہے۔"

msgid "Be aware that a poorly configured webserver or web appplication can leak information such as your real IP address or server details that may reduce your anonymity or assist a hacker. If using an alternative platform, be sure to secure it before putting it online. If in doubt, consult online guides about web server and web application hardening, for example:"
msgstr "خبردار رہیں کہ غیر درست ترتیب شدہ ویب سرور یا ویب ایپلیکیشن آپ کا حقیقی IP پتہ یا سرور کی تفصیلات جیسی معلومات ظاہر کر سکتی ہے جو آپ کی گمنیمیت کم کرے یا کسی ہیکر کی مدد کرے۔ اگر کوئی متبادل پلیٹ فارم استعمال کر رہے ہیں تو اسے آن لائن کرنے سے پہلے محفوظ کرنا یقینی بنائیں۔ شک ہو تو ویب سرور اور ویب ایپلیکیشن کی سیکیورٹی سخت کرنے کے بارے میں آن لائن رہنمائیاں دیکھیں، مثلاً:"

msgid "Apache Web Server Security Guide"
