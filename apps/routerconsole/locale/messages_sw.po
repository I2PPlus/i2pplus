msgid "The su3 format is preferred, as it will be verified as signed by a trusted source."
msgstr "Muundo wa su3 kinapendekezwa, kwa kuwa kitathibitishwa kuwa umesainiwa na chanzo cha kuaminika."

msgid "The zip format is unsigned; use a zip file only from a source that you trust."
msgstr "Muundo wa zip haijasainiwa; tumia faili ya zip tu kutoka chanzo unachokiamini."

msgid "Enter zip or su3 URL"
msgstr "Weka URL ya zip au su3"

msgid "Please supply a valid reseed URL"
msgstr "Tafadhali toa URL halali ya reseed"

msgid "Select zip or su3 file"
msgstr "Chagua faili ya zip au su3"

msgid "Create Reseed File"
msgstr "Tengeneza Faili ya Reseed"

msgid "Create a new reseed zip file you may share for others to reseed manually."
msgstr "Tengeneza faili mpya ya reseed zip unaweza kushiriki ili wengine wafanyie reseed kwa mkono."

msgid "This file will never contain your own router's identity or IP."
msgstr "Faili hii haikutakiri kamwe utambulisho wa routeri yako au IP yako."

msgid "Create reseed file"
msgstr "Tengeneza faili ya reseed"

msgid "config service"
msgstr "sanidi huduma"

